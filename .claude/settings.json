{
  "model": "opusplan",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin dev:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:dev:*)",
      "Bash(git push origin dev:main:*)",
      "Bash(git push origin --delete main:*)",
      "Bash(git push origin --delete dev:*)",
      "Bash(git push origin -d main:*)",
      "Bash(git push origin -d dev:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push -u origin dev:*)",
      "Bash(git push -u origin HEAD:main:*)",
      "Bash(git push -u origin HEAD:dev:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin dev:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push -f origin dev:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/codebase-memory/refresh-index.sh",
            "async": true,
            "timeout": 300
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  }
}