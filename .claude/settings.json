{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin dev:main:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)"
    ]
  }
}
