# Claude Code local worktrees — never commit (each is a full working copy).
.claude/worktrees/

# macOS
.DS_Store

# Dependencies / build artifacts
node_modules/
*.tsbuildinfo

# Python (po-extract をローカルで読み込んだときの副産物)
__pycache__/
*.py[cod]

# codebase-memory MCP（--persistence の共有アーティファクト。既定では作らない）
.codebase-memory/

# スタックの .env は**サーバーにしか置かない**（secrets が入る）。
# deploy-stack.sh も rsync から常に除外している。ここで git 側にも蓋をする
# — 手元で動かすために作った .env を、うっかりコミットしないため。
# 雛形は各スタックの .env.example（こちらはコミットする）。
.env
!.env.example

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/metrics/
.claude-flow/security/
.claude-flow/policy/
.claude-flow/harness-active-policy.json
.swarm/
ruvector.db
ruvector.db-*
.claude/proven-config.json
.claude/.proven-config-version
