# nextjs-kiosk — 環境変数（Coolify で管理。ローカルは .env にコピー）

# shared-db（role: app）
DATABASE_URL=postgresql://app:PASSWORD@shared-db:5432/ckk

# nextjs-web 管理 UI のモニター WS 認証用（両アプリで同値にする）
KIOSK_WS_SECRET=change-me

# 端末アテステーション（android-kiosk ラッパー必須化）。
# "required" でログイン関連 API + WS がアテスト Cookie 必須になる。
# 未設定 = 任意（ブラウザでも利用可）。HMAC は KIOSK_ATTEST_SECRET
# （未設定なら KIOSK_WS_SECRET を流用）。
# KIOSK_ATTESTATION=required

# 表示バージョン
NEXT_PUBLIC_APP_VERSION=0.1.0
