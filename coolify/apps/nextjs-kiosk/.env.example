# nextjs-kiosk — 環境変数（Coolify で管理。ローカルは .env にコピー）

# shared-db（role: app）
DATABASE_URL=postgresql://app:PASSWORD@shared-db:5432/ckk

# nextjs-web 管理 UI のモニター WS 認証用（両アプリで同値にする）
KIOSK_WS_SECRET=change-me

# 端末アテステーション（android-kiosk ラッパー必須化）。
# "required" でログイン関連 API + WS がアテスト Cookie 必須になる。
# 未設定 = 任意（ブラウザでも利用可）。HMAC は KIOSK_ATTEST_SECRET
# （未設定なら KIOSK_WS_SECRET を流用）。
# KIOSK_ATTESTATION=required

# 表示バージョン
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── 認証イベント記録（app.login_attempts）──────────────────────────────
# 相関キー（card_ref / identifier_ref）の pepper。**nextjs-web と同値**に
# しないとアプリ間で相関しない。未設定でも動くが、相関キーが付かない。
LOGIN_ATTEMPT_PEPPER=change-me

# 社内ネットワークの CIDR（カンマ区切り）。所有区分の自動判定に使う
# —「社内 NW にいる」の証拠であって社給端末の証拠ではない点に注意。
# 未設定なら判定は UNKNOWN（私用扱いにはしない）。
# CORPORATE_CIDRS=192.168.50.0/24,10.0.0.0/8

# 自分の前に居る「x-forwarded-for に追記するプロキシ」の数。
# 未設定 = 0（右端 = 最も近いプロキシが観測した値）。まず 0 で運用し、
# 記録された生チェーン（login_attempts.ip_chain）を見てから合わせる。
# **左端は絶対に採らない** — クライアントが自由に書けるため。
# TRUSTED_PROXY_HOPS=1
