// 在庫 (_specs/tables.md §4・§5・§7): 製品在庫 / 素材在庫 / 引当予約 / 在庫取引。
//
// 方針:
// - 実在庫は全工程完了時にのみ動く（製造中は予約のみ — §7）。
// - product_inventory はロット（=指示書番号）単位。半製品は is_semi_finished
//   フラグ + source_step_id（発生工程のトレーサビリティ）で同一台帳に持つ。
// - inventory_transactions が唯一の増減記録（applyTransaction 経由でのみ
//   キャッシュ数量を更新する — lib/inventory.ts）。

enum InventoryType {
  PRODUCT
  MATERIAL

  @@map("INVENTORY_TYPE")
  @@schema("app")
}

enum ReservationStatus {
  RESERVED // 予約中（製造中）
  CONFIRMED // 確定（全工程完了時）
  RELEASED // 解除（出荷・キャンセル）

  @@map("RESERVATION_STATUS")
  @@schema("app")
}

enum TransactionType {
  IN // 入庫
  OUT // 出庫
  RESERVE // 予約
  RELEASE // 予約解除
  ADJUST // 棚卸調整

  @@map("TRANSACTION_TYPE")
  @@schema("app")
}

// ─── 保管場所マスタ ──────────────────────────────────────────────────────────

// 保管場所（拠点内の倉庫・置場。MS0B 拠点詳細の「保管場所」タブで管理）。
// 在庫行は 保管場所 × 棚 の粒度で分かれ、在庫移動（stock_transfer 取引ペア）で
// 場所間・拠点間を動く。未割当在庫は storage_location_id = null のバケット。
model StorageLocation {
  id        Int      @id @default(autoincrement())
  plantId Int      @map("plant_id")
  code      String   @unique
  name      Json // { ja, en }
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  notes     String?
  // フロアマップ上のピン（%座標。null = 未配置）— kiosk_floor_maps は
  // 端末管理と共用の拠点フロアマップ（端末ピンと同じ図面に保管場所を配置）
  floorMapId String?  @map("floor_map_id") @db.Uuid
  mapX       Decimal? @map("map_x") @db.Decimal(5, 2)
  mapY       Decimal? @map("map_y") @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plant  Plant        @relation("StorageLocationPlant", fields: [plantId], references: [id])
  floorMap KioskFloorMap? @relation("StorageLocationFloorMap", fields: [floorMapId], references: [id])
  shelves  StorageShelf[]

  productInventory  ProductInventory[]
  materialInventory MaterialInventory[]
  workOrders        WorkOrder[]         @relation("WorkOrderStorageLocation")
  stockTakes        StockTake[]         @relation("StockTakeStorageLocation")
  itemInventory     ItemInventory[]     @relation("ItemInventoryLocation")

  @@index([plantId])
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, id])
  @@map("storage_locations")
  @@schema("app")
}

// 棚（保管場所内の区画。ロケーションビューの 1 マス）。
model StorageShelf {
  id         Int     @id @default(autoincrement())
  locationId Int     @map("location_id")
  code       String
  name       Json? // { ja, en }（任意 — 無ければ code 表示）
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")

  location StorageLocation @relation(fields: [locationId], references: [id])

  productInventory  ProductInventory[]
  materialInventory MaterialInventory[]
  itemInventory     ItemInventory[]     @relation("ItemInventoryShelf")

  @@unique([locationId, code])
  @@map("storage_shelves")
  @@schema("app")
}

// ─── 統合在庫 ───────────────────────────────────────────────────────────────
//
// product_inventory と material_inventory を 1 本にまとめたもの（統合の第 2 段 A）。
// 1 行 = 1 バケット（品目 × 拠点 × 保管場所 × 棚 × ロット × 半製品フラグ）。
//
// **主キーは旧 2 表の uuid をそのまま持ち込む。** uuid は衝突しないので、
// inventory_transactions / inventory_reservations / stock_take_lines の
// inventory_id は**1 行も書き換えずに有効なまま**になる（masters 側は serial で
// 衝突したので新しく採り直した — items.prisma の id 節と対照的）。
//
// おまけに、その 3 つは多態ゆえ今まで FK が張れなかった。参照先が 1 表に定まる
// ので、A-3 で本物の FK を張る（整合性の純増）。
//
// ⚠️ **A-2 が終わるまでは鏡**。書き込みの持ち主は旧 2 表のほうで、ここへ直接
// 書いてもトリガーに上書きされて黙って消える（lib/items-readonly-guard と同じ）。
model ItemInventory {
  id     String @id @db.Uuid
  itemId Int    @map("item_id")

  plantId           Int?    @map("plant_id")
  storageLocationId Int?    @map("storage_location_id")
  shelfId           Int?    @map("shelf_id")

  /// ロット = 指示書番号。素材は null（ロットで持たない）。
  lotNumber      Int?    @map("lot_number")
  /// 半製品バケットか。素材は常に false。
  isSemiFinished Boolean @default(false) @map("is_semi_finished")
  /// 半製品の発生工程（トレーサビリティ）。
  sourceStepId   String? @map("source_step_id") @db.Uuid

  /// **Decimal に寄せた。** 製品は Int、素材は Decimal(12,3) だったが、
  /// int は Decimal に損なく入る（逆は入らない）。読み出し側は Number() が要る。
  quantity         Decimal @default(0) @db.Decimal(12, 3)
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(12, 3)

  /// 単位は**行に持つ**。素材の台帳が元からそうで、「本」の台帳に「kg」を
  /// 足すのを拒む守り（ensureMaterialInventory の unitMismatch）がこれに依る。
  unit     String
  location String? // 旧フリーテキスト保管場所（表示フォールバックのみ）
  notes    String?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item            Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  plant           Plant?           @relation("ItemInventoryPlant", fields: [plantId], references: [id])
  storageLocation StorageLocation? @relation("ItemInventoryLocation", fields: [storageLocationId], references: [id])
  shelf           StorageShelf?    @relation("ItemInventoryShelf", fields: [shelfId], references: [id])

  // 一意バケット（NULLS NOT DISTINCT index — migration で張る）
  @@unique([itemId, plantId, lotNumber, isSemiFinished, storageLocationId, shelfId], map: "item_inventory_bucket_key")
  @@index([itemId])
  @@index([plantId, storageLocationId])
  @@index([updatedAt, id])
  @@map("item_inventory")
  @@schema("app")
}

model ProductInventory {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      Int     @map("product_id")
  plantId      Int?    @map("plant_id")
  lotNumber      Int?    @map("lot_number") // ロット = 指示書番号
  quantity       Int     @default(0)
  reservedQuantity Int   @default(0) @map("reserved_quantity")
  isSemiFinished Boolean @default(false) @map("is_semi_finished") // 半製品
  sourceStepId   String? @map("source_step_id") @db.Uuid // 半製品の発生工程
  storageLocationId Int? @map("storage_location_id") // 保管場所（null = 未割当）
  shelfId        Int?    @map("shelf_id") // 棚（null = 場所内未割当）
  location       String? // 旧フリーテキスト保管場所（表示フォールバックのみ）
  notes          String?
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product         Product          @relation(fields: [productId], references: [id])
  plant         Plant?         @relation(fields: [plantId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  shelf           StorageShelf?    @relation(fields: [shelfId], references: [id])

  // 一意バケット（NULLS NOT DISTINCT index — migration で置換済み）
  @@unique([productId, plantId, lotNumber, isSemiFinished, storageLocationId, shelfId], map: "product_inventory_bucket_key")
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, id])
  @@map("product_inventory")
  @@schema("app")
}

model MaterialInventory {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId       Int     @map("material_id")
  plantId        Int?    @map("plant_id")
  quantity         Decimal @default(0) @db.Decimal(12, 3)
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(12, 3)
  unit             String
  storageLocationId Int?   @map("storage_location_id") // 保管場所（null = 未割当）
  shelfId          Int?    @map("shelf_id") // 棚（null = 場所内未割当）
  location         String? // 旧フリーテキスト保管場所（表示フォールバックのみ）
  notes            String?
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  material        Material         @relation(fields: [materialId], references: [id])
  plant         Plant?         @relation(fields: [plantId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  shelf           StorageShelf?    @relation(fields: [shelfId], references: [id])

  // 一意バケット（NULLS NOT DISTINCT index — migration で置換済み）
  @@unique([materialId, plantId, storageLocationId, shelfId], map: "material_inventory_bucket_key")
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, id])
  @@map("material_inventory")
  @@schema("app")
}

// 在庫引当・予約（全工程完了まで予約状態を維持 — §4/§7）
model InventoryReservation {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryType InventoryType     @map("inventory_type")
  inventoryId   String            @map("inventory_id") @db.Uuid
  orderLineId   String?           @map("order_line_id") @db.Uuid
  workOrderId   String?           @map("work_order_id") @db.Uuid
  quantity      Decimal           @db.Decimal(12, 3)
  status        ReservationStatus @default(RESERVED)
  reservedAt    DateTime?         @map("reserved_at") @db.Timestamptz(6)
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  releasedAt    DateTime?         @map("released_at") @db.Timestamptz(6)

  /// 差分同期（/api/v1 の ?updatedSince=）の順序キー。DB 側のトリガーが維持する。
  /// 状態は RESERVED → CONFIRMED → RELEASED と動くのに、per-status の時刻列は
  /// どれも nullable で「最後に動いた時刻」を表せなかったため足した。
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderLine  OrderLine?  @relation(fields: [orderLineId], references: [id])
  workOrder  WorkOrder?  @relation(fields: [workOrderId], references: [id])

  @@index([inventoryType, inventoryId, status])
  @@index([orderLineId])
  @@index([updatedAt, id])
  @@map("inventory_reservations")
  @@schema("app")
}

// ─── 移動タイプ ─────────────────────────────────────────────────────────────
//
// 手動で在庫を動かすときに選ぶ、**番号つきの型**（SAP の移動タイプ相当）。
// 利用者が設定画面から増やせる。
//
// **cause（enum）を置き換えるものではない。** cause は「どの処理が起こしたか」
// というシステム側の分類で、移動タイプは業務側の分類。兼ねさせると、自動生成の
// 伝票（指示書完了・出荷・入荷）に人が決めた番号を無理に割り当てることになる。
// 自動生成は cause だけを持ち、手動入出庫は両方を持つ。
enum MovementDirection {
  /// 入庫（to だけ）
  IN
  /// 出庫（from だけ）
  OUT
  /// 移動（from と to の両方）
  TRANSFER

  @@map("MOVEMENT_DIRECTION")
  @@schema("app")
}

model MovementType {
  id        Int               @id @default(autoincrement())
  /// 番号。人が決める（101 / 201 / 311 …）。表示と検索の鍵。
  code      String            @unique
  name      Json
  direction MovementDirection

  /// 出庫元・入庫先の保管場所を要求するか。**向きから機械的に決めない** —
  /// 「入庫だが元の場所も記録したい」のような型を作れるようにするため、
  /// 既定を向きから入れたうえで、利用者が変えられる。
  requiresFrom Boolean @default(false) @map("requires_from")
  requiresTo   Boolean @default(false) @map("requires_to")

  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  movements InventoryMovement[]

  @@index([isActive, sortOrder])
  @@map("movement_types")
  @@schema("app")
}

// ─── 入出庫伝票 ──────────────────────────────────────────────────────────────
//
// 在庫が動いた「出来事」1 回 = 1 枚。明細（= inventory_transactions）をぶら下げる。
//
// なぜ要るか: 取引行は (reference_type, reference_id) しか手掛かりを持たず、
// しかもその reference_id の形が経路ごとに違った（指示書は uuid、出荷書は
// 表示番号 "DOR-…"、在庫移動に至ってはその場で作った randomUUID を行に書くだけで
// どこにも保存していない）。「MOV-202610-00042 を見せて」と言えず、1 回の移動が
// 1 行として読めない。
//
// 不変（ライフサイクルを持たない）。訂正は逆仕訳の伝票を新しく起こす。
// **必ず在庫の増減と同じトランザクションで作る** — 番号だけは他の書類と同じく
// トランザクションの外で採番する（lib/numbering.ts allocateDocumentKey。
// ロールバックで番号が飛ぶのは全書類共通の仕様）。
enum InventoryMovementCause {
  WORK_ORDER_COMPLETION // 指示書完了（完成品・半製品の入庫 + 材料消費）
  DELIVERY_SHIPMENT // 出荷（出庫 / 在庫保管入庫 + 予約解除）
  MATERIAL_RECEIPT // 素材入荷
  STOCK_TRANSFER // 在庫移動（拠点・保管場所・棚）
  STOCK_RESERVATION // 引当予約
  RESERVATION_RELEASE // 予約解除（単独）
  ADJUSTMENT // 棚卸調整
  /// 移行前の取引行に後から付けた伝票。**新規では使わない** —
  /// 何の出来事だったかを記録していなかった行が実在するので、それを
  /// 正直に表す値として残す。
  OTHER

  @@map("INVENTORY_MOVEMENT_CAUSE")
  @@schema("app")
}

model InventoryMovement {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 伝票番号 MOV-YYYYMM-NNNNN は (year_month, seq) から導出する（lib/doc-number.ts）。
  // 指示書と同型 — uuid を主キーに、番号は一意制約で持つ。
  yearMonth String @map("year_month") @db.Char(6)
  seq       Int

  cause InventoryMovementCause
  /// 手動入出庫で選んだ移動タイプ。自動生成の伝票では null（cause だけを持つ）。
  movementTypeId Int? @map("movement_type_id")
  /// 元になった書類（テーブル名。audit_logs / approval_requests と同じ多態規約）。
  /// FK は張らない — 書類を消しても伝票は残さなければならない。
  sourceType String? @map("source_type")
  /// 元書類の業務キー（指示書番号・DOR-… など、その書類の詳細 URL に使う id）。
  sourceId   String? @map("source_id")
  /// 主たる拠点。拠点をまたぐ移動では null（どちらか片方を選べないため）。
  plantId    Int?    @map("plant_id")
  notes      String? // encodeInventoryNote 済み
  createdBy  String? @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plant        Plant?        @relation("InventoryMovementPlant", fields: [plantId], references: [id], onDelete: Restrict)
  movementType MovementType? @relation(fields: [movementTypeId], references: [id], onDelete: Restrict)

  lines InventoryTransaction[]

  @@unique([yearMonth, seq])
  @@index([createdAt, id])
  @@index([sourceType, sourceId])
  @@index([cause, createdAt])
  @@index([movementTypeId])
  @@map("inventory_movements")
  @@schema("app")
}

// 在庫取引（増減の唯一の記録。lib/inventory.ts applyTransaction 経由）。
// 入出庫伝票（inventory_movements）の明細行でもある。
model InventoryTransaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 所属する入出庫伝票。**すべての行が伝票に属する**（移行完了後に NOT NULL）。
  /// 移行期間中だけ null — 新しいアプリと古いアプリが同時に動く数分のあいだ、
  /// 古い方は この列を知らないまま INSERT するため（rollout は plan 参照）。
  movementId      String?         @map("movement_id") @db.Uuid
  inventoryType   InventoryType   @map("inventory_type")
  inventoryId     String          @map("inventory_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  quantity        Decimal         @db.Decimal(12, 3)
  referenceType   String?         @map("reference_type") // work_order / delivery_order / material_receipt …
  referenceId     String?         @map("reference_id")
  notes           String?
  createdBy       String?         @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  movement InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([inventoryType, inventoryId, createdAt])
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([createdAt, id])
  @@index([movementId])
  @@map("inventory_transactions")
  @@schema("app")
}

// ─── 棚卸 ────────────────────────────────────────────────────────────────────
//
// 実地棚卸。**バケット単位**（拠点 × 保管場所 × 棚 × ロット）で数える — 棚を歩く
// のと同じ粒度でないと、差異がどの棚のものか言えないし、拠点の合計差異を
// バケットへ割り振るのはシステムの当て推量になる。
//
// ライフサイクルを持つのは棚卸のほうで、そこから出る入出庫伝票は不変。
// 確定は承認を通す（承認設定 MS0B に段が 1 つも無ければ素通し — 工程フロー変更と
// 同じ規約）。最終承認が調整を**適用する**。
enum StockTakeStatus {
  DRAFT // 下書き（対象バケットを取り込んだだけ）
  COUNTING // 記入中
  CONFIRMED // 確定（入出庫伝票を発行済み。以後編集不可）
  CANCELLED

  @@map("STOCK_TAKE_STATUS")
  @@schema("app")
}

enum StockTakeApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED

  @@map("STOCK_TAKE_APPROVAL_STATUS")
  @@schema("app")
}

model StockTake {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 棚卸番号 STK-YYYYMM-NNNNN は (year_month, seq) から導出する。
  yearMonth String @map("year_month") @db.Char(6)
  seq       Int

  plantId Int @map("plant_id")
  /// 範囲を保管場所（さらに棚）まで絞った棚卸。null = 拠点まるごと。
  storageLocationId Int? @map("storage_location_id")

  status         StockTakeStatus         @default(DRAFT)
  approvalStatus StockTakeApprovalStatus @default(NONE) @map("approval_status")

  countedAt   DateTime? @map("counted_at") @db.Timestamptz(6)
  requestedAt DateTime? @map("requested_at") @db.Timestamptz(6)
  requestedBy String?   @map("requested_by") @db.Uuid
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy  String?   @map("rejected_by") @db.Uuid
  rejectReason String?  @map("reject_reason")
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy String?   @map("cancelled_by") @db.Uuid

  /// 確定時に発行した入出庫伝票（cause = ADJUSTMENT）。差異が 1 件も無ければ null
  /// （数えた結果ぴったりだった、という確定は正常で、伝票は起こさない）。
  movementId String? @map("movement_id") @db.Uuid

  notes     String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plant           Plant            @relation("StockTakePlant", fields: [plantId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation? @relation("StockTakeStorageLocation", fields: [storageLocationId], references: [id], onDelete: Restrict)

  lines StockTakeLine[]

  @@unique([yearMonth, seq])
  @@index([status])
  @@index([plantId])
  @@index([updatedAt, id])
  @@map("stock_takes")
  @@schema("app")
}

// 1 行 = 1 在庫バケット。inventoryId は product_inventory / material_inventory の
// どちらかを指す多態参照（inventory_reservations と同じ規約 — FK は張らない）。
model StockTakeLine {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockTakeId String        @map("stock_take_id") @db.Uuid
  inventoryType InventoryType @map("inventory_type")
  inventoryId String        @map("inventory_id") @db.Uuid

  /// 取り込んだ時点の帳簿数。**差異の計算には使わない** — 確定時にその場で
  /// 読み直した実数と数えた数を突き合わせる（数えてから確定するまでに在庫は動く）。
  /// 画面に「取り込み時点はこうだった」を出すためだけに持つ。
  bookQuantity    Decimal  @map("book_quantity") @db.Decimal(12, 3)
  /// 数えた数。null = 未カウント（差異ゼロ扱いではなく、確定時に飛ばす）。
  countedQuantity Decimal? @map("counted_quantity") @db.Decimal(12, 3)
  notes           String?
  sortOrder       Int      @default(0) @map("sort_order")

  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)

  @@unique([stockTakeId, inventoryType, inventoryId])
  @@index([stockTakeId])
  @@map("stock_take_lines")
  @@schema("app")
}
