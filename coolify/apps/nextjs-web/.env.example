# Build-time app version shown in the footer.
NEXT_PUBLIC_APP_VERSION=0.1.0

# Public access (Cloudflare Tunnel) now lives in the separate `cloudflared` stack.

# ─── Auth.js v5 (認証) ───────────────────────────────────────────────────────
# 本番/dev の値は Coolify の環境変数で管理する（このファイルはコミット用の雛形で、
# 実際の秘密値は入れない）。ローカル検証時のみ .env に実値を置く。

# セッション JWT の署名鍵（必須）。`openssl rand -base64 32` などで生成し、
# 再起動をまたいで固定する（変わると全セッションが無効化）。
AUTH_SECRET=

# Authentik SSO（OIDC）。3つが揃うとログイン画面の「SSO でログイン」が有効化される
# （src/auth.ts の authentikEnabled）。未設定ならデモ用 credentials のみ。
# ISSUER は Authentik の discovery が返す "issuer" と **完全一致** させる。Authentik は
# 末尾スラッシュ付きで返すため、スラッシュを含める（欠けると oauth4webapi が
# 「"issuer" property does not match」で失敗する）:
#   例) http://auth.ckk-tools.loc:9000/application/o/ckk-business-management/
# コールバック URL は Authentik 側に /api/auth/callback/authentik を登録する。
# 注意: この issuer は Next.js コンテナ（サーバー側の discovery/token 取得）と
# ユーザーのブラウザ（authorize への上位遷移）の双方から到達可能である必要がある。
AUTH_AUTHENTIK_ISSUER=
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=

# アプリの公開 URL（**必須**）。socat/cloudflared 経由だとアプリに届く Host が
# 0.0.0.0:3000 になり、trustHost だけでは redirect_uri が https://0.0.0.0:3000/... に
# なってしまう。正しいコールバックにするため公開 URL を明示する:
#   dev)  https://app-dev.ckk-tool.co.jp
#   main) https://app.ckk-tool.co.jp
AUTH_URL=

# ─── キオスク管理（SY08 QRカード管理 / SY09 端末管理） ──────────────────────
# 端末プレゼンス WS（nextjs-kiosk /api/kiosk/ws）のモニタートークン用共有
# シークレット。nextjs-kiosk 側の KIOSK_WS_SECRET と**同じ値**を設定する
# （`openssl rand -base64 32` などで生成）。未設定なら SY09 のオンライン列は
# 静的フォールバック（最終アクティビティ 5 分以内）で表示される。
KIOSK_WS_SECRET=

# キオスク側 WS の公開 URL（ブラウザから接続するためクライアント公開値）。
# 例) wss://ckk-kiosk.kai-lab.net/api/kiosk/ws
NEXT_PUBLIC_KIOSK_WS_URL=

# ─── 認証イベントの記録（app.login_attempts）───────────────────────────────
# 相関キー（identifier_ref / card_ref）の pepper。**nextjs-kiosk と同値**に
# しないとアプリ間で相関しない。未設定でも動くが、相関キーが付かない。
LOGIN_ATTEMPT_PEPPER=

# 端末シグネチャ Cookie（ckk_dev）の署名鍵。未設定なら AUTH_SECRET を流用。
# DEVICE_SIGNALS_SECRET=

# 社内ネットワークの CIDR（カンマ区切り）。所有区分の自動判定に使う
# —「社内 NW にいる」の証拠であって社給端末の証拠ではない点に注意。
# 未設定なら判定は UNKNOWN（私用扱いにはしない）。
# CORPORATE_CIDRS=192.168.50.0/24,10.0.0.0/8

# 自分の前に居る「x-forwarded-for に追記するプロキシ」の数。
# 未設定 = 0（右端 = 最も近いプロキシが観測した値）。まず 0 で運用し、
# 記録された生チェーン（login_attempts.ip_chain）を見てから合わせる。
# **左端は絶対に採らない** — クライアントが自由に書けるため。
# TRUSTED_PROXY_HOPS=1
