{
  "name": "nextjs-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:scan": "node ../../../tools/i18n/i18n-scan.mjs",
    "i18n:baseline": "node ../../../tools/i18n/i18n-scan.mjs --update-baseline",
    "db:sync-schema": "rm -rf prisma/schema && cp -R ../../../shared-db/prisma/schema prisma/schema",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@ckk/authz-core": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/core": "^9.3.1",
    "@mantine/dates": "^9.3.1",
    "@mantine/form": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@mantine/modals": "^9.3.1",
    "@mantine/notifications": "^9.3.1",
    "@mantine/tiptap": "9.5.1",
    "@orama/tokenizers": "3.1.18",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@xyflow/react": "12.11.3",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "diff": "9.0.0",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "16.14.4",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "4.13.7",
    "nodemailer": "^9.0.3",
    "online-3d-viewer": "0.18.0",
    "pg": "8.23.0",
    "qr-scanner": "1.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "prisma": "7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.9"
  }
}
