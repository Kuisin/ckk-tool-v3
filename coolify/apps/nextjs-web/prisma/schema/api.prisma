// ===========================
// 外部 API（/api/v1）— 機械向けの読み取り口
// ===========================
//
// 社外のシステムが業務データを機械的に読むための資格情報。設計の全体は
// `_specs/api.md`。ここには**あとから効いてくる判断**だけを書く。
//
// ■ 主体は app.users の行（group = SYSTEM）
//
// api_clients の 1 行が users の 1 行と 1:1 で対応する。主体がユーザーそのもの
// なので、user_permissions → decide() → Access（拠点スコープ）→ audit_logs.user_id
// が**全部そのまま効く**。認可の仕組みを 2 つ目に増やさずに済むのが、この形を
// 選んだ唯一の理由。
//
// 取引先ポータル（portal_accounts）とは**逆の判断**である点に注意。あちらの主体は
// 社外の人で app.users では表現できない（社員ではない）から別立てにした。
// こちらは機械だが「社内の権限体系の中の 1 主体」として素直に表現できる。
//
// ■ その代金 — 3 つ、いずれも黙って効く
//
//   1. **共有（share_grants）の EVERYONE 行が当たる。** 主体が本物のユーザー
//      なので lib/share-grants.ts はそのまま一致させる。form / internal_page の
//      READ を与えると「全員に共有された文書」が見える。仕様であって不具合では
//      ないが、要らないならその 2 コードを与えないこと。
//   2. **社員ピッカーに混ざる。** users を group で絞らずに引いている箇所
//      （共有先の選択・全員通知・フォルダ権限・フォーム共有）は、この行を
//      「人」として並べてしまう。該当箇所には group: "EMPLOYEE" を入れてある —
//      新しくユーザーを引く画面を書くときは同じことを考えること。
//   3. **監査の actor になる。** audit.ts の recordAudit は actorId を受け取る
//      ので、API 由来の書き込み（Phase 4）はこのユーザーとして残る。
//
// ■ Auth.js には相乗りしない
//
// lib/portal-auth.ts の冒頭が書いている通り、sessionUserId() が非 null を返すと
// auth.config.ts の authorized / requireAppRead / shareAccessFor /
// getCurrentActorId が全部「社員がログインしている」と解釈する。API は Cookie を
// 一切設定せず auth() を一度も呼ばないので、この 4 つは**1 行も触らずに
// fail-closed になる**。
//
// ■ 秘密の守り方は 3 点セット（login_attempts / portal と同じ）
//   画面を権限で閉じる（SY0I・api_client コード）/ metabase_ro から剥がす
//   （sql/grants.sql）/ 期間を切る（sql/api-cron.sql）。1 つでも外すなら設計から。

/// 外部システム 1 つ = 1 行。権限は backing user（group = SYSTEM）のロールが決める。
model ApiClient {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 運用上の識別名（一意）。「どの外部システムか」を人が読むための名前。
  name        String  @unique @db.VarChar(120)
  description String?

  /// 権限の主体。1 クライアント = 1 ユーザー（@unique）— 2 つのクライアントが
  /// 同じロールを黙って共有する状態を作らせない。
  userId String @unique @map("user_id") @db.Uuid

  /// **既定 false。** 作っただけでは何も通らない（portal_accounts と同じ姿勢）。
  /// 有効化は特権操作 api_client.activate を通る。
  isActive Boolean @default(false) @map("is_active")

  /// クライアント自体の期限。null = 無期限。トークン個別の期限とは別で、
  /// 短い方が勝つ（判定は lib/api-auth-core.ts の 1 か所）。
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  /// 送信元 IP の制限。**空配列 = 制限なし**（空を「全部拒否」にすると
  /// 最初の 1 件目で必ず締め出される）。判定は lib/cidr-core.ts ipInAnyCidr。
  /// IP が判らないとき（XFF 不備）は、リストが空でなければ拒否＝fail-closed。
  allowedCidrs String[] @default([]) @map("allowed_cidrs")

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  lastUsedIp String?   @map("last_used_ip") @db.Inet

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy     String?   @map("revoked_by") @db.Uuid
  revokedReason String?   @map("revoked_reason")

  user          User  @relation("ApiClientUser", fields: [userId], references: [id])
  createdByUser User? @relation("ApiClientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  revokedByUser User? @relation("ApiClientRevokedBy", fields: [revokedBy], references: [id], onDelete: SetNull)

  tokens     ApiClientToken[]
  accessLogs ApiAccessLog[]
  webhooks   WebhookEndpoint[]

  @@index([isActive])
  @@map("api_clients")
  @@schema("app")
}

/// トークンは**子表**。1 クライアントに有効 2 本まで（差し替えを無停止でやるため）。
///
/// 2 列（token_hash_a / _b）にしなかった理由:
///   - 引き当てが `findUnique({ tokenHash })` の 1 索引で済む。OR 2 列だと
///     どちらに当たったかで TS 側が分岐し、そこが認証の最も熱い経路になる。
///   - 期限・失効・発行者・last4 が**トークンごと**に要る。2 列だと 7 列 ×2。
///   - 「9/3 に使われたのはどのトークンか」に答えられる（失効しても行が残る）。
///   - 「有効は N 本まで」は方針であって schema の事実ではない。部分 unique では
///     表現できないので、どのみち発行アクションが守る（唯一の発行口なので十分）。
///
/// 生値は発行時の応答に 1 度だけ現れ、DB にもログにも監査行にも残らない。
model ApiClientToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  /// sha256(生値) の 16 進。索引はこれ 1 本。
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// 画面に `●●●●●●ab3x` を出すための下 4 桁（平文）。復元はできない。
  last4     String    @map("last4") @db.Char(4)
  /// 「2026-09 差し替え」など、人が見分けるための覚え書き。
  label     String?   @db.VarChar(60)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  useCount   Int       @default(0) @map("use_count")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid

  client        ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("ApiTokenCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  revokedByUser User?     @relation("ApiTokenRevokedBy", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([clientId, revokedAt])
  @@index([expiresAt])
  @@map("api_client_tokens")
  @@schema("app")
}

/// 全リクエストの記録（成功も失敗も）。
///
/// audit_logs には入れられない。あちらは user_id を app.users に FK した
/// 「actor 前提の台帳」で、**認証に失敗した要求には actor が居ない**。
/// login_attempts を別表にしたのとまったく同じ理由。
///
/// そして機械向けの口で知りたいのは「どの呼び出しが、なぜ弾かれたか」なので、
/// 変更だけでなく**全部**を残す。deny_reason は**ここにしか無い** — 応答は
/// どの理由でも同一の 401 で、外からは区別できない（_specs/api.md §2.3）。
model ApiAccessLog {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 認証に失敗した要求では null（どのクライアントか判らないため）。
  clientId String? @map("client_id") @db.Uuid
  tokenId  String? @map("token_id") @db.Uuid

  method String @db.VarChar(8)
  /// pathname のみ。**クエリ文字列は入れない** — 誤用でトークンが載りうる。
  path   String @db.VarChar(256)
  status Int

  /// 拒否理由（lib/api-auth-core.ts の ApiAuthDenyReason）。サーバー側にだけ残す。
  denyReason String? @map("deny_reason") @db.VarChar(32)
  /// 403 の調査用。要求した権限コード×アクション。
  permissionCode String? @map("permission_code") @db.VarChar(64)

  durationMs Int?    @map("duration_ms")
  ipAddress  String? @map("ip_address") @db.Inet
  /// x-forwarded-for の生チェーン。TRUSTED_PROXY_HOPS の段数をあとから検算する
  /// ため（login_attempts.ip_chain と同じ目的）。
  forwardedFor String? @map("forwarded_for") @db.VarChar(200)
  userAgent    String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client ApiClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([denyReason, createdAt(sort: Desc)])
  @@map("api_access_logs")
  @@schema("app")
}

/// 冪等キー（書き込みの再送を 1 回にする）。
///
/// ■ なぜ「あったほうがよい」ではなく**必須**なのか
/// 採番は `lib/numbering.ts` の `allocateDocumentKey()` で、**月次リセットの
/// 連番**。webhook の再送やタイムアウト後のリトライで同じ注文が 2 回通ると
/// `ORD-` が 2 本立ち、後から見分ける手段が無い（番号は再利用もされる）。
/// 在庫や請求まで二重に動くので、取り返しがつかない。
///
/// ■ 保存するのは「鍵 + 要求の指紋 + 返した応答」
/// 同じ鍵で**違う本文**が来たら 422 で拒む（鍵の使い回しは呼び出し側の
/// 不具合で、黙って古い応答を返すとその不具合が見えなくなる）。
/// 同じ鍵で同じ本文なら、保存した応答をそのまま返す。
///
/// 期限は 24 時間（`api-cron.sql` が刈る）。それを過ぎた再送は新しい書き込みに
/// なるが、常識的な再送はすべて窓の中に収まる。
model ApiIdempotencyKey {
  /// 呼び出し側が付けた鍵。クライアントごとに一意（他社の鍵とぶつからない）。
  key      String @db.VarChar(255)
  clientId String @map("client_id") @db.Uuid

  /// メソッド + パス + 本文の sha256。同じ鍵で違う要求を弾くため。
  requestHash String @map("request_hash") @db.Char(64)

  /// 返した応答（本文と状態）。再送にはこれをそのまま返す。
  responseStatus Int    @map("response_status")
  responseBody   String @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([clientId, key])
  @@index([createdAt])
  @@map("api_idempotency_keys")
  @@schema("app")
}

// ===========================
// 外向き Webhook（このシステム → n8n などの外部）
// ===========================
//
// 設計の全体は `_specs/api.md` §9。ここには**あとから効いてくる判断**だけを書く。
//
// ■ 出どころは audit_logs（業務コードには 1 行も足さない）
// 業務の書き込みは必ず recordAudit を通る。ディスパッチャ（lib/webhook-dispatcher.ts）
// が audit_logs.id を**単調増加のカーソル**として追い、購読に合う行だけを
// webhook_deliveries へ積む（送信ボックス）。Server Action の中に発火点を
// 散らすと、新しい書き込みを足すたびに「通知を足し忘れる」が起きる。
//
// ■ 送るのは**合図**で、中身ではない（realtime バスと同じ約束）
// 本文は「何が・どの書類に・いつ起きたか」まで。値そのもの（金額・住所）は
// 載せない — 受け取った側が /api/v1 を引き直す。そうすると認可・行スコープ・
// DTO の規則が **1 か所**（API）に残り、Webhook が 2 つ目の漏えい口にならない。
//
// ■ 主体は api_clients（購読は「そのクライアントが読めるもの」だけ）
// 購読を作った時点ではなく**送る時点**で、バックのユーザーの実効権限
// （decide）を引き直す。権限を外したら、購読を消さなくても配送は止まる。
//
// ■ 秘密（署名鍵）は secret-box で暗号化して持つ
// 署名には生値が要る（トークンのようにハッシュでは足りない）ので、
// AES-256-GCM の封筒（SETTINGS_ENCRYPTION_KEY）で持つ。画面には生値を 1 度だけ
// 見せ、以後は下 4 桁だけ。metabase_ro からは剥がす（sql/grants.sql）。

/// 送信先 1 つ = 1 行。購読するイベント種別と署名鍵を持つ。
model WebhookEndpoint {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 権限の主体（どの API クライアントの目で見えるものを送るか）。
  clientId String @map("client_id") @db.Uuid
  /// 人が見分けるための名前（「n8n 受注連携」など）。クライアント内で一意。
  name     String @db.VarChar(120)
  /// 送信先 URL。https、または社内（private / .loc / 単一ラベルのホスト名）の http。
  /// 検証は lib/webhook-core.ts validateWebhookUrl が唯一の定義元。
  url      String @db.VarChar(2048)
  /// 購読するイベント種別（`order_acceptance.created` など）。`*` は全種別。
  /// **空配列は何も送らない**（空を「全部」にすると、作った直後に全件が飛ぶ）。
  eventTypes String[] @default([]) @map("event_types")
  /// secret-box の封筒（Sealed）。生値は作成・再発行の応答に 1 度だけ現れる。
  secret Json

  isActive Boolean @default(true) @map("is_active")
  /// 配送が尽きた（全再試行が失敗した）回数の連続。成功で 0 に戻る。
  /// 閾値を超えたら自動で無効化する（死んだ宛先に延々と積み続けない）。
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(6)
  disabledReason      String?   @map("disabled_reason") @db.VarChar(200)

  lastDeliveredAt DateTime? @map("last_delivered_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client     ApiClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([clientId, name])
  @@index([isActive])
  @@map("webhook_endpoints")
  @@schema("app")
}

/// 配送 1 件 = 1 行（送信ボックス）。イベント × 送信先で 1 行。
///
/// (endpoint_id, audit_event_id, event_type) が unique なので、ディスパッチャが
/// 同じ監査行を 2 度読んでも二重に積まれない（積む処理は冪等）。
/// 受け取り側の重複排除用には `event_id`（= webhook-id ヘッダ）を使う — 再送でも
/// 同じ値になる。
model WebhookDelivery {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId  String @map("endpoint_id") @db.Uuid
  /// 起点の監査行。ping（疎通確認）は null。
  auditEventId BigInt? @map("audit_event_id")
  eventType    String   @map("event_type") @db.VarChar(80)
  /// 送った本文（JSON 文字列そのもの）。署名は**この文字列**に対して計算するので、
  /// 再送でも 1 バイトも変わらない。
  payload      String

  /// PENDING = 送信待ち（次回試行は next_attempt_at）/ SUCCEEDED / FAILED = 打ち切り。
  status        String    @default("PENDING") @db.VarChar(12)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastStatus    Int?      @map("last_status")
  /// 直近の失敗理由（応答本文は保存しない — 相手の内部情報が混ざりうる）。
  lastError     String?   @map("last_error") @db.VarChar(300)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, auditEventId, eventType])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
  @@schema("app")
}
