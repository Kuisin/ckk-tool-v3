// 請求 (_specs/tables.md §9): 請求書 / 締日処理。
//
// 請求書 = 番号付き印刷文書 → (year_month, seq) 複合キー（INV-YYYYMM-NNNNN 導出）。
// 明細は出荷書（DISPATCH・SHIPPED）/ 納品書に由来。STOCK_STORAGE は請求フロー外。
// 会計連携（仕訳 CSV エクスポート）は lib/accounting-export-core.ts。

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID

  @@map("INVOICE_STATUS")
  @@schema("app")
}

enum ClosingStatus {
  PENDING
  PROCESSED
  EXPORTED // 会計連携へ書き出し済み

  @@map("CLOSING_STATUS")
  @@schema("app")
}

/// 締日行の実行区分。SCHEDULED = 締日処理の定期実行（1顧客×1締日=1行、冪等）。
/// MANUAL = 締日を待たない臨時請求（BL11 手動請求）— 同じ顧客・同じ日に何度でも
/// 起こせるので、SCHEDULED とは別の unique 制約（部分 unique index）に分ける。
enum ClosingKind {
  SCHEDULED
  MANUAL

  @@map("CLOSING_KIND")
  @@schema("app")
}

/// 請求書の承認状態。**列は 1 組だけ**で発行前承認・入金前承認の両方を表す —
/// 2 つの関門は同時に開かないので（発行承認は DRAFT、入金承認は SENT のときだけ）、
/// いまどちらの関門に居るかは invoices.status が語る。履歴は種別ごとに
/// approval_requests / approval_records が持つので、denormalize した列は
/// 「いまの状態」だけでよい。delivery_orders と同じ形（§8 過不足納品）。
enum InvoiceApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED

  @@map("INVOICE_APPROVAL_STATUS")
  @@schema("app")
}

model Invoice {
  yearMonth String @map("year_month") @db.Char(6)
  seq       Int

  customerBpId        String   @map("customer_bp_id") @db.Uuid
  customerBranchBpId  String?  @map("customer_branch_bp_id") @db.Uuid
  billingPeriodFrom   DateTime @map("billing_period_from") @db.Date
  billingPeriodTo     DateTime @map("billing_period_to") @db.Date
  subtotal            Decimal  @db.Decimal(12, 2)
  taxAmount           Decimal  @map("tax_amount") @db.Decimal(12, 2)
  totalAmount         Decimal  @map("total_amount") @db.Decimal(12, 2)
  /// 課税区分・税率のスナップショット（発行時点の根拠）。顧客マスタの課税区分は
  /// 後から変わり得るので、税額を凍結するならその根拠も一緒に凍結する。
  /// 既存行は null で、その場合だけ顧客の現在の区分へフォールバックする。
  taxType             TaxType? @map("tax_type")
  taxRate             Decimal? @map("tax_rate") @db.Decimal(5, 4)
  /// 請求金額の通貨（currencies.code。既定 JPY）
  currency            String   @default("JPY")
  status              InvoiceStatus @default(DRAFT)
  issuedAt            DateTime? @map("issued_at") @db.Timestamptz(6)
  dueDate             DateTime? @map("due_date") @db.Date
  sentAt              DateTime? @map("sent_at") @db.Timestamptz(6)
  pdfFileId           String?   @map("pdf_file_id") @db.Uuid
  /// 会計連携（仕訳 CSV）へ書き出した日時。二重取込を防ぐ印で、刻印済みの請求書は
  /// `force=1` を付けない限り再出力できない。会計ソフトの製品名は**列名にも
  /// 画面にも出さない**（i18n-glossary §4 決定 19）— ソフトが替わるたびに
  /// マイグレーションと 3 言語の文言を直す作業が再発するため。
  accountingExportedAt DateTime? @map("accounting_exported_at") @db.Timestamptz(6)
  notes               String?
  // 営業担当（作成時に顧客の主担当を複写したスナップショット）。
  salesRepId          String?   @map("sales_rep_id") @db.Uuid
  /// 締日行の実行区分の写し（billing_closings.kind）— 一覧・詳細で「定期 / 手動」を
  /// 出すために持つ表示用の複写。締日行自体は消えても請求書からは読めるように、
  /// FK ではなく値そのものを持つ（billing_closings と invoices は緩い結びつき）。
  closingKind         ClosingKind? @map("closing_kind")
  /// 承認状態（発行前承認 / 入金前承認。上のコメント参照）。
  approvalStatus      InvoiceApprovalStatus @default(NONE) @map("approval_status")
  requestedAt         DateTime? @map("requested_at") @db.Timestamptz(6)
  requestedBy         String?   @map("requested_by") @db.Uuid
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy          String?   @map("approved_by") @db.Uuid
  rejectedAt          DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy          String?   @map("rejected_by") @db.Uuid
  rejectReason        String?   @map("reject_reason")
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesRep        User?            @relation("InvoiceSalesRep", fields: [salesRepId], references: [id])
  customerBp      BusinessPartner  @relation("InvoiceCustomer", fields: [customerBpId], references: [id])
  customerBranchBp BusinessPartner? @relation("InvoiceCustomerBranch", fields: [customerBranchBpId], references: [id])
  pdfFile         File?            @relation("InvoicePdf", fields: [pdfFileId], references: [id])
  createdByUser   User?            @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  requestedByUser User?            @relation("InvoiceRequestedBy", fields: [requestedBy], references: [id])
  approvedByUser  User?            @relation("InvoiceApprovedBy", fields: [approvedBy], references: [id])
  rejectedByUser  User?            @relation("InvoiceRejectedBy", fields: [rejectedBy], references: [id])

  items InvoiceItem[]
  /// 税率ごとの区分記載（適格請求書）。混在請求書ではヘッダの taxType / taxRate が
  /// null になるため、税の内訳はここだけが持つ。
  taxSummaries InvoiceTaxSummary[]
  /// 転記した会計文書（元・反対仕訳・訂正後の複数本があり得る）。
  accountingDocuments AccountingDocument[] @relation("InvoiceAccountingDocuments")

  @@id([yearMonth, seq])
  @@index([customerBpId])
  @@index([status])
  @@index([approvalStatus])
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, yearMonth, seq])
  @@map("invoices")
  @@schema("app")
}

model InvoiceItem {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceYearMonth String @map("invoice_year_month") @db.Char(6)
  invoiceSeq       Int    @map("invoice_seq")

  // 由来（任意）: 出荷書 / 納品書の複合キー
  deliveryOrderYearMonth String? @map("delivery_order_year_month") @db.Char(6)
  deliveryOrderSeq       Int?    @map("delivery_order_seq")
  deliveryNoteYearMonth  String? @map("delivery_note_year_month") @db.Char(6)
  deliveryNoteSeq        Int?    @map("delivery_note_seq")
  // 由来の注文明細（1 出荷書が複数明細を束ねるため、単価はこの行から取る）
  orderLineId            String? @map("order_line_id") @db.Uuid
  /// **手動で足した追加費用**の由来（料金マスタ MS0G）。出荷書由来（送料等）の
  /// 追加料金行にも入るが、それは delivery_order_year_month が伴う。
  /// deliveryOrderYearMonth IS NULL かつ chargeItemId が入っている行だけが
  /// 「発行前承認が要る、人が足した費用」— lib/invoice-charges.ts が唯一の判定元。
  chargeItemId           Int?    @map("charge_item_id")

  description Json // { ja: '', en: '' }
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  /// 行の税スナップショット（課税区分と、その行に当たった率）。発行時に凍結する。
  /// **税額は行に持たない** — 税は率ごとの束の単位でしか正しく丸められない
  /// （行ごとに丸めると単一税率でも従来と 1 円ずれる）。束は
  /// invoice_tax_summaries が持つ。このマイグレーション以前の行は null。
  taxCategoryId Int?     @map("tax_category_id")
  taxRate       Decimal? @map("tax_rate") @db.Decimal(5, 4)

  invoice     Invoice      @relation(fields: [invoiceYearMonth, invoiceSeq], references: [yearMonth, seq], onDelete: Cascade)
  orderLine   OrderLine?   @relation(fields: [orderLineId], references: [id])
  taxCategory TaxCategory? @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  chargeItem  ChargeItem?  @relation(fields: [chargeItemId], references: [id], onDelete: SetNull)

  @@index([invoiceYearMonth, invoiceSeq])
  @@index([orderLineId])
  @@index([taxCategoryId])
  @@index([chargeItemId])
  @@map("invoice_items")
  @@schema("app")
}

// 締日処理（顧客×締日で請求書生成の単位を管理）
model BillingClosing {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerBpId String        @map("customer_bp_id") @db.Uuid
  closingDate  DateTime      @map("closing_date") @db.Date
  /// 実行区分。SCHEDULED = 締日処理（自動 / 手動一括）が作る、顧客×締日で
  /// 冪等な行。MANUAL = 締日を待たない臨時請求（BL11）— 同じ顧客・同じ日に
  /// 何度でも作れるので unique の対象から外す（下の部分 unique index）。
  kind         ClosingKind   @default(SCHEDULED)
  status       ClosingStatus @default(PENDING)
  totalAmount  Decimal?      @map("total_amount") @db.Decimal(12, 2)
  // 生成した請求書（任意リンク）
  invoiceYearMonth String? @map("invoice_year_month") @db.Char(6)
  invoiceSeq       Int?    @map("invoice_seq")
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(6)
  processedBy  String?   @map("processed_by") @db.Uuid
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 差分同期（/api/v1 の ?updatedSince=）の順序キー。DB 側のトリガーが維持する。
  /// 行は PENDING → PROCESSED → EXPORTED と動くが created_at は動かないので、
  /// これが無いと状態の変化が差分同期から見えなかった。
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerBp BusinessPartner @relation("ClosingCustomer", fields: [customerBpId], references: [id])

  // 定期の締めは 1 顧客 1 締日で冪等（部分 unique index — kind = 'SCHEDULED' の
  // ときだけ効く。Prisma では表現できないので migration.sql に直書きしてある。
  // 手動請求 (kind = MANUAL) は同じ顧客・同じ日に何本でも作れる）。
  @@index([customerBpId, closingDate])
  @@index([status])
  @@index([updatedAt, id])
  @@map("billing_closings")
  @@schema("app")
}
