// 管理ディスプレイ（デジタルサイネージ）— 現場の壁掛けテレビ用。
//
// Raspberry Pi は「固定 URL を開くだけのブラウザ」で、何を映すかは**すべて
// この 2 表が決める**。Pi 側に設定を一切持たせないのが設計の芯 — 持たせた
// 瞬間、台数ぶんの設定が現場に散り、1 台ごとに違う状態になる。
//
//   display_devices       = 「この画面は登録済みディスプレイ」＋「何を映すか」
//                           （Cookie はトークン生値、DB はハッシュのみ。365日）
//   display_link_requests = 据付時の一時コード（10分）
//
// **何を映すかは画面ごとに持つ。** 当初は display_profiles に切り出して画面から
// 参照していたが、掲示板は 1 枚ずつ違うもの（この壁は生産状況、あの壁は出荷予定）
// を映すので共有される内容がほとんど生まれず、1 枚増やすたびに「内容を作る →
// 画面を作る → 結ぶ」の 3 手順を踏むだけの構造になっていた。
//
// **登録の手順はキオスク端末（kiosk_devices）と揃える**: 作る（PENDING）→
// リンク（LINKED）→ 有効化（ACTIVE）。手順を変えると、現場は「タブレットの
// ときはこう、テレビのときはこう」を 2 つ覚えることになる。リンクコードの
// 桁数も QR の中身も同じにしてあるので、読み取りも 1 つの部品で足りる。
//
// キオスク端末と違うのは 1 点だけ — **遷移ログ（kiosk_device_logs 相当）を
// 持たない**。あれはフロア端末の使用実態を追うためのもので、誰も触らない
// 掲示板には要らない。死活は last_seen_at 1 列から読むときに計算する。
//
// 個人データは持たない（人が紐づかない機器なので login_attempts とは無関係）。
// ただしトークンハッシュと IP は持つので、grants.sql で metabase_ro から
// 列単位で隠す。

enum DisplayDeviceStatus {
  PENDING // プロファイル作成済・リンク待ち（= オープン。リンク解除で戻る）
  LINKED // 画面リンク済・有効化待ち（有効化はこの状態からのみ）
  ACTIVE // 有効
  DISABLED // 一時停止（再有効化可。トークンは生きたまま）
  REVOKED // 取り消し（トークン破棄・再リンクが必要）

  @@map("DISPLAY_DEVICE_STATUS")
  @@schema("app")
}

// 何を映すか。増やすときは lib/display-content.ts の zod スキーマも一緒に足す
// （content_config の形は種別ごとに違うので、DB では検証できない）。
enum DisplayContentType {
  APP_PAGE // アプリ内の表示専用ページ（生産ボード等）
  METABASE // Metabase ダッシュボードの署名済み埋め込み
  URL // 任意の URL を iframe で表示
  IMAGE // 画像 1 枚（掲示・注意喚起）

  @@map("DISPLAY_CONTENT_TYPE")
  @@schema("app")
}

// ─── ディスプレイ端末 ────────────────────────────────────────────────────────

model DisplayDevice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 端末名は多言語 JSON { ja, en }。管理画面は利用者の言語で読むので
  // kiosk_devices と同じ規約にそろえる。
  name     Json?
  location String?
  plantId  Int?    @map("plant_id")

  // ディスプレイ自身の画面（生産状況・出荷予定などの盤面と、登録前の
  // リンクコード画面）の表示言語。ログインの概念が無い（見る人が誰か
  // わからない）ため kiosk_devices.locale と同じ形で端末自体に持たせる。
  // 未設定 = 既定言語（ja）。SY09 の編集モーダルから変更する。
  locale String?

  // 何を映すか。**画面ごとに直接持つ。**
  //
  // 以前は「表示内容」を別に作って端末へ割り当てる形だったが、1 枚しか
  // 使わない現場でも 2 つのものを作って結ぶ必要があり、しかも作った直後の
  // 画面は「未割当」で何も映らなかった。壁のテレビは 1 枚 1 用途がほとんどで、
  // 共有する必要がまず無い。だから端末の設定として持たせる。
  //
  // content_config は種別ごとに形が違う JSON（lib/display-content.ts が正）:
  //   APP_PAGE { page, options }   ← 既定。作った時点で生産状況が映る
  //   METABASE { dashboardId, params }
  //   URL      { url }
  //   IMAGE    { fileId }
  contentType   DisplayContentType @default(APP_PAGE) @map("content_type")
  contentConfig Json               @default("{\"page\": \"production\", \"options\": {}}") @map("content_config")

  // 画面の再取得間隔（秒）。0 = 自動再取得しない（変更の合図だけで更新する）。
  refreshIntervalSec Int @default(60) @map("refresh_interval_sec")

  status DisplayDeviceStatus @default(PENDING)

  // 表示倍率（%）。**画面の大きさと見る距離に合わせる**ための微調整で、
  // 同じものを映していても 43 型と 65 型では読みやすい大きさが違う。
  // 50〜200 の 5 刻み（範囲は DB の CHECK でも閉じる）。
  scalePercent Int @default(100) @map("scale_percent")

  // どの機械の何枚目か（自己申告の**手掛かり**であって身分ではない）。
  //
  // Raspberry Pi 5 は HDMI が 2 口あり、1 台で 2 枚のテレビを回せる。画面ごとに
  // ブラウザのプロファイルを分けるので **1 枚 = この表の 1 行**（映すものも倍率も
  // 画面ごとに決まる）。ただし一覧では「2 枚まとめて消えた = 箱が落ちた／
  // 1 枚だけ = ケーブルかテレビ側」を見分けたいので、出どころを控えておく。
  //
  // 値は Pi が URL に載せてくる（hostname と画面番号）ので**詐称できる**。
  // だから表示とまとめ表示にしか使わない — 認証にも権限にも使わない
  // （端末シグネチャと同じ扱い）。
  machineId  String? @map("machine_id") @db.VarChar(64)
  screenIndex Int?   @map("screen_index")

  // デバイストークン（Cookie は生値、DB は SHA-256 のみ）。
  // 有効期間はキオスクの 30 日ではなく **365 日** — 壁のディスプレイは誰も
  // 触らないので、短いと誰も見ていない間に自分で登録画面へ戻ってしまう。
  deviceTokenHash      String?   @unique @map("device_token_hash")
  deviceTokenExpiresAt DateTime? @map("device_token_expires_at") @db.Timestamptz(6)

  // 死活と素性（参考情報のみ。認証には使わない）。
  // last_seen_at は WS 接続・30秒ハートビート・/api/display/heartbeat が更新し、
  // 「オンラインか」は読むときに now() との差で判定する（status には持たない）。
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  lastIpAddress String?   @map("last_ip_address")
  userAgent     String?   @map("user_agent")
  appVersion    String?   @map("app_version") @db.VarChar(40)

  linkedAt      DateTime? @map("linked_at") @db.Timestamptz(6)
  activatedById String?   @map("activated_by") @db.Uuid
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant       Plant? @relation("DisplayDevicePlant", fields: [plantId], references: [id])
  activatedBy User?  @relation("DisplayDeviceActivatedBy", fields: [activatedById], references: [id])

  linkRequests DisplayLinkRequest[] @relation("DisplayLinkRequestDevice")

  @@index([plantId])
  @@index([status])
  @@index([contentType])
  @@map("display_devices")
  @@schema("app")
}

// ─── リンクリクエスト（画面が出す一時コード） ────────────────────────────────
//
// kiosk_link_requests と同型・同寿命（12桁・10分）。ディスプレイが自分で作って
// 画面に QR と文字で出し、管理者が SY09 で読み取ってオープンなプロファイルへ
// 結ぶ。device_id が入った時点が「リンク成立」で、その有無が唯一の印。
//
// 期限切れ行の掃除は POST /api/display/setup/begin が入口で行う（pg_cron を
// 増やさない — キオスクの setup/begin と同じやり方）。
// コードは生の秘密なので grants.sql で metabase_ro から表ごと落とす。

model DisplayLinkRequest {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique // Crockford 12桁（I/O/0/1 を含まない）
  deviceId String? @map("device_id") @db.Uuid // リンク先プロファイル（成立後）

  userAgent     String?  @map("user_agent")
  lastIpAddress String?  @map("last_ip_address")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6) // 10分

  device DisplayDevice? @relation("DisplayLinkRequestDevice", fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("display_link_requests")
  @@schema("app")
}
