// フォーム（CM02, /general/forms）— 利用者が項目を組んで作る汎用フォーム。
// 用途は 2 つ: アンケート（回答収集）と 申請/報告（承認ステップ付き）。
//
// 定義を JSON 1 枚に持たせず「定義行 + 不変バージョン行」に割るのは、回答が
// 何年も残るのに定義は編集され続けるため。回答は必ず「回答した時点の
// バージョン」を指すので、後から項目を消しても過去の回答の意味が壊れない
// （前例: inspection_templates の @@unique([code, version]) /
//  product_process_route_versions）。最新 = max(version)、is_latest は持たない。
//
// 共有（誰が回答・閲覧・編集できるか）は share_grants が持つ。権限コード `form`
// は「フォームを作る側」の門番で、回答者側の可否はフォームごとの共有設定が決める。

model Form {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 短縮 URL 用のコード（Crockford Base32 8 桁）。/f/<code> で回答画面に入る。
  // アプリ配下でない短い URL にしてあるのは、将来社外公開へ広げる余地を残すため。
  code        String  @unique
  title       String
  description String?

  kind   FormKind
  status FormStatus @default(DRAFT)

  // 回答者を画面に出すかどうか。**記録は常にする**（下の form_responses.submitted_by は
  // NOT NULL）。HIDDEN は「集計時に見せない」であって匿名ではない — 自分の回答を
  // 編集させるためと、自分の回答一覧を出すために本人特定が要る。
  respondentVisibility RespondentVisibility @default(SHOWN) @map("respondent_visibility")

  // 公開中の定義バージョン。0 = まだ一度も公開していない。
  currentVersion Int @default(0) @map("current_version")
  // フォーム内の連番（画面に出す「No.」）。採番は提出トランザクション内で
  // UPDATE ... RETURNING するので行ロックで競合しない。
  recordSeq Int @default(0) @map("record_seq")

  // 承認フロー（kind = REQUEST のときだけ意味を持つ）。実際の段数と承認者は
  // 承認設定 (MS0B) の approval_flows / approval_flow_rules が持つ。
  approvalEnabled Boolean @default(false) @map("approval_enabled")
  // 承認依頼を出したあと、本人がまだ直せるか。
  //   false（既定）… 依頼した時点で締める（従来どおり）
  //   true          … **最初の承認が下りるまで**は直せる
  // 承認者が口頭で「ここを直して」と言う場面があるので、誰も承認していない
  // うちは直させたい。逆に 1 人でも承認したあとに中身が変わると、その承認が
  // 何に対するものだったのか分からなくなるので、そこで必ず締める。
  // 差し戻しは status=REJECTED で必ず直せる（この設定に依らない）。
  editableUntilFirstApproval Boolean @default(false) @map("editable_until_first_approval")
  // 1 人 1 回に制限するか。false = 何度でも出せる。
  allowMultiple Boolean @default(true) @map("allow_multiple")

  // 受付期間。status に CLOSED を持たせず、この 2 つと現在時刻から導出する
  // （lib/form-schema.ts formAvailability）。締切は cron ではなく毎リクエストの
  // 評価で閉じる。
  opensAt  DateTime? @map("opens_at") @db.Timestamptz(6)
  closesAt DateTime? @map("closes_at") @db.Timestamptz(6)

  // 回答者が自分の回答を編集できる期間。
  responseEditMode      ResponseEditMode @default(NONE) @map("response_edit_mode")
  responseEditableUntil DateTime?        @map("response_editable_until") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser User? @relation("FormCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("FormUpdatedBy", fields: [updatedBy], references: [id])

  versions  FormVersion[]
  approvalSteps FormApprovalStep[]
  responses FormResponse[]

  @@index([status, updatedAt])
  @@map("forms")
  @@schema("app")
}

enum FormKind {
  SURVEY // アンケート（回答収集）
  REQUEST // 申請・報告（承認ステップを付けられる）

  @@schema("app")
}

enum FormStatus {
  DRAFT // 未公開（作成中）
  PUBLISHED // 公開済み（受付可否は opens_at / closes_at が決める）
  ARCHIVED // 使い終わった

  @@schema("app")
}

enum RespondentVisibility {
  SHOWN // 一覧・詳細・CSV に回答者を出す
  HIDDEN // どの画面にも出さない（記録はする）

  @@schema("app")
}

enum ResponseEditMode {
  NONE // 提出したら編集できない
  UNTIL_CLOSE // 受付終了まで編集できる
  UNTIL_DATE // response_editable_until まで編集できる

  @@schema("app")
}

// 公開した定義の不変スナップショット。回答はここを指す。
model FormVersion {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId  String @map("form_id") @db.Uuid
  version Int
  // FormFieldDef[]（lib/form-schema.ts の zod で検証してから保存する）。
  schema Json
  // FormSectionDef[]（lib/form-branching.ts の parseFormSections で検証してから
  // 保存する）。既定 '[]' = セクション無し（1 ページの従来どおりの回答画面）。
  // fields 側と別列にしているのは、フィールドの配列構造 (formFieldsSchema が
  // 検証する z.array) を変えずに済ませるため — 既存の全呼び出し元・
  // form-transfer.ts のインポート/エクスポートを壊さない。
  sections Json @default("[]")

  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy String?  @map("published_by") @db.Uuid

  form            Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  publishedByUser User? @relation("FormVersionPublishedBy", fields: [publishedBy], references: [id])

  @@unique([formId, version])
  @@map("form_versions")
  @@schema("app")
}

model FormResponse {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 業務キー。承認依頼・監査ログ・添付はこの文字列で紐づく（FK は張らない）。
  responseNumber String @unique @map("response_number")
  // フォーム内の連番（kintone の「No.」相当）。表示・印刷で使う。
  recordNo Int @map("record_no")

  formId String @map("form_id") @db.Uuid
  // 回答時点の定義バージョン。以後変わらない。
  version Int

  status FormResponseStatus @default(DRAFT)

  // { [fieldKey]: value }。値の形は lib/form-schema.ts の型ごとの規約に従う。
  answers Json
  // answers の平文射影（検索・監査ログの可読性のため）。
  plainText String? @map("plain_text")

  // 回答者。**常に記録する** — 表示するかは forms.respondent_visibility が決める。
  submittedBy String    @map("submitted_by") @db.Uuid
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)

  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedAt   DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectReason String?   @map("reject_reason")
  // 状態遷移履歴 [{ action, user, at, notes }]（他書類と同じ row-workflow）。
  history Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  form            Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedByUser User @relation("FormResponseSubmittedBy", fields: [submittedBy], references: [id])

  completionNotices FormCompletionNotice[]

  @@unique([formId, recordNo])
  @@index([formId, status])
  @@index([submittedBy, createdAt])
  @@map("form_responses")
  @@schema("app")
}

enum FormResponseStatus {
  DRAFT // 下書き（本人だけが見える）
  SUBMITTED // 提出済み（承認なしのフォームはここで終わり）
  REQUESTED // 承認依頼中
  APPROVED // 承認済み
  REJECTED // 差し戻し（本人が直して再提出できる）

  @@schema("app")
}

/// フォームごとの承認フロー（段の定義）。
///
/// WHY 書類共通の approval_flow_steps を使わないのか: あちらは **書類種別ごとに
/// 1 本**（target_type が主キー）で、「注文請書はこの承認」という単位でしか
/// 表現できない。フォームは利用者がいくつでも作るもので、稟議・日報・点検簿が
/// 同じ承認フローを共有する理由がない。フォームごとに持たせる。
///
/// 承認エンジン（lib/approvals.ts）は依頼時にこの定義を flow_snapshot へ写して
/// 進むので、進行中の依頼は後からフローを変えても影響を受けない — 共通フローと
/// 同じ扱いのまま。
model FormApprovalStep {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId String @map("form_id") @db.Uuid
  stepNo Int    @map("step_no")
  name Json // { ja, en } 例「一次承認」

  // 段の宛先は **承認グループか「カスタム（この段だけの承認者）」のどちらか**。
  // group_id が NULL ならカスタムで、承認者は form_approval_step_approvers に
  // 1 人以上入る。カスタムを用意するのは、フォームだと「この稟議は部長と
  // 経理の 2 人が見る」程度の段が多く、そのたびに承認グループを作ると
  // グループ一覧が使い捨てで埋まって読めなくなるため。
  //
  // 「カスタムなら承認者が 1 人以上」は表をまたぐので CHECK では書けない。
  // 書き込み口（saveFormApprovalFlow）で守り、依頼時にも承認者ゼロの段が
  // あれば止める（誰も押せない依頼を作らない）。
  groupId Int? @map("group_id")

  mode ApprovalMode @default(ANY)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  form      Form                      @relation(fields: [formId], references: [id], onDelete: Cascade)
  group     ApprovalGroup?            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  approvers FormApprovalStepApprover[]

  @@unique([formId, stepNo])
  @@index([groupId])
  @@map("form_approval_steps")
  @@schema("app")
}

/// カスタム段の承認者（この段だけの指名）。承認グループを作らずに 1..N 人を指す。
model FormApprovalStepApprover {
  stepId    String @map("step_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  step FormApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user User             @relation("FormApprovalStepApprover", fields: [userId], references: [id], onDelete: Restrict)

  @@id([stepId, userId])
  @@index([userId])
  @@map("form_approval_step_approvers")
  @@schema("app")
}

// レコード単位の共有。フォーム (CM02) と社内文書 (CM03) が共用する。
// 既存のポリモーフィック規約（owner_type = @@map 名 / owner_id = 業務キー文字列 /
// FK は張らない）に合わせてある。RBAC の権限コードは「アプリを使えるか」までしか
// 決められず、「この 1 件を誰に見せるか」は表現できないので別立てにした。
model ShareGrant {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType String @map("owner_type") // forms / internal_pages
  ownerId   String @map("owner_id") // forms.code / internal_pages.page_number

  subjectType ShareSubjectType @map("subject_type")
  // plants.id / roles.id / users.id を文字列で持つ（対象種別ごとに型が違うため）。
  // EVERYONE のときは null。
  subjectId String? @map("subject_id")

  level ShareLevel

  // 「この条件に当てはまる回答だけ見せる」— READ の共有にだけ意味がある
  // （EDIT/MANAGE はフォームを預かる側なので絞らない）。
  // conditionFieldKey が null なら絞り込みなし＝全件。
  //
  // 値は突合キー（select/multiselect は選択肢の value、lookup はマスタの id）で、
  // ラベルは表示用のスナップショット。マスタ名が変わっても共有設定の画面が
  // 読めるようにするため（回答の lookup が {id,label} を持つのと同じ理由）。
  conditionFieldKey String?  @map("condition_field_key")
  conditionValues   String[] @default([]) @map("condition_values")
  conditionLabels   String[] @default([]) @map("condition_labels")

  // 「この共有先へ、申請・報告の完了を知らせる」（フォームだけが使う）。
  // 宛先を別表に持たせず共有行に載せるのは、**通知先は必ずその回答を読める人**
  // でなければ意味が無いため — 通知を開いたら notFound、という行き止まりを
  // 構造として作れないようにしてある。条件（conditionValues）もそのまま効くので、
  // 「拠点 A の回答が完了したときだけ拠点 A の課長へ」が 1 行で書ける。
  // RESPOND は他人の回答を読めないので、書き込み口（replaceShareGrants）が落とす。
  notifyOnComplete Boolean @default(false) @map("notify_on_complete")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdByUser User? @relation("ShareGrantCreatedBy", fields: [createdBy], references: [id])

  @@unique([ownerType, ownerId, subjectType, subjectId, level])
  @@index([ownerType, ownerId])
  @@map("share_grants")
  @@schema("app")
}

enum ShareSubjectType {
  EVERYONE // ログインユーザー全員
  PLANT // 拠点所属（user_plants）
  ROLE // ロール保持（user_role_relation）
  USER // 個人指定

  @@schema("app")
}

enum ShareLevel {
  RESPOND // フォームに回答できる
  READ // 読める（フォーム= 全回答の閲覧 / 文書 = 本文の閲覧）
  EDIT // 編集できる
  MANAGE // 共有設定を含めて管理できる

  @@schema("app")
}

/// 申請・報告の「完了しました」を誰に届けたか、その人が読んだか。
///
/// notifications 行（ベル・メール・プッシュ）とは別に持つ。あちらは全機能が
/// 共有する流れる通知で、対象を指す列が無い（linkPath の文字列だけ）。ここは
/// **どの回答を誰に届けたか**の台帳で、CM01「完了した申請」の一覧と未読の印は
/// この表だけを読む。二重送信の防止（同じ回答で 2 度作らない）も兼ねる。
///
/// read_at は明示的な「確認しました」ボタンではなく、その回答を開いた時刻を
/// 記録するだけ（受け身の既読）。
model FormCompletionNotice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseNumber String    @map("response_number")
  userId         String    @map("user_id") @db.Uuid
  notifiedAt     DateTime  @default(now()) @map("notified_at") @db.Timestamptz(6)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)

  response FormResponse @relation(fields: [responseNumber], references: [responseNumber], onDelete: Cascade)
  user     User         @relation("FormCompletionNoticeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([responseNumber, userId])
  @@index([userId, notifiedAt(sort: Desc)])
  @@map("form_completion_notices")
  @@schema("app")
}
