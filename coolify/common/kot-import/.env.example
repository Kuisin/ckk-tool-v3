# King of Time admin login (legacy fallback — used only when no kot_settings
# DB row has been saved via adminTools' /kot 設定 modal).
KOT_ID=
KOT_PW=

# Must match adminTools' CRED_ENCRYPTION_KEY — decrypts KOT_ID/PW set via its
# 設定 modal. Without it (or if it doesn't match), the DB row can't be
# decrypted and KOT_ID/KOT_PW above are used instead.
CRED_ENCRYPTION_KEY=

# Postgres password for the kot DB.
DB_PASSWORD=change-me

# Import cadence (seconds) and how many days back to pull each run.
KOT_INTERVAL_SECONDS=21600
KOT_DAYS=7
