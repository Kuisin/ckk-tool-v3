// Auth / RBAC (_specs/tables.md §Auth).
// The aggregated `user_permissions` view is created in raw SQL inside the
// initial migration — always query the view, not the relation tables.

enum UserGroup {
  SYSTEM
  EMPLOYEE
  GUEST

  @@map("USER_GROUP")
  @@schema("app")
}

enum Action {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  APPROVE
  ADMIN

  @@map("ACTION")
  @@schema("app")
}

enum Scope {
  ALL
  REGION
  COUNTRY
  PLANT
  DEPARTMENT
  TEAM
  SUB
  OWN

  @@map("SCOPE")
  @@schema("app")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group       UserGroup
  employeeId  String?   @unique @map("employee_id") @db.Uuid
  username    String    @unique
  displayName String    @map("display_name")
  email       String?
  // credentials ログイン用（scrypt: salt:hash hex）。SSO ユーザーは null。
  passwordHash String?  @map("password_hash")
  // true の間は /password-change 以外を開けない。初期管理者（既定パスワード
  // `admin`）に立てておき、本人が変更した時点で false になる。
  passwordChangeRequired Boolean @default(false) @map("password_change_required")
  // プロフィール写真（アプリ内でアップロード — AD からは取得しない）。
  // 実体は SeaweedFS `avatars/…`、参照は app.files 行。正方形で保存する。
  // 大 = 詳細・ホーム用、小 = 一覧・ヘッダー・履歴用のサムネイル。
  avatarFileId      String? @map("avatar_file_id") @db.Uuid
  avatarThumbFileId String? @map("avatar_thumb_file_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  // 利用停止（SY01）。is_active が唯一のゲートで、ここは「なぜ / いつまで」だけを持つ。
  // disabled_until = NULL かつ is_active=false → 恒久停止（手で戻すまで戻らない）
  // disabled_until = 日時                      → 一時停止（pg_cron が期限で戻す）
  disabledUntil  DateTime? @map("disabled_until") @db.Timestamptz(6)
  disabledReason String?   @map("disabled_reason")
  disabledAt     DateTime? @map("disabled_at") @db.Timestamptz(6)
  disabledById   String?   @map("disabled_by") @db.Uuid
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  disabledBy              User?              @relation("UserDisabledBy", fields: [disabledById], references: [id], onDelete: SetNull)
  usersDisabled           User[]             @relation("UserDisabledBy")
  avatarFile              File?              @relation("UserAvatarFile", fields: [avatarFileId], references: [id], onDelete: SetNull)
  avatarThumbFile         File?              @relation("UserAvatarThumbFile", fields: [avatarThumbFileId], references: [id], onDelete: SetNull)
  roleAssignments         UserRoleRelation[] @relation("UserRoles")
  rolesAssigned           UserRoleRelation[] @relation("UserRolesAssignedBy")
  businessPartnersCreated BusinessPartner[]  @relation("BpCreatedBy")
  estimatesCreated        Estimate[]         @relation("EstimateCreatedBy")
  priceListEntriesCreated PriceListEntry[]   @relation("PriceListEntryCreatedBy")
  quotesCreated           Quote[]            @relation("QuoteCreatedBy")
  filesUploaded           File[]             @relation("FileUploadedBy")
  fileFolderGrants        FileFolderGrant[]  @relation("FileFolderGrantUser")
  fileFolderGrantsCreated FileFolderGrant[]  @relation("FileFolderGrantCreatedBy")
  auditLogs               AuditLog[]         @relation("AuditLogUser")
  matchAliasesCreated     MatchAlias[]       @relation("MatchAliasCreatedBy")
  systemSettingsUpdated   SystemSetting[]    @relation("SystemSettingUpdatedBy")
  featureFlagsUpdated     FeatureFlag[]      @relation("FeatureFlagUpdatedBy")
  approvalGroupMembers    ApprovalGroupMember[] @relation("ApprovalGroupMemberUser")
  workOrdersCreated       WorkOrder[]           @relation("WorkOrderCreatedBy")
  workOrderLinksCreated   WorkOrderLink[]       @relation("WoLinkCreatedBy")
  flowChangesRequested    WorkOrderFlowChange[] @relation("FlowChangeRequestedBy")
  flowChangesResolved     WorkOrderFlowChange[] @relation("FlowChangeResolvedBy")
  flowChangesAcknowledged WorkOrderFlowChange[] @relation("FlowChangeAcknowledgedBy")
  acceptanceCancelsRequested OrderAcceptanceCancelRequest[] @relation("AcceptanceCancelRequestedBy")
  acceptanceCancelsResolved  OrderAcceptanceCancelRequest[] @relation("AcceptanceCancelResolvedBy")
  routesCreated           ProductProcessRoute[]        @relation("RouteCreatedBy")
  routeVersionsCreated    ProductProcessRouteVersion[] @relation("RouteVersionCreatedBy")
  stepPlansAssigned       WorkOrderStepPlan[]          @relation("StepPlanUser")
  stepPlansCreated        WorkOrderStepPlan[]          @relation("StepPlanCreatedBy")
  stepActualsAssigned     WorkOrderStepActual[]        @relation("StepActualUser")
  stepActualsCreated      WorkOrderStepActual[]        @relation("StepActualCreatedBy")
  deliveryOrdersCreated   DeliveryOrder[]       @relation("DeliveryOrderCreatedBy")
  deliveryNotesCreated    DeliveryNote[]        @relation("DeliveryNoteCreatedBy")
  invoicesCreated         Invoice[]             @relation("InvoiceCreatedBy")
  designRequestsCreated   DesignRequest[]       @relation("DesignRequestCreatedBy")
  designRequestsAssigned  DesignRequest[]       @relation("DesignRequestAssignee")
  designRequestsRequested DesignRequest[]       @relation("DesignRequestRequestedBy")
  designRequestsApproved  DesignRequest[]       @relation("DesignRequestApprovedBy")
  designRequestsCompleted DesignRequest[]       @relation("DesignRequestCompletedBy")
  designRequestsCancelled DesignRequest[]       @relation("DesignRequestCancelledBy")
  designFilesCreated      DesignFile[]          @relation("DesignFileCreatedBy")
  attachmentsUploaded     DocumentAttachment[]  @relation("AttachmentUploadedBy")
  documentMemosCreated    DocumentMemo[]        @relation("DocumentMemoCreatedBy")
  documentMemosUpdated    DocumentMemo[]        @relation("DocumentMemoUpdatedBy")
  documentMemosArchived   DocumentMemo[]        @relation("DocumentMemoArchivedBy")
  documentMemoRevisions   DocumentMemoRevision[] @relation("DocumentMemoRevisionEditedBy")
  linkIndexCreated        LinkIndex[]           @relation("LinkIndexCreatedBy")
  linkBlacklistCreated    LinkBlacklist[]       @relation("LinkBlacklistCreatedBy")
  approvalRequestsMade    ApprovalRequest[]     @relation("ApprovalRequestedBy")
  approvalSlots           ApprovalRequestApprover[] @relation("ApprovalRequestApproverUser")
  approvalSlotsActed      ApprovalRequestApprover[] @relation("ApprovalRequestApproverActedBy")
  approvalFlowsUpdated    ApprovalFlow[]        @relation("ApprovalFlowUpdatedBy")
  approvalFlowRulesUpdated ApprovalFlowRule[]   @relation("ApprovalFlowRuleUpdatedBy")
  approvalRecords         ApprovalRecord[]      @relation("ApprovalRecordApprover")
  approvalRecordsAsOrig   ApprovalRecord[]      @relation("ApprovalRecordDelegateFor")
  delegationsGiven        ApprovalDelegate[]    @relation("DelegateDelegator")
  delegationsReceived     ApprovalDelegate[]    @relation("DelegateDelegate")
  delegationsCreated      ApprovalDelegate[]    @relation("DelegateCreatedBy")
  acceptancesCreated      OrderAcceptance[]     @relation("AcceptanceCreatedBy")

  // 営業担当 — 顧客マスタの候補一覧（bp_sales_reps）と、各書類のスナップショット。
  bpSalesRepOf            BpSalesRep[]      @relation("BpSalesRepUser")
  estimatesAsSalesRep     Estimate[]        @relation("EstimateSalesRep")
  priceListsAsSalesRep    PriceListEntry[]  @relation("PriceListEntrySalesRep")
  quotesAsSalesRep        Quote[]           @relation("QuoteSalesRep")
  acceptancesAsSalesRep   OrderAcceptance[] @relation("AcceptanceSalesRep")
  deliveryNotesAsSalesRep DeliveryNote[]    @relation("DeliveryNoteSalesRep")
  invoicesAsSalesRep      Invoice[]         @relation("InvoiceSalesRep")

  posRequested MaterialPurchaseOrder[] @relation("PoRequestedBy")
  posApproved  MaterialPurchaseOrder[] @relation("PoApprovedBy")
  posOrdered   MaterialPurchaseOrder[] @relation("PoOrderedBy")
  posCompleted MaterialPurchaseOrder[] @relation("PoCompletedBy")
  posCancelled MaterialPurchaseOrder[] @relation("PoCancelledBy")
  posCreated   MaterialPurchaseOrder[] @relation("PoCreatedBy")
  receiptsCreated MaterialReceipt[]    @relation("ReceiptCreatedBy")

  prqsRequested PurchaseRequest[] @relation("PrqRequestedBy")
  prqsApproved  PurchaseRequest[] @relation("PrqApprovedBy")
  prqsOrdered   PurchaseRequest[] @relation("PrqOrderedBy")
  prqsCancelled PurchaseRequest[] @relation("PrqCancelledBy")
  prqsCreated   PurchaseRequest[] @relation("PrqCreatedBy")

  notifications       Notification[]           @relation("NotificationUser")
  pushSubscriptions   PushSubscription[]       @relation("PushSubscriptionUser")
  notificationSetting UserNotificationSetting? @relation("UserNotificationSettingUser")
  homeSetting         UserHomeSetting?         @relation("UserHomeSettingUser")
  viewSettings        UserViewSetting[]        @relation("UserViewSettingUser")

  userPlants         UserPlant[] @relation("UserPlantUser")
  userPlantsAssigned UserPlant[] @relation("UserPlantAssignedBy")

  kioskCards            KioskCard[]    @relation("KioskCardUser")
  kioskCardsAssigned    KioskCard[]    @relation("KioskCardAssignedBy")
  kioskCardsRevoked     KioskCard[]    @relation("KioskCardRevokedBy")
  kioskDevicesActivated KioskDevice[]  @relation("KioskDeviceActivatedBy")
  kioskSessions         KioskSession[] @relation("KioskSessionUser")
  kioskDeviceLogs       KioskDeviceLog[] @relation("KioskDeviceLogUser")
  displayDevicesPaired  DisplayDevice[]  @relation("DisplayDevicePairedBy")
  displayProfiles       DisplayProfile[] @relation("DisplayProfileCreatedBy")

  // 認証イベント（security.prisma）。失敗行は user_id が null のことも多い —
  // ユーザーに解決できなかった試行そのものを残すのがこのテーブルの目的。
  loginAttempts LoginAttempt[] @relation("LoginAttemptUser")

  // 取引先ポータル（社外向け）。社員が「作った / 無効にした / 発行した」側の関連で、
  // ポータルの主体そのものは PortalAccount（app.users とは別）。
  portalAccountsCreated  PortalAccount[]      @relation("PortalAccountCreatedBy")
  portalAccountsDisabled PortalAccount[]      @relation("PortalAccountDisabledBy")
  portalGrantsCreated    PortalGrant[]        @relation("PortalGrantCreatedBy")
  portalGrantsRevoked    PortalGrant[]        @relation("PortalGrantRevokedBy")
  portalLinksCreated     PortalDocumentLink[] @relation("PortalLinkCreatedBy")
  portalLinksRevoked     PortalDocumentLink[] @relation("PortalLinkRevokedBy")
  portalBackupCodes      PortalBackupCode[]   @relation("PortalBackupCodeIssuedBy")
  userDevices   UserDevice[]   @relation("UserDeviceUser")

  // 特権アクセス（security.prisma）。申請者・決裁者・失効実行者はそれぞれ別の
  // 人になりうるので 3 本に分けてある。B の変更依頼は「対象」も人。
  privilegedRequested   PrivilegedAccessRequest[] @relation("PrivilegedRequestedBy")
  privilegedDecided     PrivilegedAccessRequest[] @relation("PrivilegedDecidedBy")
  privilegedRevoked     PrivilegedAccessRequest[] @relation("PrivilegedRevokedBy")
  userChangesTargeting  UserChangeRequest[]       @relation("UserChangeTarget")
  userChangesRequested  UserChangeRequest[]       @relation("UserChangeRequestedBy")
  userChangesDecided    UserChangeRequest[]       @relation("UserChangeDecidedBy")

  // 一般カテゴリ: フォーム (CM02) / 社内文書 (CM03) の共有。
  formsCreated       Form[]         @relation("FormCreatedBy")
  formsUpdated       Form[]         @relation("FormUpdatedBy")
  formVersionsPublished FormVersion[] @relation("FormVersionPublishedBy")
  formResponses      FormResponse[] @relation("FormResponseSubmittedBy")
  formCompletionNotices FormCompletionNotice[] @relation("FormCompletionNoticeUser")
  shareGrantsCreated ShareGrant[]   @relation("ShareGrantCreatedBy")
  internalPagesCreated   InternalPage[]            @relation("InternalPageCreatedBy")
  internalPagesUpdated   InternalPage[]            @relation("InternalPageUpdatedBy")
  internalPageRevisions  InternalPageRevision[]    @relation("InternalPageRevisionEditedBy")
  internalPageBlame      InternalPageLineBlame[]   @relation("InternalPageBlameEditedBy")
  internalPageComments   InternalPageLineComment[] @relation("InternalPageCommentCreatedBy")
  internalPageCommentsResolved InternalPageLineComment[] @relation("InternalPageCommentResolvedBy")

  // 表示設定（本人が /profile/preferences で変更する。AD 由来ではない）。
  //
  // UI 言語（"ja" | "en" | "zh" — docs の DOCS_LANGS と同じ集合）。
  // キオスクの QR ログイン後 UI とアプリ本体が参照し、本人が切り替える。
  locale String @default("ja")
  // 日付の並び。値は表示パターンそのもの（"YYYY/MM/DD" | "YYYY-MM-DD" |
  // "DD/MM/YYYY" | "MM/DD/YYYY"）。既定は日本の慣習。
  dateFormat String @default("YYYY/MM/DD") @map("date_format") @db.VarChar(16)
  // 時刻表記（"24h" | "12h"）。
  timeFormat String @default("24h") @map("time_format") @db.VarChar(8)
  // 表示タイムゾーン（IANA 名。例 "Asia/Tokyo"）。保存は常に UTC で、
  // ここは「画面に出すときどこの時刻で読むか」だけを決める。
  timeZone String @default("Asia/Tokyo") @map("time_zone") @db.VarChar(64)
  // 文字の大きさ（"xs" | "sm" | "md" | "lg" | "xl"。既定 "md" = 従来どおり）。
  // 段は 5 つで、真ん中が今までの大きさ。倍率そのものを持たないのは、
  // 刻みを変えたくなったときに DB の値を書き換えずに済ませるため
  // （倍率の定義は lib/user-preferences-core.ts の 1 か所）。
  textScale String @default("md") @map("text_scale") @db.VarChar(8)
  // 文字を太くする（iOS の「文字を太くする」相当）。本文の太さを 1 段上げる。
  boldText Boolean @default(false) @map("bold_text")

  // Employees link to the shared directory by AD objectGUID (stable across
  // username/attribute changes). Null for SYSTEM / GUEST users.
  employee EmployeeDirectory? @relation("UserEmployee", fields: [employeeId], references: [ldapGuid])

  @@index([avatarFileId])
  @@index([avatarThumbFileId])
  @@map("users")
  @@schema("app")
  formApprovalStepApprovers FormApprovalStepApprover[] @relation("FormApprovalStepApprover")

}

model Role {
  id          Int     @id @default(autoincrement())
  isSystem    Boolean @default(false) @map("is_system")
  rolename    String  @unique
  displayName Json    @map("display_name")
  description Json?

  userAssignments UserRoleRelation[]
  permissions     RolePermissionRelation[]

  @@map("roles")
  @@schema("app")
}

model UserRoleRelation {
  userId       String    @map("user_id") @db.Uuid
  roleId       Int       @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  deactivateAt DateTime? @map("deactivate_at") @db.Timestamptz(6)
  assignedBy   String?   @map("assigned_by") @db.Uuid

  user           User  @relation("UserRoles", fields: [userId], references: [id])
  role           Role  @relation(fields: [roleId], references: [id])
  assignedByUser User? @relation("UserRolesAssignedBy", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_role_relation")
  @@schema("app")
}

model Permission {
  code        String @id
  displayName Json   @map("display_name")
  description Json?

  rolePermissions RolePermissionRelation[]

  @@map("permissions")
  @@schema("app")
}

model RolePermissionRelation {
  roleId         Int    @map("role_id")
  permissionCode String @map("permission_code")
  action         Action
  scope          Scope
  // スコープ対象コード。PLANT: '*'=所属拠点全部 / plants.code 列挙 = 列挙∩所属。
  // REGION: '*'=所属拠点の地域の全拠点 / regions.code 列挙 = その地域の全拠点。
  // ALL/OWN では無視。解決は @ckk/authz-core decide()。
  scopeValues String[] @default(["*"]) @map("scope_values")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, action, permissionCode])
  @@map("role_permission_relation")
  @@schema("app")
}

// ユーザーの所属拠点（多対多）。PLANT/REGION スコープ解決の基盤。
// 管理 UI: /settings/users/[id]（system:ADMIN）。
model UserPlant {
  userId     String   @map("user_id") @db.Uuid
  plantId    Int      @map("plant_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user           User  @relation("UserPlantUser", fields: [userId], references: [id], onDelete: Cascade)
  plant          Plant @relation("PlantUsers", fields: [plantId], references: [id])
  assignedByUser User? @relation("UserPlantAssignedBy", fields: [assignedBy], references: [id])

  @@id([userId, plantId])
  @@index([plantId])
  @@map("user_plants")
  @@schema("app")
}
