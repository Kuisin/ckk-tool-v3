// 外部関係者マスタ — Business Partner (_specs/tables.md §Business Partner Master).
// 1 法人エンティティ + 複数ロール割当（S/4HANA BP モデル準拠）。
// 顧客 (CUSTOMER)・仕入先/外注先 (VENDOR)・需要家 (END_USER) を統合管理し、
// ロール固有属性は bp_customer_attrs / bp_vendor_attrs / bp_end_user_attrs。

enum BpRole {
  CUSTOMER
  VENDOR
  END_USER

  @@map("BP_ROLE")
  @@schema("app")
}

enum VendorType {
  SUPPLIER
  OUTSOURCE

  @@map("VENDOR_TYPE")
  @@schema("app")
}

enum TaxType {
  TAXABLE
  EXEMPT
  REDUCED

  @@map("TAX_TYPE")
  @@schema("app")
}

enum InvoiceMethod {
  EMAIL
  FAX
  POST
  PORTAL

  @@map("INVOICE_METHOD")
  @@schema("app")
}

/// 過不足納品の許容幅をどの尺度で表すか（bp_customer_attrs）。
/// PERCENT = 受注数量に対する割合（%）/ QUANTITY = 絶対数量（受注の単位）。
enum DeliveryToleranceBasis {
  PERCENT
  QUANTITY

  @@map("DELIVERY_TOLERANCE_BASIS")
  @@schema("app")
}

model BusinessPartner {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bpCode      String?  @unique @map("bp_code")
  name        Json
  nameKana    String?  @map("name_kana")
  shortName   String?  @map("short_name")
  parentId    String?  @map("parent_id") @db.Uuid
  countryCode String?  @map("country_code") @db.VarChar(2)
  postalCode  String?  @map("postal_code")
  address     Json?
  phone       String?
  fax         String?
  email       String?
  website     String?
  taxNumber   String?  @map("tax_number")
  /// 書類の言語（見積書/納品書/請求書）。未設定 = 既定言語（ja）。
  /// _specs/i18n-glossary.md §2.7・決定 10 — 閲覧者の表示設定ではなく受取先で決まる。
  documentLocale String? @map("document_locale")
  // AI 抽出（po-extract）が読み取った社名をこの BP に解決するための照合名リスト。
  // 表記ゆれ（全角/半角・㈱/株式会社・旧名など）をすべて登録する。
  matchNames  String[] @default([]) @map("match_names")
  /// フリガナ等から自動生成した照合名（カタカナ/ひらがな/ローマ字）。UI では編集しない。
  matchNamesAuto String[] @default([]) @map("match_names_auto")
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent        BusinessPartner?  @relation("BpParent", fields: [parentId], references: [id])
  branches      BusinessPartner[] @relation("BpParent")
  createdByUser User?             @relation("BpCreatedBy", fields: [createdBy], references: [id])

  roleAssignments BpRoleAssignment[]
  customerAttrs   BpCustomerAttrs?   @relation("CustomerAttrsBp")
  billingTargetOf BpCustomerAttrs[]  @relation("CustomerAttrsBilling")
  vendorAttrs     BpVendorAttrs?
  endUserAttrs    BpEndUserAttrs?
  contacts        BpContact[]
  salesReps       BpSalesRep[]       @relation("BpSalesRepBp")

  // 取引先ポータル（社外向け）
  portalAccounts  PortalAccount[]    @relation("PortalAccountBp")
  portalGrants    PortalGrant[]      @relation("PortalGrantBp")

  estimates        Estimate[]       @relation("EstimateCustomer")
  priceListEntries PriceListEntry[] @relation("PriceListEntryCustomer")
  quotesAsCustomer Quote[]          @relation("QuoteCustomer")
  quotesAsBranch   Quote[]          @relation("QuoteCustomerBranch")

  purchaseOrdersAsSupplier MaterialPurchaseOrder[] @relation("PoSupplier")
  receiptsAsSupplier       MaterialReceipt[]       @relation("ReceiptSupplier")

  orderLinesAsEndUser   OrderLine[]     @relation("OrderLineEndUser")
  deliveryOrdersAsCustomer DeliveryOrder[] @relation("DeliveryOrderCustomer")
  deliveryOrdersAsBranch   DeliveryOrder[] @relation("DeliveryOrderCustomerBranch")
  stepsAsSupplier       WorkOrderStep[] @relation("StepSupplier")
  routeStepsAsSupplier  ProductProcessRouteVersionStep[] @relation("RouteStepSupplier")
  routesAsCustomer      ProductProcessRoute[] @relation("RouteCustomerBp")
  designFilesAsCustomer    DesignFile[]    @relation("DesignFileCustomerBp")
  designRequestsAsCustomer DesignRequest[] @relation("DesignRequestCustomerBp")

  deliveryNotesAsRecipient DeliveryNote[] @relation("DeliveryNoteRecipient")
  deliveryNotesAsBranch    DeliveryNote[] @relation("DeliveryNoteRecipientBranch")
  deliveryNotesAsEndUser   DeliveryNote[] @relation("DeliveryNoteEndUser")

  invoicesAsCustomer Invoice[]        @relation("InvoiceCustomer")
  invoicesAsBranch   Invoice[]        @relation("InvoiceCustomerBranch")
  billingClosings    BillingClosing[] @relation("ClosingCustomer")
  acceptancesAsCustomer OrderAcceptance[] @relation("AcceptanceCustomer")
  acceptancesAsBranch   OrderAcceptance[] @relation("AcceptanceCustomerBranch")
  acceptancesAsShipTo   OrderAcceptance[] @relation("AcceptanceShipTo")
  acceptancesAsEndUser  OrderAcceptance[] @relation("AcceptanceEndUser")

  @@index([parentId])
  // 照合名の配列検索（lib/bp-match）。GIN でないと全表走査になる。
  @@index([matchNamesAuto(ops: ArrayOps)], map: "business_partners_match_names_auto_idx", type: Gin)
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, id])
  @@map("business_partners")
  @@schema("app")
}

model BpRoleAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bpId          String    @map("bp_id") @db.Uuid
  role          BpRole
  isActive      Boolean   @default(true) @map("is_active")
  assignedAt    DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@unique([bpId, role])
  @@map("bp_role_assignments")
  @@schema("app")
}

model BpCustomerAttrs {
  bpId             String        @id @map("bp_id") @db.Uuid
  customerCode     String?       @unique @map("customer_code")
  billingBpId      String?       @map("billing_bp_id") @db.Uuid
  closingDay       Int?          @map("closing_day") @db.SmallInt
  paymentTermsDays Int?          @map("payment_terms_days")
  paymentDay       Int?          @map("payment_day") @db.SmallInt
  creditLimit      Decimal?      @map("credit_limit") @db.Decimal(15, 2)
  /// 旧・課税区分（enum）。tax_category_id と**二重に持っている移行期間中**の列。
  /// 置き換えが全経路で終わるまではこちらも書き続ける（ローリングデプロイ中は
  /// 旧コンテナがこの列しか知らないため）。DROP は移行完了後の別マイグレーションで。
  taxType          TaxType       @default(TAXABLE) @map("tax_type")
  /// 課税区分（tax_categories.id）。**null = 「製品に従う」** —
  /// 製品側 (products.tax_category_id) の区分が使われる。
  /// 値が入っていれば製品より優先する（非課税の取引先に、製品の区分に関わらず
  /// 0% を通すため）。判定の唯一の定義元は nextjs-web の lib/tax-rate.ts
  /// resolveLineTax()。既存行はマイグレーションで tax_type から埋めてあるので、
  /// 移行の時点では誰も「製品に従う」になっていない = 請求額は 1 円も動かない。
  taxCategoryId    Int?          @map("tax_category_id")
  invoiceMethod    InvoiceMethod @default(EMAIL) @map("invoice_method")
  isConsignment    Boolean       @default(false) @map("is_consignment")

  // ── 過不足納品（出荷数量が受注数量と違ってよい範囲）─────────────────────
  //
  // 「どれだけずれてよいか」は顧客が決めることなので顧客属性に置く。指示書側の
  // allow_quantity_variance は**その ロットを過不足のまま出してよいか**の可否で、
  // ここは**どこまでなら許されるか**の幅 — 2 つが揃って初めて過不足出荷になる。
  //
  // 判定の唯一の定義元は lib/delivery-variance-core.ts。列は基準 1 つ + 幅 2 つで、
  // 幅は null = 0（その側の過不足を認めない）。基準を 1 つに絞るのは、% と数量を
  // 同時に持たせると「どちらが効くのか」が読めなくなるため。
  /// 許容幅の尺度（% or 数量）。
  deliveryToleranceBasis  DeliveryToleranceBasis @default(PERCENT) @map("delivery_tolerance_basis")
  /// 不足側の許容幅（受注数量を下回ってよい量）。null = 不足を認めない。
  deliveryToleranceUnder  Decimal? @map("delivery_tolerance_under") @db.Decimal(8, 3)
  /// 超過側の許容幅（受注数量を上回ってよい量）。null = 超過を認めない。
  deliveryToleranceOver   Decimal? @map("delivery_tolerance_over") @db.Decimal(8, 3)
  /// 許容範囲の**内側**の過不足でも承認申請を要求するか（既定 false）。
  varianceApprovalWithin  Boolean @default(false) @map("variance_approval_within")
  /// 許容範囲の**外側**の過不足で承認申請を要求するか（既定 true）。
  /// false にすると範囲外でも素通りする — 範囲を無意味にする設定なので既定にしない。
  varianceApprovalOutside Boolean @default(true) @map("variance_approval_outside")

  notes            String?

  bp          BusinessPartner  @relation("CustomerAttrsBp", fields: [bpId], references: [id])
  billingBp   BusinessPartner? @relation("CustomerAttrsBilling", fields: [billingBpId], references: [id])
  taxCategory TaxCategory?     @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)

  @@index([taxCategoryId])
  @@map("bp_customer_attrs")
  @@schema("app")
}

/// 顧客の営業担当（CKK 側の担当者）。1 顧客に複数登録でき、書類の営業担当は
/// この一覧から選ぶ。`isPrimary` の 1 名が新規書類の既定値（顧客あたり 1 名に
/// 部分 unique index で制限）。CUSTOMER ロール固有の属性なので、ロールを外した
/// 顧客の行は残るが画面には出さない（bp_customer_attrs と同じ扱い）。
model BpSalesRep {
  bpId      String   @map("bp_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bp   BusinessPartner @relation("BpSalesRepBp", fields: [bpId], references: [id], onDelete: Cascade)
  user User            @relation("BpSalesRepUser", fields: [userId], references: [id])

  @@id([bpId, userId])
  @@index([userId])
  @@map("bp_sales_reps")
  @@schema("app")
}

model BpVendorAttrs {
  bpId              String     @id @map("bp_id") @db.Uuid
  vendorCode        String?    @unique @map("vendor_code")
  vendorType        VendorType @map("vendor_type")
  closingDay        Int?       @map("closing_day") @db.SmallInt
  paymentTermsDays  Int?       @map("payment_terms_days")
  paymentDay        Int?       @map("payment_day") @db.SmallInt
  bankName          String?    @map("bank_name")
  bankBranch        String?    @map("bank_branch")
  bankAccountType   String?    @map("bank_account_type")
  bankAccountNumber String?    @map("bank_account_number")
  leadTimeDays      Int?       @map("lead_time_days")
  notes             String?

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@map("bp_vendor_attrs")
  @@schema("app")
}

model BpEndUserAttrs {
  bpId     String  @id @map("bp_id") @db.Uuid
  industry String?
  notes    String?

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  @@map("bp_end_user_attrs")
  @@schema("app")
}

model BpContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bpId       String   @map("bp_id") @db.Uuid
  name       String
  nameKana   String?  @map("name_kana")
  department String?
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bp BusinessPartner @relation(fields: [bpId], references: [id])

  portalAccounts PortalAccount[] @relation("PortalAccountContact")

  @@index([bpId])
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, id])
  @@map("bp_contacts")
  @@schema("app")
}
