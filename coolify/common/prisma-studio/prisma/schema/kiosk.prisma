// キオスク（共有端末）認証 — 拠点フロアの共有タブレット用。
//
// 2 つの独立した信頼:
//   kiosk_devices  = 「この端末は信頼済みキオスク」（登録コードで管理者が有効化、
//                    30日デバイストークン。Cookie はトークン生値、DB はハッシュのみ）
//   kiosk_sessions = 「この人がサインイン中」（QRカード + PIN。8h ハード期限 +
//                    5分アイドル。app.users に解決するので user_permissions /
//                    監査の actor がそのまま使える）
// QRカード（kiosk_cards）は app.users への割当。PIN は初回ログインで必須設定。
// スキャンのみログインは「**その端末で** 48 時間以内の使用実績（kiosk_sessions）
// がある かつ 最後の PIN 検証（pin_last_verified_at）から 2 週間以内」のときのみ
// — 初めて使う端末では必ず PIN、活動が続いても 2 週間ごとに必ず PIN 再入力。
// 端末は拠点（plants）単位で管理し、フロアマップ（kiosk_floor_maps）上に
// map_x/map_y（%座標）でピン配置して所在を可視化する。

enum KioskDeviceStatus {
  PENDING // プロファイル作成済・端末リンク待ち（= オープン。リンク解除で戻る）
  LINKED // 物理端末リンク済・有効化待ち（有効化はこの状態からのみ）
  ACTIVE // 有効
  DISABLED // 一時無効（再有効化可）
  REVOKED // 取り消し（トークン破棄・再リンクが必要）

  @@map("KIOSK_DEVICE_STATUS")
  @@schema("app")
}

enum KioskCardStatus {
  UNASSIGNED // 発行済・未割当
  ASSIGNED // 割当済（ログイン可）
  SUSPENDED // 一時停止
  REVOKED // 取り消し

  @@map("KIOSK_CARD_STATUS")
  @@schema("app")
}

// ─── フロアマップ（拠点ごとの階/エリア。file は任意の図面画像） ────────────────

model KioskFloorMap {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plantId Int     @map("plant_id")
  name      String // 例: 1F 加拠点
  fileId    String? @map("file_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant Plant @relation("KioskFloorMapPlant", fields: [plantId], references: [id])
  file    File?   @relation("KioskFloorMapFile", fields: [fileId], references: [id])
  devices KioskDevice[] @relation("KioskDeviceFloorMap")
  // 端末管理と共用: 保管場所（storage_locations）のピンも同じ図面に配置する
  storageLocations StorageLocation[] @relation("StorageLocationFloorMap")

  @@index([plantId])
  @@map("kiosk_floor_maps")
  @@schema("app")
}

// ─── 端末（共有タブレット） ──────────────────────────────────────────────────

model KioskDevice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 端末名は多言語 JSON { ja, en }（_specs/design.md §17.4）。キオスク UI の
  // zh は ja へフォールバックする（lib/format.ts localized）。
  name     Json?
  location String?
  // 有効化時に管理者が設定（PENDING の間は null）
  plantId Int? @map("plant_id")
  // 既定の作業場所（任意 — 端末の拠点の作業場所グループに属すること）。
  // キオスクの工程 開始/再開 時に実績（work_order_step_actuals）へ複写される。
  // 端末設定画面（設定コード認証）と SY09 の両方から変更できる。
  defaultWorkLocationId Int? @map("default_work_location_id")
  // 作業場所の制限を有効化（端末設定画面のトグル）。ON のとき、工程マスタに
  // 許可作業場所がある工程は、この端末の既定作業場所が許可に含まれる場合のみ
  // 開始/再開できる。既定作業場所の設定自体はトグルと無関係に可能。
  enforceWorkLocation Boolean @default(false) @map("enforce_work_location")
  // フロアマップ上のピン（%座標。null = 未配置）
  floorMapId String?  @map("floor_map_id") @db.Uuid
  mapX       Decimal? @map("map_x") @db.Decimal(5, 2)
  mapY       Decimal? @map("map_y") @db.Decimal(5, 2)

  status KioskDeviceStatus @default(PENDING)

  // 端末設定画面（ヘッダー5タップ）の解錠コード。SY09 の編集モーダルで管理者が
  // 確認・再生成し、フロア担当者に伝える運用。平文保持は仕様（低感度の便宜
  // ゲート — 5回失敗/15分ロックで総当たりは不可。認証はデバイストークンが担う）。
  // dbgenerated の文字列は **PostgreSQL が正規化した後の既定値式** と字面まで
  // 一致させること（一致しないと migrate diff が毎回 SET DEFAULT を出す）。
  settingsCode String @default(dbgenerated("lpad((floor((random() * (1000000)::double precision)))::text, 6, '0'::text)")) @map("settings_code")

  linkedAt DateTime? @map("linked_at") @db.Timestamptz(6)

  // デバイストークン（Cookie は生値、DB は SHA-256 のみ。30日）
  deviceTokenHash      String?   @unique @map("device_token_hash")
  deviceTokenExpiresAt DateTime? @map("device_token_expires_at") @db.Timestamptz(6)

  // 端末アテステーション（Android ラッパーの Keystore 鍵。初回アテストで TOFU 束縛、
  // 管理者の「鍵リセット」で null に戻して再束縛可能）
  devicePublicKey String? @map("device_public_key") // SPKI DER base64 (P-256)
  fingerprint     String? @unique // SHA-256 hex of SPKI DER

  // 参考情報のみ（認証のフォールバックには使わない）。
  // **最後に観測した値**で、リクエストのたびに更新される。リンクした時点の
  // スナップショットは linked_user_agent / linked_ip_address のほう。
  userAgent     String? @map("user_agent")
  lastIpAddress String? @map("last_ip_address")

  // リンク時のスナップショット（kiosk_link_requests から複写した固定値）。
  // 「登録したときの端末」と「いま繋いでいる端末」を並べて見るために分けている。
  linkedUserAgent String? @map("linked_user_agent")
  linkedIpAddress String? @map("linked_ip_address")

  // 所有区分（自動判定。管理者の上書き欄は持たない）。判定は
  // lib/device-ownership-core.ts、根拠は ownership_source に残す。
  ownership       DeviceOwnership @default(UNKNOWN)
  ownershipSource String?         @map("ownership_source") @db.VarChar(40)

  // 署名済み端末プロファイル（Android ラッパー）。アテステーション時に、
  // TOFU 束縛済みの Keystore 鍵で `nonce\nprofileJson` を署名させて受け取る。
  // **payload と署名も残す** — 後から独立に再検証できる証拠にするため
  // （device_profile は検索・表示用の複製）。
  //
  // 改竄耐性の根拠は鍵が非エクスポートであること。逆に言えば、root 化端末が
  // 「本物の鍵で嘘の値に署名する」ことは防げない。そこを塞ぐのはハードウェア
  // 鍵アテステーションだけで、既存の TOFU 束縛を壊すため今回は採っていない。
  deviceProfile        Json?     @map("device_profile")
  deviceProfilePayload String?   @map("device_profile_payload")
  deviceProfileSig     String?   @map("device_profile_sig")
  deviceProfileAt      DateTime? @map("device_profile_at") @db.Timestamptz(6)

  activatedById  String?   @map("activated_by") @db.Uuid
  activatedAt    DateTime? @map("activated_at") @db.Timestamptz(6)
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant     Plant?       @relation("KioskDevicePlant", fields: [plantId], references: [id])
  defaultWorkLocation WorkLocation? @relation("KioskDeviceDefaultWorkLocation", fields: [defaultWorkLocationId], references: [id])
  floorMap    KioskFloorMap? @relation("KioskDeviceFloorMap", fields: [floorMapId], references: [id])
  activatedBy User?          @relation("KioskDeviceActivatedBy", fields: [activatedById], references: [id])
  sessions    KioskSession[] @relation("KioskSessionDevice")
  linkRequests KioskLinkRequest[] @relation("KioskLinkRequestDevice")
  logs        KioskDeviceLog[] @relation("KioskDeviceLogDevice")
  locations   KioskDeviceLocation[] @relation("KioskDeviceLocationDevice")
  auditLogs   AuditLog[]            @relation("AuditLogKioskDevice")
  loginAttempts LoginAttempt[]      @relation("LoginAttemptDevice")

  @@index([plantId])
  @@index([status])
  @@map("kiosk_devices")
  @@schema("app")
}

// ─── 端末位置ログ（GPS。端末が 5 分ごとに報告 — SY09 は最新 1 件を表示） ───
// 保持期間は pg_cron の kiosk_location_retention で 90 日（kiosk-cron.sql）。

model KioskDeviceLocation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  /** 位置精度（メートル。geolocation API の accuracy） */
  accuracyM  Decimal? @map("accuracy_m") @db.Decimal(8, 1)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  device KioskDevice @relation("KioskDeviceLocationDevice", fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt(sort: Desc)])
  @@map("kiosk_device_locations")
  @@schema("app")
}

// ─── QRカード（従業員に割当。id = Crockford 16桁 = QR ペイロードの secret） ───

model KioskCard {
  id     String          @id
  userId String?         @map("user_id") @db.Uuid
  status KioskCardStatus @default(UNASSIGNED)

  // PIN（scrypt salt:hash hex — nextjs-web src/lib/password.ts と同形式）
  pinHash           String?   @map("pin_hash")
  pinSetAt          DateTime? @map("pin_set_at") @db.Timestamptz(6)
  pinFailedAttempts Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil    DateTime? @map("pin_locked_until") @db.Timestamptz(6)
  pinLastVerifiedAt DateTime? @map("pin_last_verified_at") @db.Timestamptz(6)

  // 3日ルールの基準（スキャンのみログイン可否）。ログイン成功ごとに更新
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  useCount   Int       @default(0) @map("use_count")

  // 同時ログイン上限（このカードで同時に維持できるセッション数）。超過分は
  // ログイン時に最終活動が最も古いセッションから失効させる（= 最も古い端末を
  // ログアウト）— キオスク側 kiosk-auth.createSession が enforce する
  maxActiveSessions Int @default(1) @map("max_active_sessions")

  // 有効期間（テンポラリカード用。null = 無期限）。期間外はログイン不可 —
  // 判定はキオスク側 kiosk-auth-core.isCardWithinValidPeriod（ログイン時のみ。
  // 既存セッションは 8h ハード期限 / 5分アイドルで自然失効）
  validFrom  DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)

  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz(6)
  assignedById String?   @map("assigned_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById  String?   @map("revoked_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User? @relation("KioskCardUser", fields: [userId], references: [id])
  assignedBy User? @relation("KioskCardAssignedBy", fields: [assignedById], references: [id])
  revokedBy  User? @relation("KioskCardRevokedBy", fields: [revokedById], references: [id])
  sessions   KioskSession[] @relation("KioskSessionCard")
  // 実在したカードでの試行のみ紐づく（未知・偽造カードは card_ref だけ残る）
  loginAttempts LoginAttempt[] @relation("LoginAttemptCard")

  // 「ASSIGNED は 1 ユーザー 1 枚」は migration の手書き部分 partial unique index
  // (user_id WHERE status = 'ASSIGNED') で担保 — Prisma では表現不可。
  @@index([userId])
  @@map("kiosk_cards")
  @@schema("app")
}

// ─── 人のセッション（id = セッショントークンの SHA-256 hex） ─────────────────

model KioskSession {
  id             String    @id
  userId         String    @map("user_id") @db.Uuid
  cardId         String    @map("card_id")
  deviceId       String    @map("device_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6) // 8h ハード期限
  lastActivityAt DateTime  @map("last_activity_at") @db.Timestamptz(6) // 5分アイドル窓
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user   User        @relation("KioskSessionUser", fields: [userId], references: [id])
  card   KioskCard   @relation("KioskSessionCard", fields: [cardId], references: [id])
  device KioskDevice @relation("KioskSessionDevice", fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("kiosk_sessions")
  @@schema("app")
}

// ─── 端末利用ログ（プレゼンス遷移 + ログイン/ログアウト履歴） ─────────────────
//
// 書き込み元:
//   ONLINE/OFFLINE — kiosk の WS サーバー（ws-db.ts の冪等 guarded insert のみ。
//                    ハートビート行は書かない — 遷移時だけ 1 行）+ pg_cron の
//                    バックストップ（kiosk アプリ全停止時のオフライン検知。
//                    shared-db/sql/kiosk-cron.sql）
//   LOGIN/LOGOUT   — kiosk の createSession/destroySession/getSession（暗黙失効）、
//                    nextjs-web の unlinkDevice/revokeDevice（管理者失効）、
//                    pg_cron の stale セッション掃除
// SY09 の「利用履歴」モーダルが表示する。

enum KioskDeviceLogType {
  ONLINE
  OFFLINE
  LOGIN
  LOGOUT

  @@map("KIOSK_DEVICE_LOG_TYPE")
  @@schema("app")
}

model KioskDeviceLog {
  id        BigInt             @id @default(autoincrement())
  deviceId  String             @map("device_id") @db.Uuid
  type      KioskDeviceLogType
  userId    String?            @map("user_id") @db.Uuid // LOGIN/LOGOUT のみ
  source    String? // "ws" | "sweep" | "pg_cron" | "login" | "logout" | "expired" | "displaced" | "admin"
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  device KioskDevice @relation("KioskDeviceLogDevice", fields: [deviceId], references: [id], onDelete: Cascade)
  user   User?       @relation("KioskDeviceLogUser", fields: [userId], references: [id])

  @@index([deviceId, createdAt])
  @@index([createdAt])
  @@map("kiosk_device_logs")
  @@schema("app")
}

// ─── リンクリクエスト（タブレット側が生成する QR/コード） ─────────────────────
//
// タブレットの /setup が発行（10分期限）。管理者が SY09 でコードを入力 or
// QR をスキャンし、**オープン（PENDING）なプロファイルにのみ**リンクできる。
// リンク成立で device_id が入り、タブレットのポーリングがそれを検知する。

model KioskLinkRequest {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique // Crockford 12桁
  deviceId      String?  @map("device_id") @db.Uuid // リンク先プロファイル（成立後）
  userAgent     String?  @map("user_agent")
  lastIpAddress String?  @map("last_ip_address")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6) // 10分

  device KioskDevice? @relation("KioskLinkRequestDevice", fields: [deviceId], references: [id])

  @@index([expiresAt])
  @@map("kiosk_link_requests")
  @@schema("app")
}

// ─── メンテナンス退出 PIN の履歴 ──────────────────────────────────────────────
//
// 現行値は system_settings['kiosk.unlock_pin'] の 1 行で、pg_cron が毎日 4:00 に
// **上書き**する（kiosk-cron.sql）。上書きなので旧値はどこにも残らなかった。
//
// それが困るのは、端末が PIN を**ローカルに持っている**から（PinSync →
// SharedPreferences）。オフラインの端末が受け付けるのは「最後に同期できた時点の
// 値」であって現行値ではない。回線が切れた端末を開けたいとき、必要なのは
// まさに上書きされて消えた値になる。ここはその 1 行を残すためだけの表。
//
// 「いつの PIN か」を引くための表なので rotated_at（有効になった時刻）だけ持ち、
// 有効期間の終わりは次の行の rotated_at から導く（更新が要らない = cron の
// INSERT 1 本で済む）。
//
// 保持期間は 400 日 — login_attempts の失敗行と同じ既定に合わせる。行は 1 日 1 本
// なので容量は問題にならず、長く持つことの危険も小さい（旧 PIN で開けられるのは
// 「その値のまま止まっているオフライン端末」だけで、DB を読める相手は現行値も
// 読める）。刈り取りは同じ pg_cron ジョブが行う。
//
// 参照は SY09 端末詳細（kiosk 権限 = 管理者のみ）。表示は監査ログに残る。

model KioskUnlockPin {
  id        BigInt   @id @default(autoincrement())
  pin       String   @db.VarChar(8)
  // この PIN が有効になった時刻。有効期間の終わり = 次の行の rotatedAt
  rotatedAt DateTime @default(now()) @map("rotated_at") @db.Timestamptz(6)
  source    String   @default("pg_cron") @db.VarChar(16) // "pg_cron" | "migration"

  @@index([rotatedAt])
  @@map("kiosk_unlock_pins")
  @@schema("app")
}
