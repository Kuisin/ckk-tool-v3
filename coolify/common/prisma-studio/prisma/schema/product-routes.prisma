// 工程ルート（工程リスト）— バージョンは不変スナップショット（作成のみ・
// 編集不可）で、指示書作成時にルートを選んで工程構成をプリフィルし、変更した
// 場合は常に新バージョンとして保存される。最新 = max(version)（is_latest 列は
// 持たない）。
//
// **2 種類ある**（kind）。指示書の工程は 準備 + 製造 の 2 本を合わせたもの:
//   PREP           準備工程リスト — 〇〇出し・受渡し と 材料準備（切断・センタレス・
//                  全長合わせ・C面）。**製品にも顧客にも紐づかない**（共通）。
//                  素材をどう仕立てるかは製品ごとに変わらないので、製品ごとに
//                  同じ並びを何百回も持たせない。
//   MANUFACTURING  製造工程リスト — 加工・コーティング・検査・承認。製品 ×
//                  受注元ごと（従来の工程リストそのもの）。
// どの工程がどちらに属するかは nextjs-web lib/workflow-core.ts の isPrepStep が
// 唯一の定義（カタログの category = MATERIAL_PREP）。
// kind ごとの列の必須/禁止は DB の CHECK が守る（Prisma には書けない）。
//
// 移行前のルートは MANUFACTURING で、バージョンの中に準備工程が混ざったまま
// 残る（消さない — 使用済みの指示書がそれを指している）。指示書ビルダーは
// そういう版を読んだとき準備側を版から拾い、新しく保存する版からは準備工程を
// 外す（lib/product-routes.ts resolveRouteVersionTx）。

/// 工程リストの種別。
enum ProcessRouteKind {
  PREP
  MANUFACTURING

  @@map("PROCESS_ROUTE_KIND")
  @@schema("app")
}

model ProductProcessRoute {
  id           Int      @id @default(autoincrement())
  kind         ProcessRouteKind @default(MANUFACTURING)
  // PREP は null（共通）。MANUFACTURING は必須 — CHECK product_process_routes_kind_columns。
  productId    Int?     @map("product_id")
  // 対象の受注元（取引先）。null = 汎用（どの顧客にも使える）。PREP は常に null。
  // 指示書ビルダーは顧客一致ルートを優先し、無ければ汎用へフォールバックする
  // （選択規則は nextjs-web lib/product-routes-core.ts pickDefaultRoute）。
  customerBpId String?  @map("customer_bp_id") @db.Uuid
  name         Json // { ja, en }
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 任意になっても製品は消させない — Prisma の任意リレーションの既定 SetNull だと、
  // 製品を消したとき製造工程リストが製品を失って CHECK（MANUFACTURING は product_id
  // 必須）に落ちる。従来どおり Restrict（DB 側もこのまま）。
  product       Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerBp    BusinessPartner? @relation("RouteCustomerBp", fields: [customerBpId], references: [id])
  createdByUser User?            @relation("RouteCreatedBy", fields: [createdBy], references: [id])

  versions ProductProcessRouteVersion[]

  @@index([productId, customerBpId])
  @@index([kind])
  @@map("product_process_routes")
  @@schema("app")
}

model ProductProcessRouteVersion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId   Int      @map("route_id")
  version   Int // 1 始まりの連番（route 内 unique）
  notes     String? // 変更メモ（指示書からの自動保存時は "#<指示書番号> 作成時に変更" 等）
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  route         ProductProcessRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdByUser User?               @relation("RouteVersionCreatedBy", fields: [createdBy], references: [id])

  steps      ProductProcessRouteVersionStep[]
  workOrders WorkOrder[]
  // この版を準備工程リストとして使った指示書（PREP の版だけが持つ）
  prepWorkOrders WorkOrder[] @relation("WorkOrderPrepRoute")

  @@unique([routeId, version])
  @@map("product_process_route_versions")
  @@schema("app")
}

// バージョンの工程スナップショット — 指示書ビルダーが採取する項目のミラー。
// DAG（分岐・合流）はテンプレート化しない（実行時 addBranchSeries のみ）。
model ProductProcessRouteVersionStep {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeVersionId    String        @map("route_version_id") @db.Uuid
  processStepId     Int           @map("process_step_id")
  sortOrder         Int           @map("sort_order")
  executionLocation StepExecution @map("execution_location")
  plantId         Int?          @map("plant_id")
  supplierBpId      String?       @map("supplier_bp_id") @db.Uuid
  workHours         Decimal?      @map("work_hours") @db.Decimal(6, 2) // 標準作業時間 (h) — 任意
  lotInputMode      LotInputMode? @map("lot_input_mode") // 実行時のロット入力（null = 工程マスタの既定を継承）

  routeVersion ProductProcessRouteVersion @relation(fields: [routeVersionId], references: [id], onDelete: Cascade)
  processStep  ProcessStepCatalog         @relation(fields: [processStepId], references: [id])
  plant      Plant?                   @relation("RouteStepPlant", fields: [plantId], references: [id])
  supplierBp   BusinessPartner?           @relation("RouteStepSupplier", fields: [supplierBpId], references: [id])

  @@unique([routeVersionId, processStepId])
  @@index([routeVersionId, sortOrder])
  @@map("product_process_route_version_steps")
  @@schema("app")
}
