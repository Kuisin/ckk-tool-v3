// 生産 (_specs/tables.md §Logic §3〜§7): 指示書 / 工程ステップ / 分岐合流。
//
// キー方針:
//   - 受注の単位は order_lines（注文明細, intake.prisma）。旧 sales_orders
//     （注文請書）はそこへ統合済みで、このファイルには存在しない。
//   - work_orders: uuid PK + work_order_number（通し連番 int, unique）。
//     ロット番号 = 指示書番号（共用, numbering_sequences の SERIAL）。
//   - 承認は approval_status + 遷移列 + history Json（MaterialPurchaseOrder と
//     同型の row-workflow。§6 本実装時に approval_requests/records へ拡張）。

enum WorkOrderType {
  FROM_STOCK // 在庫分（§4 → §8 直行）
  MANUFACTURE // 製造分（§5→§6→§7）

  @@map("WORK_ORDER_TYPE")
  @@schema("app")
}

enum WorkOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("WORK_ORDER_STATUS")
  @@schema("app")
}

// 段数非依存 — 何段目まで進んでいるかは approval_requests.step_no が持つ。
enum WorkOrderApprovalStatus {
  NONE
  PENDING // 承認フロー進行中
  APPROVED
  REJECTED

  @@map("WORK_ORDER_APPROVAL_STATUS")
  @@schema("app")
}

enum StepExecution {
  INTERNAL
  OUTSOURCE

  @@map("STEP_EXECUTION")
  @@schema("app")
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("STEP_STATUS")
  @@schema("app")
}

/// 分岐系列の終端で良品を入れる在庫（§7）。合流する分岐では使わない。
enum BranchStockDisposition {
  /// 半製品在庫へ（再投入待ちの中間品）
  SEMI_FINISHED
  /// 製品在庫へ（ロット付きの完成品として）
  PRODUCT

  @@map("BRANCH_STOCK_DISPOSITION")
  @@schema("app")
}

// 指示書（§3〜§7）— 通し連番。ロット番号と共用。
// 注文明細との紐付けは work_order_order_lines（m:n の割当）— 1 指示書が
// 複数明細を束ねる（統合ロット）ことも、1 明細を複数指示書に分ける（分割）
// こともできる。割当ゼロ = 在庫向けの独立指示書（type は MANUFACTURE のみ。
// 顧客注文分は常に割当を持つ）。product_id は常に保持
// （明細配下は明細の製品から複写、独立指示書は直接指定）。
model WorkOrder {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // ロット番号 = 通し連番（在庫・QR・業務キーはこちら。不変）
  workOrderNumber Int     @unique @map("work_order_number")
  // 書類番号 WO-YYYYMM-NNNNN（月次リセット — 他書類と同形式。表示用の識別子）
  yearMonth       String  @map("year_month") @db.Char(6)
  seq             Int
  productId       Int     @map("product_id")
  type            WorkOrderType
  plannedQuantity Int     @map("planned_quantity")
  materialId      Int?    @map("material_id")
  // 完成品の保管場所（保管場所マスタ MS0E。null = 未指定）
  storageLocationId Int? @map("storage_location_id")

  status         WorkOrderStatus         @default(DRAFT)
  approvalStatus WorkOrderApprovalStatus @default(NONE) @map("approval_status")

  // コピー元（バージョン警告用）
  sourceWorkOrderId String? @map("source_work_order_id") @db.Uuid

  // 工程ルート出所（製品工程リストのバージョン）。ルート削除時は SetNull —
  // 工程は work_order_steps に実体化済みで、出所リンクだけが外れる。
  routeVersionId String? @map("route_version_id") @db.Uuid

  // 使用する図面の版（**任意**）。null = 固定しない → 表示のたびに製品の
  // 最新図面（受注元が一致する系列 → 無ければ汎用）を引く。
  // 指定すると版がその指示書に固定され、あとから改訂されても現場が見る図面は
  // 変わらない。ピン留めされた版は編集・削除できなくなる（作った物の根拠を
  // あとから書き換えさせない）。
  designFileId   String? @map("design_file_id") @db.Uuid

  // 承認遷移（MaterialPurchaseOrder と同型の row-workflow）。
  // 段ごとの日時・承認者は approval_requests / approval_records が持つ。
  requestedAt  DateTime? @map("requested_at") @db.Timestamptz(6)
  requestedBy  String?   @map("requested_by") @db.Uuid
  rejectedAt   DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy   String?   @map("rejected_by") @db.Uuid
  rejectReason String?   @map("reject_reason")
  history      Json? // 状態遷移履歴 [{ action, user, at, notes }]

  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy  String?   @map("approved_by") @db.Uuid
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  notes       String?
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product         Product     @relation(fields: [productId], references: [id])
  designFile      DesignFile? @relation("WorkOrderDesignFile", fields: [designFileId], references: [id])
  material        Material?   @relation(fields: [materialId], references: [id])
  storageLocation StorageLocation? @relation("WorkOrderStorageLocation", fields: [storageLocationId], references: [id])
  sourceWorkOrder WorkOrder? @relation("WorkOrderCopySource", fields: [sourceWorkOrderId], references: [id])
  copies          WorkOrder[] @relation("WorkOrderCopySource")
  routeVersion    ProductProcessRouteVersion? @relation(fields: [routeVersionId], references: [id], onDelete: SetNull)
  createdByUser   User?      @relation("WorkOrderCreatedBy", fields: [createdBy], references: [id])

  orderLineLinks      WorkOrderOrderLine[]
  steps               WorkOrderStep[]
  stepLinks           WorkOrderStepLink[]
  flowChanges         WorkOrderFlowChange[]
  deliveryOrders      DeliveryOrder[]
  reservations        InventoryReservation[]

  outgoingWoLinks WorkOrderLink[] @relation("WoLinkSource")
  incomingWoLinks WorkOrderLink[] @relation("WoLinkTarget")

  @@unique([yearMonth, seq])
  @@index([productId])
  @@index([status])
  @@index([approvalStatus])
  @@index([routeVersionId])
  @@index([storageLocationId])
  @@map("work_orders")
  @@schema("app")
}

// 指示書 → 指示書 の数量受け渡しリンク（例: リブ母材の指示書 → 製品の指示書）。
// source の完成数が target の受入数として渡る。target の先頭メインライン工程は
// source が COMPLETED になるまで開始できない（canStartStep — workflow-core）。
// quantity = null は「完了時の完成数全量」。在庫計上は従来どおり両指示書で行う
// （リンクはゲート + 受入既定値 + 表示のみ — 母材と製品は別品目なので二重計上に
// ならない）。閉路の禁止は lib/work-order-links-core.ts wouldCreateCycle が
// 唯一の判定元（サーバー tx 内で検証）。
model WorkOrderLink {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceWorkOrderId String   @map("source_work_order_id") @db.Uuid
  targetWorkOrderId String   @map("target_work_order_id") @db.Uuid
  // 渡す数量。null = source 完了時の完成数全量
  quantity          Int?
  notes             String?
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceWorkOrder WorkOrder @relation("WoLinkSource", fields: [sourceWorkOrderId], references: [id], onDelete: Cascade)
  targetWorkOrder WorkOrder @relation("WoLinkTarget", fields: [targetWorkOrderId], references: [id], onDelete: Cascade)
  createdByUser   User?     @relation("WoLinkCreatedBy", fields: [createdBy], references: [id])

  @@unique([sourceWorkOrderId, targetWorkOrderId])
  @@index([targetWorkOrderId])
  @@map("work_order_links")
  @@schema("app")
}

// 指示書 ↔ 注文明細 の割当（m:n）。
//   分割: 1 明細を複数指示書に分けて手配する（部分手配可）。
//   統合: 同一製品の複数明細を 1 指示書（1 ロット）で作る。
// quantity = この指示書がこの明細のために充当する数量。
// 不変条件（アプリ側 lib/work-order-alloc-core.ts が唯一の判定元）:
//   - 明細ごと: Σ quantity（キャンセル済み指示書を除く）≤ order_lines.quantity
//   - 指示書ごと: planned_quantity ≥ Σ quantity（不良予備分の上乗せは自由）
//   - 割当明細の製品 = 指示書の product_id
//   - FROM_STOCK は割当 1 件のみ（在庫引当の消費先が一意である必要）
model WorkOrderOrderLine {
  workOrderId String @map("work_order_id") @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid
  quantity    Int
  sortOrder   Int    @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@id([workOrderId, orderLineId])
  @@index([orderLineId])
  @@map("work_order_order_lines")
  @@schema("app")
}

// 承認されるまで適用しない工程フロー変更（§6 / §7）。
//
// 承認済み・進行中の指示書で分岐を足す/直す/消す操作は、承認設定（MS0B）で
// 「工程フロー変更」のフローが 1 段でも設定されていれば、この行として保留され
// 最終承認で初めて適用される。1 段も無ければ行は作られず即適用（素通し）。
//
// 承認依頼は業務キー文字列（= id）で指すため FK は無い → 削除時の掃除は
// AFTER DELETE トリガー purge_children_after_delete が行う
// （migration 20260917090000）。
model WorkOrderFlowChange {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  /// ADD_BRANCH | UPDATE_BRANCH | REMOVE_BRANCH（DB 側 CHECK）
  kind        String
  /// 操作の入力そのもの。適用時にサーバーで再検証する。
  payload     Json
  /// PENDING | APPLIED | REJECTED | CANCELLED | FAILED（DB 側 CHECK）
  status      String   @default("PENDING")
  /// 適用に失敗した理由（数量が足りなくなった等）。承認後に出る。
  error       String?
  /// 事後承認（apply_mode = POST）で即時適用した日時。
  /// REJECTED + applied_at あり + 未 ack = 「差し戻されたが適用済み」の警告対象。
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz(6)
  /// 上の警告を確認済みにした操作（人が手で直したことの記録）。
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  requestedBy String?  @map("requested_by") @db.Uuid
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedBy  String?  @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  requestedByUser User?     @relation("FlowChangeRequestedBy", fields: [requestedBy], references: [id])
  resolvedByUser  User?     @relation("FlowChangeResolvedBy", fields: [resolvedBy], references: [id])
  acknowledgedByUser User?  @relation("FlowChangeAcknowledgedBy", fields: [acknowledgedBy], references: [id])

  @@index([workOrderId, status])
  @@map("work_order_flow_changes")
  @@schema("app")
}

// 検査工程ステップに紐付く検査表テンプレート（複数可）。
// 旧: 指示書単位（work_order_inspection_templates）— 検査工程が複数ある
// 指示書でどの検査表がどの工程のものか曖昧だったため、工程単位へ移行した。
model WorkOrderStepInspectionTemplate {
  stepId               String @map("work_order_step_id") @db.Uuid
  inspectionTemplateId Int    @map("inspection_template_id")

  step               WorkOrderStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  inspectionTemplate InspectionTemplate @relation(fields: [inspectionTemplateId], references: [id])

  @@id([stepId, inspectionTemplateId])
  @@map("work_order_step_inspection_templates")
  @@schema("app")
}

// 指示書工程ステップ（§7）。数量伝播・不良振り分け・外注管理・セッションロック。
model WorkOrderStep {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId   String        @map("work_order_id") @db.Uuid
  processStepId Int           @map("process_step_id")
  sortOrder     Int           @map("sort_order") // テンプレート順（参考。実行は依存解決）
  executionLocation StepExecution @map("execution_location")
  plantId     Int?          @map("plant_id") // 社内実行時の拠点
  supplierBpId  String?       @map("supplier_bp_id") @db.Uuid // 外注時
  plannedWorkHours Decimal?   @map("planned_work_hours") @db.Decimal(6, 2) // 予定作業時間 (h) — 任意
  lotInputMode  LotInputMode? @map("lot_input_mode") // 実行時のロット入力（null = 工程マスタの既定を継承）
  lotText       String?       @map("lot_text") // 素材ロット・伝票コード等（開始時に記録）

  outsourceRequestedAt DateTime? @map("outsource_requested_at") @db.Date
  outsourceExpectedAt  DateTime? @map("outsource_expected_at") @db.Date
  outsourceReceivedAt  DateTime? @map("outsource_received_at") @db.Date
  // 外注コスト（監査 P2-6 — 円。試算実績・原価分析の入力）
  outsourceCost        Decimal?  @map("outsource_cost") @db.Decimal(12, 2)

  status StepStatus @default(PENDING)

  // 工程間の数量受け渡し・不良振り分け（§7 数量整合: success+不良 = input）
  inputQuantity            Int? @map("input_quantity")
  outputSuccessQuantity    Int? @map("output_success_quantity")
  outputDefectSemiFinished Int? @map("output_defect_semi_finished") // 半製品在庫へ
  outputDefectScrap        Int? @map("output_defect_scrap") // 廃棄
  outputDefectRework       Int? @map("output_defect_rework") // 手直し分岐へ
  // 不良理由の内訳（キオスク完了時の補助記録・区分とは別軸）。
  // 形: [{ reason: string, count: int }]（理由=不良種類名など・count=本数）。
  // 在庫連携には使わない（区分 semi/scrap/rework が数量の権威）。
  defectReasons Json? @map("defect_reasons")

  // 分岐系列の終端処理（§7 分岐は必ず「合流」か「在庫」で終わる）。
  // null = 合流する（終端から本流へのリンクが張られている）か、そもそも
  // 分岐系列の工程ではない。値が入っていればここで系列が終わり、この工程の
  // 良品数が指定の在庫へ入る（onWorkOrderCompleted が入庫する）。
  branchStockDisposition BranchStockDisposition? @map("branch_stock_disposition")

  sessionLockedBy String?   @map("session_locked_by") @db.Uuid
  sessionLockedAt DateTime? @map("session_locked_at") @db.Timestamptz(6)

  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  startedBy    String?   @map("started_by") @db.Uuid
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy  String?   @map("completed_by") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason")
  notes        String?

  workOrder   WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  processStep ProcessStepCatalog @relation(fields: [processStepId], references: [id])
  plant     Plant?           @relation(fields: [plantId], references: [id])
  supplierBp  BusinessPartner?   @relation("StepSupplier", fields: [supplierBpId], references: [id])

  outgoingLinks WorkOrderStepLink[] @relation("LinkSource")
  incomingLinks WorkOrderStepLink[] @relation("LinkTarget")

  inspectionRecords   InspectionRecord[]
  defectRecords       DefectRecord[]
  plans               WorkOrderStepPlan[]
  actuals             WorkOrderStepActual[]
  inspectionTemplates WorkOrderStepInspectionTemplate[]

  @@index([workOrderId, sortOrder])
  @@index([status])
  @@map("work_order_steps")
  @@schema("app")
}

// 工程の作業計画（1 工程に複数行 = 分割計画）。担当者必須。
// 日付のみ、または開始/終了時刻付きで設定できる（§7 計画/実績）。
model WorkOrderStepPlan {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stepId         String    @map("work_order_step_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid // 担当者（従業員）
  plannedDate    DateTime  @map("planned_date") @db.Date
  plannedStartAt DateTime? @map("planned_start_at") @db.Timestamptz(6)
  plannedEndAt   DateTime? @map("planned_end_at") @db.Timestamptz(6)
  quantity       Int? // 分割時の割当数量（任意）
  workLocationId Int?      @map("work_location_id") // 作業場所（機械/エリア — 任意）
  notes          String?
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  step          WorkOrderStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user          User          @relation("StepPlanUser", fields: [userId], references: [id])
  createdByUser User?         @relation("StepPlanCreatedBy", fields: [createdBy], references: [id])
  workLocation  WorkLocation? @relation("StepPlanWorkLocation", fields: [workLocationId], references: [id])

  @@index([stepId, plannedDate])
  @@index([userId, plannedDate])
  @@map("work_order_step_plans")
  @@schema("app")
}

// 工程の作業実績（1 工程に複数行 = 分割実績）。担当者必須。
model WorkOrderStepActual {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stepId     String    @map("work_order_step_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid // 作業者（従業員）
  workedDate DateTime  @map("worked_date") @db.Date
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)
  quantity   Int? // 実施数量（任意）
  workLocationId Int? @map("work_location_id") // 作業場所（任意。キオスクは端末の既定作業場所を書き込む）
  // このセグメント中に同じ作業者が同時に開いていた工程数。実働時間は
  // duration / concurrent_count で按分する。同時数が変わる瞬間に行を閉じて
  // 張り直す（1 行 = 一定の同時数のセグメント — kiosk resegmentOpenActuals）。
  concurrentCount Int @default(1) @map("concurrent_count")
  notes      String?
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  step          WorkOrderStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user          User          @relation("StepActualUser", fields: [userId], references: [id])
  createdByUser User?         @relation("StepActualCreatedBy", fields: [createdBy], references: [id])
  workLocation  WorkLocation? @relation("StepActualWorkLocation", fields: [workLocationId], references: [id])

  @@index([stepId, workedDate])
  @@index([userId, workedDate])
  @@map("work_order_step_actuals")
  @@schema("app")
}

// 工程ステップの分岐・合流（指示書内 DAG, §7）。手直し分岐・半製品再投入・
// ロット分割合流を routed_quantity 付きのエッジで表す。
model WorkOrderStepLink {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId    String   @map("work_order_id") @db.Uuid
  sourceStepId   String   @map("source_step_id") @db.Uuid
  targetStepId   String   @map("target_step_id") @db.Uuid
  routedQuantity Int      @default(0) @map("routed_quantity")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder  WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sourceStep WorkOrderStep @relation("LinkSource", fields: [sourceStepId], references: [id], onDelete: Cascade)
  targetStep WorkOrderStep @relation("LinkTarget", fields: [targetStepId], references: [id], onDelete: Cascade)

  @@unique([sourceStepId, targetStepId])
  @@map("work_order_step_links")
  @@schema("app")
}

// ─── 検査記録・不良記録（§7, PR 3） ─────────────────────────────────────────

enum InspectionStatus {
  PENDING
  PASS
  FAIL
  APPROVED

  @@map("INSPECTION_STATUS")
  @@schema("app")
}

model InspectionRecord {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderStepId String           @map("work_order_step_id") @db.Uuid
  templateId      Int              @map("template_id")
  status          InspectionStatus @default(PENDING)
  recordedBy      String?          @map("recorded_by") @db.Uuid
  approvedBy      String?          @map("approved_by") @db.Uuid
  recordedAt      DateTime?        @map("recorded_at") @db.Timestamptz(6)
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(6)
  notes           String?

  step     WorkOrderStep      @relation(fields: [workOrderStepId], references: [id], onDelete: Cascade)
  template InspectionTemplate @relation("InspectionRecordTemplate", fields: [templateId], references: [id])
  items    InspectionRecordItem[]

  @@index([workOrderStepId])
  @@map("inspection_records")
  @@schema("app")
}

model InspectionRecordItem {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionRecordId String  @map("inspection_record_id") @db.Uuid
  templateItemId     Int     @map("template_item_id")
  measuredValue      String? @map("measured_value") // 旧記録の表示用（新規は measured_values）
  measuredValues     Json?   @map("measured_values") // サンプルごとの実測値配列（型は inputType に依存）
  inspectedCount     Int?    @map("inspected_count") // 記録方式 COUNTS: 検査数
  passedCount        Int?    @map("passed_count") // 記録方式 COUNTS: 合格数
  isPass             Boolean? @map("is_pass")
  notes              String?

  record       InspectionRecord       @relation(fields: [inspectionRecordId], references: [id], onDelete: Cascade)
  templateItem InspectionTemplateItem @relation("InspectionRecordItemTemplate", fields: [templateItemId], references: [id])

  @@index([inspectionRecordId])
  @@map("inspection_record_items")
  @@schema("app")
}

// 不良記録（各工程ステップで任意記録）
model DefectRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderStepId String   @map("work_order_step_id") @db.Uuid
  defectTypeId    Int      @map("defect_type_id")
  description     String
  recordedBy      String?  @map("recorded_by") @db.Uuid
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  step       WorkOrderStep @relation(fields: [workOrderStepId], references: [id], onDelete: Cascade)
  defectType DefectType    @relation("DefectRecordType", fields: [defectTypeId], references: [id])

  @@index([workOrderStepId])
  @@map("defect_records")
  @@schema("app")
}
