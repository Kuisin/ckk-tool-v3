# vpn-ldap の AD 接続情報の雛形。
#
# **このファイルの実体は git に入れない。** 値は Coolify の `vpn-ldap` アプリの
# env として設定する（ボリュームには置けない — compose の env_file はホスト側の
# パスを解析時に読む仕組みで、コンテナのボリュームからは読めないため）。
#
# 移行前は ~/stacks/vpn-ldap/ldap.env にあった。値はそこから移すこと。

# 表示用ラベル（ログに出る程度）
LDAP_SERVER_LABEL=
# AD サーバー（VPN 越しのアドレス）
LDAP_SERVER_HOST=
LDAP_SERVER_PORT=389
# バインド用アカウントの DN とパスワード
LDAP_APP_DN=
LDAP_APP_PASSWORD=
# 検索の起点
LDAP_SEARCH_BASE=
# 属性マッピング
LDAP_ATTRIBUTE_FOR_USERNAME=sAMAccountName
LDAP_ATTRIBUTE_FOR_MAIL=mail
# VPN 内の平文 LDAP を使う場合は false
LDAP_USE_TLS=false
