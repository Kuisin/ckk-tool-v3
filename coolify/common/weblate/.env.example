# weblate/.env — **サーバーにだけ置く**（リポジトリにはコミットしない）。
# 実体は ~/stacks/weblate/.env。deploy-stack.sh は .env を必ず除外する。

# Postgres（このスタック内だけで使う）
WEBLATE_DB_PASS=

# 管理者（初回起動時に作られる）
WEBLATE_ADMIN_NAME=admin
WEBLATE_ADMIN_EMAIL=
WEBLATE_ADMIN_PASSWORD=

# Django の署名鍵（openssl rand -hex 32）
WEBLATE_SECRET_KEY=

# 公開ホスト名。cloudflared のトンネル（app-intl.ckk-tool.co.jp）経由でのみ
# 公開する — LAN の IP:8080 と二重に持とうとすると Django の
# SECURE_SSL_REDIRECT が http の LAN 直叩きを巻き込んで壊れる
# （docker-compose.yml の「■ 公開は cloudflared のトンネルだけ」参照）。
WEBLATE_SITE_DOMAIN=app-intl.ckk-tool.co.jp
WEBLATE_ENABLE_HTTPS=1

# 送信メール（既存の mailrelay に寄せる）
WEBLATE_EMAIL_HOST=mailrelay
WEBLATE_EMAIL_PORT=25
WEBLATE_DEFAULT_FROM_EMAIL=weblate@ckk-tool.co.jp

# 翻訳の書き戻しを PR で出すための GitHub 資格情報
#   scope: repo（private リポジトリの読み書き + PR 作成）
WEBLATE_GITHUB_USERNAME=
WEBLATE_GITHUB_TOKEN=
