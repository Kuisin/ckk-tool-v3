// Grafana Alloy — collect the logs of EVERY Docker container via the Docker
// socket and ship them to Loki, labelled by container name. New containers are
// auto-discovered on the refresh interval.

discovery.docker "all" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "docker" {
  targets = discovery.docker.all.targets

  // /container-name -> container="container-name"
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  // docker compose project -> stack="<stack>"
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "stack"
  }
  // stdout / stderr
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
  // container image (handy for filtering)
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }

  // ── Coolify のアプリだけ名前を読める形に上書きする ─────────────────
  // Coolify はコンテナ名も compose project もハッシュ（例:
  // f110okf12c7iz5dglveg3qsh-034406048923）なので、そのままだと
  // nextjs-web / po-extract / kiosk のログが Loki で判別できない。
  // Coolify は本来の名前を `coolify.resourceName` ラベルに入れているので、
  // それがあるコンテナだけ container / stack を差し替える
  // （マッチしないコンテナは上のルールの値がそのまま残る）。
  rule {
    source_labels = ["__meta_docker_container_label_coolify_resourceName"]
    regex         = "(.+)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_coolify_projectName"]
    regex         = "(.+)"
    target_label  = "stack"
  }
  // 環境（development / production）— dev と main のログを分けて見るため。
  rule {
    source_labels = ["__meta_docker_container_label_coolify_environmentName"]
    regex         = "(.+)"
    target_label  = "environment"
  }
}

loki.source.docker "all" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.docker.output
  refresh_interval = "15s"
  labels           = { job = "docker" }
  forward_to       = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
