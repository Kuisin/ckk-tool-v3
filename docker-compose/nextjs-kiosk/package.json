{
  "name": "nextjs-kiosk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/src/server.js",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:sync-schema": "rm -rf prisma/schema && cp -R ../../shared-db/prisma/schema prisma/schema",
    "db:generate": "prisma generate",
    "twin:sync": "for f in workflow-core.ts workflow-core.test.ts inventory.ts inspection-core.ts inspection-core.test.ts qr-payload.ts qr-payload.test.ts; do cp ../nextjs-web/src/lib/$f src/lib/$f; done"
  },
  "dependencies": {
    "@ckk/authz-core": "workspace:*",
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@mantine/notifications": "^9.3.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tabler/icons-react": "^3.44.0",
    "next": "16.2.9",
    "pg": "^8.23.0",
    "qr-scanner": "^1.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "prisma": "7.8.0",
    "typescript": "^5",
    "vitest": "4.1.9"
  }
}
