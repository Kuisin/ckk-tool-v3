{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "incremental": false
  },
  "include": ["src/server.ts", "src/lib/ws-server.ts", "src/lib/ws-auth.ts"]
}
