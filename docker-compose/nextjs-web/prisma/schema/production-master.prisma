// 製造マスタ (_specs/tables.md §Master/§Logic 該当分):
// 拠点 / 工程カタログ + 使用・実行依存 / 検査表テンプレート / 不良種類 /
// 承認グループ。実データ（指示書・工程ステップ等）は production.prisma（後続）。
//
// id 方針: マスタは Int autoincrement（MaterialType/Material の再キー後の慣例）。
// 依存・メンバーは複合 PK の純ジョイン。@@map は _specs/tables.md の表名に一致
// させ、audit_logs のラベル解決と揃える。

// ─── 地域（拠点のグループ。SCOPE.REGION の実体） ─────────────────────────────

// scope_values は regions.code を参照する。管理 UI は 拠点マスタ配下
// （/master/plants/regions — 変更頻度が低いため専用アプリ・opcode なし）。
model Region {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      Json // { ja, en }
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plants Plant[] @relation("PlantRegion")

  @@map("regions")
  @@schema("app")
}

// ─── 拠点（製造・在庫・出荷の拠点。SCOPE.PLANT の実体） ────────────────────

model Plant {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          Json
  nameKana      String?  @map("name_kana")
  // 国は拠点ごとに 1 つ（ISO 3166-1 alpha-2）
  countryCode   String?  @map("country_code") @db.VarChar(2)
  regionId      Int?     @map("region_id")
  postalCode    String?  @map("postal_code")
  address       Json?
  phone         String?
  email         String?
  contactPerson String?  @map("contact_person")
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  region Region? @relation("PlantRegion", fields: [regionId], references: [id])

  workOrderSteps WorkOrderStep[]
  deliveryOrders DeliveryOrder[]
  poItems        MaterialPurchaseOrderItem[] @relation("PoItemPlant")
  receipts       MaterialReceipt[]           @relation("ReceiptPlant")
  prqItems       PurchaseRequestItem[]       @relation("PrqItemPlant")
  productInventory  ProductInventory[]
  materialInventory MaterialInventory[]
  kioskDevices      KioskDevice[]   @relation("KioskDevicePlant")
  kioskFloorMaps    KioskFloorMap[] @relation("KioskFloorMapPlant")
  routeVersionSteps ProductProcessRouteVersionStep[] @relation("RouteStepPlant")
  workLocationGroups WorkLocationGroup[] @relation("WorkLocationGroupPlant")
  storageLocations   StorageLocation[]   @relation("StorageLocationPlant")
  userPlants         UserPlant[]         @relation("PlantUsers")
  orderAcceptances   OrderAcceptance[]   @relation("AcceptancePlant")

  @@index([regionId])
  @@map("plants")
  @@schema("app")
}

// ─── 作業場所マスタ ──────────────────────────────────────────────────────────

// 作業場所グループ（例: 同型機械のまとまり = 1 グループ、エリア区分）。
// 種別（machine / area …）は system_settings `work_location.types` の
// 管理者定義キー — スキーマ変更なしで種別を追加できる。
model WorkLocationGroup {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      Json // { ja, en }
  typeKey   String   @map("type_key") // work_location.types のキー
  plantId Int?     @map("plant_id")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant   Plant?       @relation("WorkLocationGroupPlant", fields: [plantId], references: [id])
  locations WorkLocation[]

  @@index([typeKey])
  @@map("work_location_groups")
  @@schema("app")
}

// 物理的な作業場所（グループ内の 1 台の機械・1 区画）。
// capacity = 同時に割り当て可能な作業数（任意 — null は無制限扱い）。
model WorkLocation {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  code      String   @unique
  name      Json // { ja, en }
  capacity  Int?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group     WorkLocationGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stepPlans WorkOrderStepPlan[] @relation("StepPlanWorkLocation")
  stepCatalogLinks ProcessStepWorkLocation[] @relation("StepAllowedWorkLocation")
  stepActuals WorkOrderStepActual[] @relation("StepActualWorkLocation")
  kioskDevices KioskDevice[] @relation("KioskDeviceDefaultWorkLocation")
  orderAcceptances OrderAcceptance[] @relation("AcceptanceShippingWorkLocation")

  @@index([groupId, sortOrder])
  @@map("work_locations")
  @@schema("app")
}

// ─── 工程マスタ（カタログ） ──────────────────────────────────────────────────

enum ProcessCategory {
  MATERIAL_PREP // 材料準備
  MACHINING // 加工
  COATING // コーティング
  INSPECTION // 検査
  APPROVAL // 検査承認
  SHIPPING // 出荷

  @@map("PROCESS_CATEGORY")
  @@schema("app")
}

enum ProcessExecution {
  INTERNAL // 社内のみ
  INTERNAL_OR_OUTSOURCE // 社内・外注

  @@map("PROCESS_EXECUTION")
  @@schema("app")
}

enum DependencyRelation {
  AND
  OR

  @@map("DEPENDENCY_RELATION")
  @@schema("app")
}

// 工程の数量管理モード。NONE は記録なし（完了時に受入数をそのまま良品数へ
// パススルー）。INSPECTION は FLOW と同じ列を 検査数/合格/不合格 として扱う。
enum QuantityTracking {
  NONE // 数量記録なし — 完了時パススルー
  FLOW // 受入/良品/不良の保存則管理（既定）
  INSPECTION // 検査数/合格/不合格（同じ列・別ラベル）

  @@map("QUANTITY_TRACKING")
  @@schema("app")
}

// CKK 実工程カタログ（_docs/manufacturing_details.md）。テンプレート定義であり、
// 実行順は指示書側の依存解決で決まる（sort_order は既定順の参考）。
model ProcessStepCatalog {
  id                Int              @id @default(autoincrement())
  code              String           @unique // e.g. CYLINDER_MACHINING
  name              Json // { ja: '円筒加工', en: '' }
  category          ProcessCategory
  executionLocation ProcessExecution @map("execution_location")
  isSyncCapable     Boolean          @default(false) @map("is_sync_capable") // 他工程と同時実施・記録可
  isInspection      Boolean          @default(false) @map("is_inspection") // 検査工程
  isApprovalStep    Boolean          @default(false) @map("is_approval_step") // 検査承認工程
  approvalMinRank   String?          @map("approval_min_rank") // 係長以上等
  quantityTracking  QuantityTracking @default(FLOW) @map("quantity_tracking")
  defaultWorkHours  Decimal?         @map("default_work_hours") @db.Decimal(6, 2) // 既定作業時間 (h) — ルート/指示書の初期値
  sortOrder         Int              @default(0) @map("sort_order")
  isActive          Boolean          @default(true) @map("is_active")
  notes             String?

  useDependencies    ProcessStepUseDependency[]  @relation("UseDepStep")
  allowedWorkLocations ProcessStepWorkLocation[]   @relation("StepAllowedWorkLocations")
  usedBy             ProcessStepUseDependency[]  @relation("UseDepTarget")
  execDependencies   ProcessStepExecDependency[] @relation("ExecDepStep")
  execRequiredBy     ProcessStepExecDependency[] @relation("ExecDepTarget")
  inspectionTemplates InspectionTemplate[]
  workOrderSteps      WorkOrderStep[]
  routeVersionSteps   ProductProcessRouteVersionStep[]

  @@map("process_step_catalog")
  @@schema("app")
}

// 工程で使える作業場所の許可リスト（計画・実績の両方に適用）。
// 1 行 = 種別（type_key — work_location.types のキー）or 個別
// （work_location_id）のどちらか一方（CHECK はマイグレーション側で担保 —
// Prisma は CHECK 制約を表現できない）。
// **行が 1 つも無い工程は無制限**（全作業場所を使用可）。許可集合の解決は
// nextjs-web lib/work-locations.ts fetchAllowedWorkLocationIds /
// nextjs-kiosk lib/step-execution.ts allowedWorkLocationIdsForStep。
model ProcessStepWorkLocation {
  id             Int      @id @default(autoincrement())
  processStepId  Int      @map("process_step_id")
  typeKey        String?  @map("type_key")
  workLocationId Int?     @map("work_location_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  processStep  ProcessStepCatalog @relation("StepAllowedWorkLocations", fields: [processStepId], references: [id], onDelete: Cascade)
  workLocation WorkLocation?      @relation("StepAllowedWorkLocation", fields: [workLocationId], references: [id], onDelete: Cascade)

  @@index([processStepId])
  @@index([workLocationId])
  @@map("process_step_work_locations")
  @@schema("app")
}

// 使用依存: この工程をワークフローに含めてよい条件（他工程の「存在」）。
// OR エッジ群は 1 グループとして「いずれか存在」。is_negation = 排他（!）。
// 素材属性由来の条件（研磨・定尺等）はエッジで表現せず、対象工程が
// ワークフローに無ければ空真（vacuously satisfied）として扱う。
model ProcessStepUseDependency {
  stepId          Int                @map("step_id")
  dependsOnStepId Int                @map("depends_on_step_id")
  relation        DependencyRelation @default(AND)
  isNegation      Boolean            @default(false) @map("is_negation")
  notes           String?

  step      ProcessStepCatalog @relation("UseDepStep", fields: [stepId], references: [id])
  dependsOn ProcessStepCatalog @relation("UseDepTarget", fields: [dependsOnStepId], references: [id])

  @@id([stepId, dependsOnStepId])
  @@map("process_step_use_dependencies")
  @@schema("app")
}

// 実行依存: この工程を開始してよい条件（指定工程の「完了」）。
// ワークフローに存在しない依存先は空真（素材属性条件の代替と §7 の動的順序）。
model ProcessStepExecDependency {
  stepId          Int                @map("step_id")
  dependsOnStepId Int                @map("depends_on_step_id")
  relation        DependencyRelation @default(AND)
  notes           String?

  step      ProcessStepCatalog @relation("ExecDepStep", fields: [stepId], references: [id])
  dependsOn ProcessStepCatalog @relation("ExecDepTarget", fields: [dependsOnStepId], references: [id])

  @@id([stepId, dependsOnStepId])
  @@map("process_step_exec_dependencies")
  @@schema("app")
}

// ─── 検査表テンプレート ──────────────────────────────────────────────────────

// 検査項目の入力種別
enum InspectionItemType {
  BOOLEAN // はい/いいえ
  NUMBER // 数値（既存互換 — default）
  SELECT_SINGLE // 単一選択
  SELECT_MULTI // 複数選択

  @@schema("app")
}

// 抜取検査モード（項目ごと）
enum InspectionSamplingMode {
  ALL // 全数
  PERCENT // ロットの割合(%)
  COUNT // 本数

  @@schema("app")
}

// 記録方式（項目ごと）: 製品ごとの実測値 or 合格数のみ
enum InspectionRecordStyle {
  VALUES // 実測値（サンプルごとに入力）
  COUNTS // 合格数のみ（検査数・合格数を入力）

  @@schema("app")
}

// バージョン管理: 同一 code に複数バージョン（各バージョンが完全な行 + items）。
// 指示書リンク・検査記録は行 id を参照するので、使用されたバージョンに固定される。
// 指示書割当済み/記録ありのバージョンは編集不可 — 変更は新バージョンをコピー作成。
model InspectionTemplate {
  id                    Int      @id @default(autoincrement())
  code                  String
  version               Int      @default(1) // code 内 1 始まりの連番
  name                  Json
  relatedProcessStepId  Int?     @map("related_process_step_id")
  // 検査対象（シート単位）: 全数 / 割合(%) / 本数 — 各項目はこの数の製品に対して記録する
  samplingMode          InspectionSamplingMode @default(ALL) @map("sampling_mode")
  samplingValue         Decimal? @map("sampling_value") @db.Decimal(10, 2)
  // 記録方式（シート単位）: VALUES = 製品ごとにページ送りで実測値 / COUNTS = 項目ごとに検査数・合格数のみ
  recordStyle           InspectionRecordStyle @default(VALUES) @map("record_style")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  relatedProcessStep ProcessStepCatalog?      @relation(fields: [relatedProcessStepId], references: [id])
  items              InspectionTemplateItem[]
  workOrderStepTemplates WorkOrderStepInspectionTemplate[]
  inspectionRecords  InspectionRecord[]            @relation("InspectionRecordTemplate")

  @@unique([code, version])
  @@map("inspection_templates")
  @@schema("app")
}

model InspectionTemplateItem {
  id           Int      @id @default(autoincrement())
  templateId   Int      @map("template_id")
  itemName     Json     @map("item_name")
  inputType    InspectionItemType @default(NUMBER) @map("input_type")
  unit         String? // NUMBER 用
  toleranceMin Decimal? @map("tolerance_min") @db.Decimal(12, 4) // NUMBER: 合格範囲 下限
  toleranceMax Decimal? @map("tolerance_max") @db.Decimal(12, 4) // NUMBER: 合格範囲 上限
  options      Json? // SELECT_*: [{ value: string, label: { ja, en } }]
  acceptBool   Boolean? @map("accept_bool") // BOOLEAN: 合格とする回答
  acceptOptions Json?   @map("accept_options") // SELECT_*: 合格とする value[]
  goalValue    Json?    @map("goal_value") // 目標値: number | boolean | string | string[]
  allowManualOverride Boolean @default(true) @map("allow_manual_override") // 合否の手動上書きを許可（基準未設定の項目は常に手動）
  isRequired   Boolean  @default(true) @map("is_required")
  sortOrder    Int      @default(0) @map("sort_order")

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  recordItems InspectionRecordItem[] @relation("InspectionRecordItemTemplate")

  @@index([templateId, sortOrder])
  @@map("inspection_template_items")
  @@schema("app")
}

// ─── 不良種類 ────────────────────────────────────────────────────────────────

model DefectType {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      Json
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  defectRecords DefectRecord[] @relation("DefectRecordType")

  @@map("defect_types")
  @@schema("app")
}

// ─── 承認グループ ────────────────────────────────────────────────────────────

// 承認グループ = 承認者の集合。「何段目か」は持たない — それは
// approval_flow_steps が書類種別ごとに決める。
model ApprovalGroup {
  id       Int     @id @default(autoincrement())
  name     Json
  isActive Boolean @default(true) @map("is_active")

  members   ApprovalGroupMember[]
  delegates ApprovalDelegate[]
  flowSteps ApprovalFlowStep[]
  requests  ApprovalRequest[]

  @@map("approval_groups")
  @@schema("app")
}

// 常任メンバー = valid_from / valid_until とも NULL。
// 期間限定メンバー = 両方に日時が入る（片側だけは CHECK で禁止）。
// 実効判定は lib/approval-membership.ts isMemberEffective() が唯一の定義。
model ApprovalGroupMember {
  groupId    Int       @map("group_id")
  userId     String    @map("user_id") @db.Uuid
  isActive   Boolean   @default(true) @map("is_active")
  validFrom  DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)
  note       String? // 期間限定の理由（任意）

  group ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation("ApprovalGroupMemberUser", fields: [userId], references: [id])

  @@id([groupId, userId])
  @@map("approval_group_members")
  @@schema("app")
}

// ─── 承認フロー定義（書類種別ごとに 1 本） ──────────────────────────────────
//
// target_type は approval_requests.target_type と同じ値（= @@map 名）。
// 新しい enum を足さないのは、既存の多態規約（audit と同じ）に合わせるため。
// 値の範囲は DB 側の CHECK 制約と TS 側の APPROVAL_TARGET_TYPES で守る。

enum ApprovalMode {
  ANY // いずれか 1 名の承認でこの段は通過
  ALL // 対象メンバー全員の承認が必要

  @@map("APPROVAL_MODE")
  @@schema("app")
}

model ApprovalFlow {
  targetType String   @id @map("target_type")
  updatedBy  String?  @map("updated_by") @db.Uuid
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  steps         ApprovalFlowStep[]
  updatedByUser User?              @relation("ApprovalFlowUpdatedBy", fields: [updatedBy], references: [id])

  @@map("approval_flows")
  @@schema("app")
}

// step_no は 1..N の連番（詰めて保存）。並べ替えは全削除 + 再作成で行う
// （進行中の依頼はこの行を参照していない — flow_snapshot を持つため）。
model ApprovalFlowStep {
  id         Int          @id @default(autoincrement())
  targetType String       @map("target_type")
  stepNo     Int          @map("step_no")
  name       Json // { ja, en } 例「第一承認」
  groupId    Int          @map("group_id")
  mode       ApprovalMode @default(ANY)

  flow  ApprovalFlow  @relation(fields: [targetType], references: [targetType], onDelete: Cascade)
  group ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([targetType, stepNo])
  @@index([groupId])
  @@map("approval_flow_steps")
  @@schema("app")
}

// ─── 承認フロー本実装（§6: 依頼・記録・代理） ───────────────────────────────
//
// 対象は多態（target_type = @@map 名 / target_id = 業務キー — audit と同じ規約:
// 指示書 = work_order_number 文字列、発注書 = PO-…、注文請書 = ORD-…）。

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("APPROVAL_REQUEST_STATUS")
  @@schema("app")
}

enum ApprovalAction {
  APPROVED
  REJECTED

  @@map("APPROVAL_ACTION")
  @@schema("app")
}

// 1 行 = 1 段の承認依頼。進行中は (target_type, target_id) につき常に 1 行だけ
// PENDING（部分 unique index が保証）。段 N を閉じるのと段 N+1 を作るのは
// 同一トランザクション。
//
// flow_snapshot は依頼時点のフロー全段のコピー
// [{ stepNo, name:{ja,en}, groupId, groupName:{ja,en}, mode }]。
// これを持つことで (a) 進行中の書類が後からのフロー編集に影響されず、
// (b) Stepper が 1 行読むだけで全体を描ける。同じ配列がフロー中の全依頼行に
// 載るのは承知のうえの非正規化 — join を無くすための意図的な設計。
model ApprovalRequest {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType   String                @map("target_type") // work_orders / material_purchase_orders / order_acceptances / purchase_requests
  targetId     String                @map("target_id") // 業務キー
  stepNo       Int                   @map("step_no") // 1..N
  stepCount    Int                   @map("step_count") // 依頼時点の総段数
  groupId      Int?                  @map("group_id") // 依頼時点の承認グループ
  mode         ApprovalMode          @default(ANY)
  flowSnapshot Json                  @map("flow_snapshot")
  status       ApprovalRequestStatus @default(PENDING)
  requestedBy  String?               @map("requested_by") @db.Uuid
  requestedAt  DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  notes        String?

  requestedByUser User?                     @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id])
  group           ApprovalGroup?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  records         ApprovalRecord[]
  approvers       ApprovalRequestApprover[]

  @@index([targetType, targetId])
  @@index([status])
  @@map("approval_requests")
  @@schema("app")
}

// 依頼時点で「この段で承認しうる人」のスナップショット。
// ALL モードでは必須チェックリスト（全枠が acted_at で埋まると段が閉じる）、
// ANY モードでは表示・通知用。acted_by は代理が押した場合の実行者。
model ApprovalRequestApprover {
  approvalRequestId String    @map("approval_request_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  actedAt           DateTime? @map("acted_at") @db.Timestamptz(6)
  actedBy           String?   @map("acted_by") @db.Uuid

  request     ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  user        User            @relation("ApprovalRequestApproverUser", fields: [userId], references: [id])
  actedByUser User?           @relation("ApprovalRequestApproverActedBy", fields: [actedBy], references: [id])

  @@id([approvalRequestId, userId])
  @@map("approval_request_approvers")
  @@schema("app")
}

model ApprovalRecord {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalRequestId String         @map("approval_request_id") @db.Uuid
  approverId        String         @map("approver_id") @db.Uuid
  delegateForId     String?        @map("delegate_for_id") @db.Uuid // 代理の場合の原承認者
  action            ApprovalAction
  comment           String?
  actedAt           DateTime       @default(now()) @map("acted_at") @db.Timestamptz(6)

  request     ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approver    User            @relation("ApprovalRecordApprover", fields: [approverId], references: [id])
  delegateFor User?           @relation("ApprovalRecordDelegateFor", fields: [delegateForId], references: [id])

  @@index([approvalRequestId])
  @@map("approval_records")
  @@schema("app")
}

// 期間限定代理（delegator のグループ権限を delegate が行使できる）
model ApprovalDelegate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     Int      @map("group_id")
  delegatorId String   @map("delegator_id") @db.Uuid
  delegateId  String   @map("delegate_id") @db.Uuid
  validFrom   DateTime @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime @map("valid_until") @db.Timestamptz(6)
  reason      String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group         ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  delegator     User          @relation("DelegateDelegator", fields: [delegatorId], references: [id])
  delegate      User          @relation("DelegateDelegate", fields: [delegateId], references: [id])
  createdByUser User?         @relation("DelegateCreatedBy", fields: [createdBy], references: [id])

  @@index([groupId, validFrom, validUntil])
  @@index([delegateId])
  @@map("approval_delegates")
  @@schema("app")
}
