// ファイル・採番 (_specs/tables.md §Other).

// SeaweedFS オブジェクト
model File {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey String   @map("storage_key")
  filename   String
  mimeType   String   @map("mime_type")
  sizeBytes  BigInt?  @map("size_bytes")
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploadedByUser User? @relation("FileUploadedBy", fields: [uploadedBy], references: [id])

  quotesPdf        Quote[]        @relation("QuotePdf")
  deliveryNotesPdf DeliveryNote[] @relation("DeliveryNotePdf")
  invoicesPdf      Invoice[]      @relation("InvoicePdf")
  designFiles      DesignFile[]   @relation("DesignFileFile")
  attachments      DocumentAttachment[] @relation("AttachmentFile")
  acceptanceSources OrderAcceptance[]   @relation("AcceptanceSourceFile")
  kioskFloorMaps   KioskFloorMap[]      @relation("KioskFloorMapFile")
  userAvatars      User[]               @relation("UserAvatarFile")
  userAvatarThumbs User[]               @relation("UserAvatarThumbFile")

  @@map("files")
  @@schema("app")
}

// ファイル管理 (SY06) のフォルダ単位アクセス権。path_prefix はストレージキーの
// 前方一致（例: "uploads" / "attachments/material_receipts"）。system:ADMIN は
// 常に全フォルダ。アプリ生成ファイル（pdfs/* 等）は所有アプリの権限でも
// 閲覧できる（lib/file-access.ts の prefix→権限マップ）。
model FileFolderGrant {
  id         Int      @id @default(autoincrement())
  pathPrefix String   @map("path_prefix")
  userId     String   @map("user_id") @db.Uuid
  canWrite   Boolean  @default(false) @map("can_write") // アップロード・削除も許可
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User  @relation("FileFolderGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("FileFolderGrantCreatedBy", fields: [createdBy], references: [id])

  @@unique([pathPrefix, userId])
  @@index([userId])
  @@map("file_folder_grants")
  @@schema("app")
}

// システム設定（試算の価格ポリシーなど。feature_flags 同様の単純 KV）
// キー例: trial_pricing.material_price_basis / trial_pricing.lookback_months
model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedByUser User? @relation("SystemSettingUpdatedBy", fields: [updatedBy], references: [id])

  @@map("system_settings")
  @@schema("app")
}

// ホーム画面カスタマイズ（1 行 = 1 ユーザー。行が無ければ既定表示）。
// starred = お気に入りアプリの key 配列（ホーム上部に固定表示）。
// groups  = カスタムグループ [{ name, apps: string[] }]（mode=custom 時の表示順）。
model UserHomeSetting {
  userId    String   @id @map("user_id") @db.Uuid
  mode      String   @default("default") // default（カテゴリ別） | custom（グループ別）
  starred   Json     @default("[]")
  groups    Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("UserHomeSettingUser", fields: [userId], references: [id])

  @@map("user_home_settings")
  @@schema("app")
}

// 採番管理（EST/QOT — 月次リセット）
model NumberingSequence {
  key           String   @id
  prefix        String
  lastYearMonth String?  @map("last_year_month")
  lastSequence  Int      @default(0) @map("last_sequence")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("numbering_sequences")
  @@schema("app")
}

// フィーチャーフラグ（_specs/tables.md §Other）。アプリの環境別 ON/OFF に使用:
// key = `app:<appKey>:<env>`（env = dev | main）。行が無ければ有効（デフォルト
// ON — 既存挙動を変えない）。dev/main は同一 DB を共有するため env をキーに含める。
model FeatureFlag {
  key         String   @id
  isEnabled   Boolean  @default(false) @map("is_enabled")
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedByUser User? @relation("FeatureFlagUpdatedBy", fields: [updatedBy], references: [id])

  @@map("feature_flags")
  @@schema("app")
}

// 監査ログ（業務操作履歴）。各レコードの CREATE/UPDATE/DELETE を before/after
// JSON 付きで記録し、詳細画面の「履歴」タブと管理者向け操作履歴一覧で表示する。
// record_id は業務識別子（文書番号 QOT-… / EST-…、価格表エントリキー、
// マスタの文字列 id）を格納する TEXT — 文書テーブルが複合キーのため uuid ではない。
// user_id は認証実装後に実ユーザーへ解決する弱参照（現状は null 可）。
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  action     String // CREATE / UPDATE / DELETE
  tableName  String   @map("table_name") // quotes / estimates / price_list_entries / products …
  recordId   String?  @map("record_id") // 業務識別子（文書番号・エントリキー・id）
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  // 操作元のキオスク端末（共有タブレットからの操作のみ。Web からは null）。
  // 誰が だけでなく **どの端末で** を残すため — 履歴一覧・履歴タブで
  // 端末名バッジとして表示する。
  kioskDeviceId String? @map("kiosk_device_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User?        @relation("AuditLogUser", fields: [userId], references: [id])
  kioskDevice KioskDevice? @relation("AuditLogKioskDevice", fields: [kioskDeviceId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([kioskDeviceId])
  @@map("audit_logs")
  @@schema("app")
}

// 文書添付（証憑等）。owner は多態参照（owner_type = @@map 名 / owner_id =
// 各画面の業務キー文字列 — audit_logs の record_id と同じ規約）。
// 実体は files（SeaweedFS）。用途: 発注書の承認後証憑・素材入荷の納品書控え・
// 受注請書の取込元ファイルなど。
model DocumentAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType  String   @map("owner_type") // material_purchase_orders / material_receipts / order_acceptances …
  ownerId    String   @map("owner_id") // 業務キー（PO-… / uuid / ORD-…）
  fileId     String   @map("file_id") @db.Uuid
  label      String? // 表示名・区分（注文書控え 等）
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file           File  @relation("AttachmentFile", fields: [fileId], references: [id])
  uploadedByUser User? @relation("AttachmentUploadedBy", fields: [uploadedBy], references: [id])

  @@index([ownerType, ownerId])
  @@map("document_attachments")
  @@schema("app")
}

// 文書メモ / コメント（社内向けリッチテキスト）。owner の規約は
// document_attachments・audit_logs と同じ多態参照（owner_type = @@map 名 /
// owner_id = 業務キー文字列）。
//
// kind = MEMO   … 1 文書に 1 件（見積書 / 注文請書 / 指示書 / 出荷書 / 請求書）
// kind = COMMENT… 1 文書に複数件の投稿スレッド（価格表 / 試算）
// MEMO の単一性はアプリ側（lib/document-memos.ts の saveMemo）で担保する
// — Prisma が部分 UNIQUE を表現できず、手書きすると migrate diff が濁るため。
//
// content は ProseMirror ドキュメント JSON。HTML 文字列では保存しない
// （保存 XSS を構造的に排除する — lib/rich-text-core.ts で許可リスト検証し、
// 表示は React 要素を組み立てて行う）。plain_text はその平文射影で、
// 一覧プレビューと監査ログの可読性のために持つ。
model DocumentMemo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType String   @map("owner_type") // quotes / sales_orders / work_orders / price_list_entries …
  ownerId   String   @map("owner_id") // 業務キー（QOT-… / EST-… / 指示書番号 / エントリキー）
  kind      String // MEMO | COMMENT
  content   Json // ProseMirror doc（lib/rich-text-core.ts で検証）
  plainText String   @map("plain_text") // content の平文射影（プレビュー・監査用）
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser User? @relation("DocumentMemoCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("DocumentMemoUpdatedBy", fields: [updatedBy], references: [id])

  @@index([ownerType, ownerId, createdAt])
  @@map("document_memos")
  @@schema("app")
}
