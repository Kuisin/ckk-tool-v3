// 注文請書 intake (_specs §2): 監視フォルダ / 優先アップロードから自動取込。
//
// キー: (year_month, seq) — ORDER シーケンス。表示番号 ORD-YYYYMM-NNNNN。
// 明細は order_lines（注文明細）1 本で、取込〜承認までの下書き行であり、
// 確定後はそのまま実行アンカー（指示書 / 出荷書 / 引当 / 設計依頼の紐付け先）
// になる。確定（COMPLETED）で枝番 1..N を採番し ORD-YYYYMM-NNNNN-NN になる。
// 旧 sales_orders（注文請書）は order_lines に統合済み — 別テーブルは無い。
// ライフサイクル: IMPORT（取込・抽出中/失敗）→ DRAFT（抽出済・編集可）→
// REQUESTED（承認依頼）→ APPROVED → COMPLETED（確定済）→ ARCHIVED。
// 明細の編集は IMPORT / DRAFT のみ（lib/order-line-check.ts が唯一の判定元）。

enum IntakeSource {
  FOLDER // 監視フォルダ
  UPLOAD // 画面からの優先取込
  MANUAL // 手入力

  @@map("INTAKE_SOURCE")
  @@schema("app")
}

enum OrderAcceptanceStatus {
  IMPORT
  DRAFT
  REQUESTED
  APPROVED
  COMPLETED
  ARCHIVED
  // キャンセル承認（order_acceptance_cancel_requests）の適用後。
  // 配下の注文明細もすべて CANCELLED になっている。
  CANCELLED

  @@map("ORDER_ACCEPTANCE_STATUS")
  @@schema("app")
}

// 注文明細のステータス（旧 SalesOrderStatus）。確定前は DRAFT。
enum OrderLineStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIAL_SHIPPED
  SHIPPED
  CANCELLED

  @@map("ORDER_LINE_STATUS")
  @@schema("app")
}

model OrderAcceptance {
  yearMonth String @map("year_month") @db.Char(6)
  seq       Int

  status OrderAcceptanceStatus @default(IMPORT)
  source IntakeSource          @default(MANUAL)

  // 取込元ファイル（files/SeaweedFS。添付一覧は document_attachments 側）
  sourceFileId String? @map("source_file_id") @db.Uuid
  // 抽出結果の生 JSON（po-extract /extract/order-request）
  extracted    Json?
  extractError String? @map("extract_error")

  customerBpId       String? @map("customer_bp_id") @db.Uuid
  customerBranchBpId String? @map("customer_branch_bp_id") @db.Uuid
  customerOrderRef   String? @map("customer_order_ref") // 顧客注文書番号
  // 見積 → 受注のトレーサビリティ（監査 P2-2。QOT の複合キー参照）
  quoteYearMonth     String? @map("quote_year_month") @db.Char(6)
  quoteSeq           Int?    @map("quote_seq")
  orderDate          DateTime? @map("order_date") @db.Date
  /// 受注金額の通貨（currencies.code。既定 JPY — 明細はヘッダから読む。sales_rep と同じ規約）
  currency           String    @default("JPY")

  /// @deprecated 配送は明細（order_lines）ごとに持つように変更した
  /// （1 通の注文書の中で行ごとに届け先が違う注文があるため）。
  /// アプリはこの列を**もう読まない・書かない** — dev への 1 回のデプロイが
  /// 回ったあと、別の migration で DROP する（ローリングデプロイ中は旧
  /// コンテナがこの列しか知らないため、値を消さずに置いておくだけの期間）。
  /// エンドユーザーは明細に end_user_bp_id が最初からあったので対象外。
  shipToBpId String? @map("ship_to_bp_id") @db.Uuid
  /// @deprecated 上と同じ理由。order_lines.delivery_method へ移した。
  deliveryMethod DeliveryMethod @default(NORMAL) @map("delivery_method")
  /// @deprecated 上と同じ理由。order_lines.end_user_bp_id（既存列）へ一本化した。
  endUserBpId String? @map("end_user_bp_id") @db.Uuid
  /// @deprecated 上と同じ理由。order_lines.assigned_plant_id へ移した。
  assignedPlantId Int? @map("assigned_plant_id")
  /// @deprecated 上と同じ理由。order_lines.shipping_work_location_id へ移した。
  shippingWorkLocationId Int? @map("shipping_work_location_id")
  // 顧客が自前の納品書（バーコード等）を用意する取引か。true のときは
  // 自社発行の納品書に添える形で顧客提供の納品書も同梱する運用上の目印
  // （出荷準備担当への注意喚起。自動作成する納品書の通数は変わらない）。
  customerProvidesDeliveryNote Boolean @default(false) @map("customer_provides_delivery_note")

  notes       String?
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  // 作り直し元（キャンセル済みの注文請書）。
  //
  // 確定済み（COMPLETED）の請書は明細を編集できない（lib/order-line-check.ts）。
  // 直したいときの手順は 1 つだけ: **ごとキャンセル → その請書から作り直す**。
  // キャンセルは配下の未着手指示書も連鎖で止める（lib/order-line-cancel.ts）ので、
  // 作り直した側で改めて手配することになる。
  //
  // 紐付けを残すのは「あの注文はどうなったのか」を後から追えるようにするため —
  // キャンセルした請書だけが残ると、指示書も出荷も無い行き止まりに見える。
  // 1 件を 2 件に割って作り直すこともあるので **1 対 N**（unique にしない）。
  replacesYearMonth String? @map("replaces_year_month") @db.Char(6)
  replacesSeq       Int?    @map("replaces_seq")
  // 営業担当 — 作成時に顧客の主担当（bp_sales_reps.is_primary）を複写した
  // スナップショット。顧客側の担当が替わっても過去書類は動かない。
  // 注文明細（order_lines）は行に複写せずここから読む。
  salesRepId  String?   @map("sales_rep_id") @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sourceFile       File?            @relation("AcceptanceSourceFile", fields: [sourceFileId], references: [id])
  customerBp       BusinessPartner? @relation("AcceptanceCustomer", fields: [customerBpId], references: [id])
  customerBranchBp BusinessPartner? @relation("AcceptanceCustomerBranch", fields: [customerBranchBpId], references: [id])
  shipToBp         BusinessPartner? @relation("AcceptanceShipTo", fields: [shipToBpId], references: [id])
  endUserBp        BusinessPartner? @relation("AcceptanceEndUser", fields: [endUserBpId], references: [id])
  assignedPlant    Plant?           @relation("AcceptancePlant", fields: [assignedPlantId], references: [id])
  shippingWorkLocation WorkLocation? @relation("AcceptanceShippingWorkLocation", fields: [shippingWorkLocationId], references: [id])
  createdByUser    User?            @relation("AcceptanceCreatedBy", fields: [createdBy], references: [id])
  salesRep         User?            @relation("AcceptanceSalesRep", fields: [salesRepId], references: [id])

  // 元は消えても作り直した側は残す（SetNull）— 紐付けが切れるだけで、
  // 作り直した請書そのものは業務データとして生きている。
  replaces   OrderAcceptance?  @relation("AcceptanceReplaces", fields: [replacesYearMonth, replacesSeq], references: [yearMonth, seq], onDelete: SetNull, onUpdate: NoAction)
  replacedBy OrderAcceptance[] @relation("AcceptanceReplaces")

  items          OrderLine[]
  cancelRequests OrderAcceptanceCancelRequest[]

  @@id([yearMonth, seq])
  @@index([status])
  // 注文明細の顧客絞り込みはヘッダ経由になるため必須
  @@index([customerBpId])
  @@index([replacesYearMonth, replacesSeq])
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, yearMonth, seq])
  @@map("order_acceptances")
  @@schema("app")
}

// 承認されるまで適用しない注文請書キャンセル依頼（§2 / §6）。
//
// 確定済み（COMPLETED）の注文請書は明細単位ではキャンセルできない —
// キャンセルは注文請書ごと依頼し、承認設定（MS0B）の
// 「注文請書キャンセル」フローを通す（1 段も無ければ即適用）。
// 最終承認で全明細のキャンセル（予約解放・未着手指示書の連鎖キャンセル）と
// ヘッダの CANCELLED 遷移が走る。approval_requests は業務キー（= id）で
// 指すため FK は無い → AFTER DELETE トリガーで掃除（migration 参照）。
model OrderAcceptanceCancelRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acceptanceYearMonth String    @map("acceptance_year_month") @db.Char(6)
  acceptanceSeq       Int       @map("acceptance_seq")
  /// 依頼理由（必須 — 確定済みの受注を取り消す例外操作のため）。
  reason              String
  /// PENDING | APPLIED | REJECTED | CANCELLED | FAILED（DB 側 CHECK）
  status              String    @default("PENDING")
  /// 適用に失敗した理由（承認待ちの間に出荷された等）。承認後に出る。
  error               String?
  requestedBy         String?   @map("requested_by") @db.Uuid
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedBy          String?   @map("resolved_by") @db.Uuid
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)

  acceptance      OrderAcceptance @relation(fields: [acceptanceYearMonth, acceptanceSeq], references: [yearMonth, seq], onDelete: Cascade)
  requestedByUser User?           @relation("AcceptanceCancelRequestedBy", fields: [requestedBy], references: [id])
  resolvedByUser  User?           @relation("AcceptanceCancelResolvedBy", fields: [resolvedBy], references: [id])

  @@index([acceptanceYearMonth, acceptanceSeq, status])
  @@map("order_acceptance_cancel_requests")
  @@schema("app")
}

// 注文明細（注文請書の明細行 = 実行の単位）。
//
// 注文請書 1 行 = 注文明細 1 行で固定 — 分割も統合もしない（同じ製品が別々の
// 明細にあれば別々の注文明細になる）。確定後は変更不可
// （lib/order-line-check.ts が唯一の判定元）。
//
// 確定前: branch / amount は null、status = DRAFT、productId は突合前なら null。
// 確定時: sortOrder 順に branch 1..N を採番し、amount = quantity * unitPrice を
//         確定して status = CONFIRMED。以降 branch は不変。
model OrderLine {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acceptanceYearMonth String @map("acceptance_year_month") @db.Char(6)
  acceptanceSeq       Int    @map("acceptance_seq")
  // 枝番（ORD-YYYYMM-NNNNN-NN の NN）。確定時に採番、以後不変。
  branch              Int?
  sortOrder           Int    @default(0) @map("sort_order")

  // ── 明細内容（注文請書の行そのもの） ──
  // 抽出直後は productText のみ。品目マスタ突合後に itemId を持つ。
  /// 統合品目（app.items）。注文明細の品目（突合前は null）。
  itemId       Int?      @map("item_id")
  productText  String?   @map("product_text") // 抽出された品名（生）
  orderType    OrderType @default(PRODUCTION) @map("order_type")
  quantity     Int
  unitPrice    Decimal?  @map("unit_price") @db.Decimal(12, 2)
  amount       Decimal?  @db.Decimal(12, 2) // 確定時に quantity * unitPrice で確定
  /// 単価を価格表から外して人が決めた行か（§2 価格差異）。
  /// false（既定）= 単価は価格表が持つ — 保存時にサーバーが
  /// (顧客 × 製品 × 注文種別 × 数量) から解決した単価を書く。
  /// true = 人が「上書き」を明示的に入れて決めた単価。価格表と違っても
  /// **差異ではなく意図**として扱い、承認依頼を止めない（承認者には出す）。
  /// 該当する価格表が無い行では意味を持たない（false のまま）。
  priceOverridden Boolean @default(false) @map("price_overridden")
  deliveryDate DateTime? @map("delivery_date") @db.Date
  notes        String?

  // ── 配送（§2 / §8）— どこへ・どう届けるかは**明細ごと**に決まる ──
  // 1 通の注文書の中で行ごとに届け先が違う注文があるため、ヘッダではなく
  // 行が持つ（元は order_acceptances にあった。移行は
  // 20261024090000_order_line_delivery。以前のヘッダの値はここへ複写済み）。
  // 出荷書はこの 4 つ（+ 顧客・エンドユーザー）が揃った明細だけを束ねられる
  // （combinabilityError, components/shipping/delivery-orders/model.ts）。
  shipToBpId             String?        @map("ship_to_bp_id") @db.Uuid
  deliveryMethod         DeliveryMethod @default(NORMAL) @map("delivery_method")
  // 担当拠点（この明細を処理する拠点。null = 未割当。出荷書の出荷元拠点の
  // 既定値でもある）
  assignedPlantId Int? @map("assigned_plant_id")
  // 出荷作業場所（作業場所マスタ MS0D。出荷作業を行う場所）
  shippingWorkLocationId Int? @map("shipping_work_location_id")

  // ── 実行（旧 sales_orders） ──
  status      OrderLineStatus @default(DRAFT)
  // 通し連番（指示書番号と共用）。統合ロット（1 指示書に複数明細）では
  // 同じロット番号を複数明細が共有するため unique ではない。
  lotNumber   Int?            @map("lot_number")
  isLocked    Boolean         @default(false) @map("is_locked") // 承認依頼中ロック
  endUserBpId String?         @map("end_user_bp_id") @db.Uuid // 最終需要家は行ごとに異なり得る
  confirmedAt DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // 顧客・注文書番号・見積キー・作成者はヘッダ（acceptance）から読む —
  // 行に複写すると乖離するため持たない。配送だけは例外（上のコメント参照）。
  acceptance OrderAcceptance  @relation(fields: [acceptanceYearMonth, acceptanceSeq], references: [yearMonth, seq], onDelete: Restrict)
  item       Item?            @relation("OrderLineItem", fields: [itemId], references: [id], onDelete: Restrict)
  endUserBp  BusinessPartner? @relation("OrderLineEndUser", fields: [endUserBpId], references: [id])
  shipToBp             BusinessPartner? @relation("OrderLineShipTo", fields: [shipToBpId], references: [id])
  assignedPlant        Plant?           @relation("OrderLinePlant", fields: [assignedPlantId], references: [id])
  shippingWorkLocation WorkLocation?    @relation("OrderLineShippingWorkLocation", fields: [shippingWorkLocationId], references: [id])

  workOrderLinks WorkOrderOrderLine[]
  deliveryItems  DeliveryOrderItem[]
  reservations   InventoryReservation[]
  designRequests DesignRequest[]
  invoiceItems   InvoiceItem[]

  @@unique([acceptanceYearMonth, acceptanceSeq, branch])
  @@index([status])
  @@index([lotNumber])
  @@index([shipToBpId])
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, id])
  @@index([itemId])
  @@map("order_lines")
  @@schema("app")
}

// ── 学習した照合名（人が手で結び付けた表記） ──────────────────────────
//
// AI 抽出は書類に**印字されたまま**の社名・品名を返す。マスタの名称でも
// キーワード（match_names）でも当たらないとき、人が画面で正しいマスタを選ぶ
// —— その「この表記はこのマスタのことだ」という判断が、これまで 1 回きりで
// 捨てられていた。同じ取引先が同じ書式で毎月送ってくるのに、毎月人が直す。
//
// ここはその判断の置き場。**1 表記 = 1 マスタ**（unique(target_type,
// alias_key)）で、後から別のマスタへ結び直すとその行が移る（最後の訂正が
// 勝つ）。曖昧さが残らないので、突合側は当たった時点で自動確定してよい。
//
// マスタ側の match_names（人が先回りして登録する別名）とは役割が違う:
//   match_names   = 「こう書かれるはず」と**予想して**登録する
//   match_aliases = 「こう書かれていた」を**実績から**貯める
//
// target_type はテーブル名（audit_logs / approval_requests と同じ多態規約）。
// FK は張れないので、マスタを消しても行は残る — 突合時に存在しない
// target_id は黙って無視する（lib/match-aliases）。
//
// **値は business_partners | items の 2 つだけ**（DB 側の CHECK
// match_aliases_target_type_check が正。Prisma では表せないので
// migration に直接書いてある）。品目統合 第 3 段で products / materials の
// 2 つを items へ畳んだ — 製品と素材のマスタが 1 つになったので、学習の
// 行き先も 1 つで足りる。**製品と素材で同じ表記を覚えることはできない**
// （1 表記 = 1 マスタ）が、突合側が引いた品目の item_type を必ず確かめるので、
// 相手の型が当たっても素通りして推測へ落ちるだけ。
model MatchAlias {
  id         Int      @id @default(autoincrement())
  /// "business_partners" | "items"（テーブル名）
  targetType String   @map("target_type")
  /// マスタ行の内部 id を文字列化したもの（BP は uuid、品目は連番）
  targetId   String   @map("target_id")
  /// 書類に印字されていた表記（そのまま）
  alias      String
  /// 突合用の正規化キー（lib/bp-match / lib/product-match の normalize）
  aliasKey   String   @map("alias_key")
  /// この表記で突合できた回数（育ち具合の目安・整理の判断材料）
  hitCount   Int      @default(0) @map("hit_count")
  /// 最後にこの表記を見た日時
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// 結び付けた人
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser User? @relation("MatchAliasCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([targetType, aliasKey])
  @@index([targetType, targetId])
  @@map("match_aliases")
  @@schema("app")
}
