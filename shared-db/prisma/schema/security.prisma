// 認証イベントの記録（app.login_attempts）と Web ブラウザ端末台帳（app.user_devices）。
//
// ■ なぜ独立したテーブルなのか
// audit_logs は「ログイン**済み**の人が何をしたか」の台帳で、actor（user_id）が
// あることが前提。ログイン失敗はまさに actor が確定しない事象なので、そこには
// 入らない（実際、これまで失敗は一切残っていなかった）。kiosk_device_logs は
// 端末プレゼンスの遷移ログで、Web のログインを持てない。
//
// ■ 大原則: 生の秘密は保存しない
// kiosk_cards.id は QR に刷られている secret そのもの。実在しないカードを読んだ
// 失敗行に生値を書くと、「偽造カードの中身」と「正規カードの secret」が同じ列に
// 溜まることになる。実在したカードだけ FK で参照し、それ以外は pepper 付き HMAC
// の相関キー（card_ref）だけを残す。ユーザー名も同じ — 実在ユーザーに解決できた
// ときだけ生値（identifier）を持ち、未知の文字列は ref だけにする（打ち間違いの
// パスワードが混ざりうるため）。
//
// ■ 端末シグネチャ（signals_fingerprint）は認証要素ではない
// クライアント申告の特徴量をサーバーが再計算したハッシュで、相関キーにすぎない。
// kiosk_devices.fingerprint（= アテステーション鍵の指紋。暗号的な証拠）とは
// 別物なので、名前も UI 表記も分けてある（端末シグネチャ / 鍵フィンガープリント）。
//
// ■ 保持期間
// 成功 180 日 / 失敗 400 日。pg_cron（sql/security-cron.sql）が落とす。
// 個人データ（TZ・言語・ハードウェア構成）を含むので、期間を切ることと
// metabase_ro から剥がすこと（sql/grants.sql）はセットで必須。

enum LoginApp {
  WEB // nextjs-web（Auth.js — credentials / Authentik SSO）
  KIOSK // nextjs-kiosk（QRカード + PIN / アテステーション / 端末設定コード）

  @@map("LOGIN_APP")
  @@schema("app")
}

enum LoginOutcome {
  SUCCESS
  FAILURE

  @@map("LOGIN_OUTCOME")
  @@schema("app")
}

// 端末の所有区分（**自動判定のみ**。管理者が上書きする欄は持たない）。
// 判定の強さは ownership_source が語る（lib/device-ownership-core.ts）:
//   COMPANY_MANAGED  端末鍵で署名された管理端末プロファイル = 暗号的証拠
//                    （デバイストークンだけの場合は状況証拠どまり）
//   COMPANY_NETWORK  送信元 IP が社内 CIDR = 「社内 NW にいる」だけ。
//                    持ち込み PC も VPN も同じ判定になる（所有の証拠ではない）
//   UNMANAGED        証拠が無い（= 私用端末の**可能性**。断定ではない）
//   UNKNOWN          判定材料が無い（IP 不明 / CIDR 未設定）
enum DeviceOwnership {
  COMPANY_MANAGED
  COMPANY_NETWORK
  UNMANAGED
  UNKNOWN

  @@map("DEVICE_OWNERSHIP")
  @@schema("app")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  app     LoginApp
  outcome LoginOutcome
  // 認証方式。enum にしないのは将来必ず増えるため（WebAuthn 等）。値の集合は
  // アプリ側 lib/login-attempt-core.ts が正（kiosk_device_logs.source と同じ割り切り）。
  method  String       @db.VarChar(24)
  // 失敗理由。SUCCESS では null。集合は同上。
  reason  String?      @db.VarChar(40)

  // ── 主体 ────────────────────────────────────────────────────────────────
  userId String? @map("user_id") @db.Uuid
  // 入力されたユーザー名。**実在ユーザーに解決できたときだけ**生値を入れる
  // （CHECK 制約でも強制。未知の文字列はパスワード誤入力が混ざりうる）
  identifier    String? @db.VarChar(120)
  // 常に入る相関キー: HMAC-SHA256(pepper, lower(trim(入力値)))。
  // 同じ未知ユーザー名への連続試行を、値を残さずに数えられる。
  identifierRef String? @map("identifier_ref") @db.Char(64)

  // ── 取引先ポータル（社外向け）─────────────────────────────────────────────
  // ポータルの主体は app.users ではないので user_id には入らない。SY0D で
  // 名前を出すためだけの参照。**identifier は常に null のまま**にする
  // （CHECK 制約に従う。顧客のメールアドレスを平文で残さない）。
  // 相関は identifier_ref = HMAC(pepper, email) が担う。
  portalAccountId String? @map("portal_account_id") @db.Uuid

  // ── キオスクのカード ─────────────────────────────────────────────────────
  // 実在したカードのみ FK。存在しない/偽造カードでは null のまま。
  cardId  String? @map("card_id")
  // 常に入る相関キー: HMAC-SHA256(pepper, 正規化スキャン値)。生値は保存しない。
  cardRef String? @map("card_ref") @db.Char(64)
  // 読み取ったペイロードの種別だけ（中身は残さない）:
  // CARD / WO / OTHER / MALFORMED / EMPTY
  scanKind String? @map("scan_kind") @db.VarChar(16)

  // ── 端末 ────────────────────────────────────────────────────────────────
  kioskDeviceId String? @map("kiosk_device_id") @db.Uuid
  userDeviceId  String? @map("user_device_id") @db.Uuid

  // 送信元 IP（プロキシチェーンを解いた最終的なクライアント）。inet なので
  // 管理画面の CIDR 絞り込みを SQL の `<<=` でそのまま書ける。
  ipAddress String? @map("ip_address") @db.Inet
  // x-forwarded-for の生チェーン。信頼ホップ数の設定を後から直したときに、
  // 過去分を再解釈できるように残す。
  ipChain   String? @map("ip_chain") @db.VarChar(200)
  userAgent String? @map("user_agent") @db.VarChar(512)

  // ブラウザ端末シグネチャ（**サーバーが再計算した** SHA-256 hex）。
  signalsFingerprint String? @map("signals_fingerprint") @db.Char(64)
  signalsVersion     Int?    @map("signals_version") @db.SmallInt
  // 収集シグネチャ一式（正規化済み・サイズ上限つき）。「将来のために
  // できるだけ残す」箱。版を上げたとき、ここから再ハッシュできる。
  signals            Json?

  ownership       DeviceOwnership @default(UNKNOWN)
  ownershipSource String?         @map("ownership_source") @db.VarChar(40)

  user        User?        @relation("LoginAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  card        KioskCard?   @relation("LoginAttemptCard", fields: [cardId], references: [id], onDelete: SetNull)
  kioskDevice KioskDevice? @relation("LoginAttemptDevice", fields: [kioskDeviceId], references: [id], onDelete: SetNull)
  userDevice  UserDevice?  @relation("LoginAttemptUserDevice", fields: [userDeviceId], references: [id], onDelete: SetNull)
  portalAccount PortalAccount? @relation("LoginAttemptPortalAccount", fields: [portalAccountId], references: [id], onDelete: SetNull)

  // 「失敗だけを新しい順に」は SY0D の既定表示なので、部分索引を migration 側で
  // 別に張っている（成功行のほうが桁で多く、全体索引だと失敗の走査が重い）。
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([identifierRef, createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@index([signalsFingerprint, createdAt(sort: Desc)])
  @@index([kioskDeviceId, createdAt(sort: Desc)])
  @@index([cardRef, createdAt(sort: Desc)])
  @@index([portalAccountId, createdAt(sort: Desc)])
  @@map("login_attempts")
  @@schema("app")
}

// Web ブラウザ端末の台帳。1 行 = (ユーザー, シグネチャ) の組。
//
// **端末を同定するものではない**。同一キッティングの社給 PC は同じシグネチャに
// なりうるし、ブラウザ/GPU ドライバの更新で別物になる。「この人がいつも使って
// いる端末か / 初めて見る端末か」の目安として使う。
model UserDevice {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  fingerprint String @db.Char(64)
  version     Int    @map("signals_version") @db.SmallInt
  // 表示用の要約（"Chrome / Windows 11"）。UA から純関数で組み立てる。
  label       String? @db.VarChar(80)

  ownership       DeviceOwnership @default(UNKNOWN)
  ownershipSource String?         @map("ownership_source") @db.VarChar(40)

  signals       Json?
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  lastIpAddress String?  @map("last_ip_address") @db.Inet
  loginCount    Int      @default(0) @map("login_count")
  firstSeenAt   DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user          User           @relation("UserDeviceUser", fields: [userId], references: [id], onDelete: Cascade)
  loginAttempts LoginAttempt[] @relation("LoginAttemptUserDevice")

  @@unique([userId, fingerprint])
  @@index([fingerprint])
  @@index([lastSeenAt])
  @@map("user_devices")
  @@schema("app")
}

// ─────────────────────────────────────────────────────────────────────────────
// 特権アクセス — 「持っているから使える」を「頼んで、別の人が許して、期限つきで
// 使える」に分ける。
//
// ■ なぜ RBAC に期限を足さないのか
// role_permission_relation は「この役割は何ができるか」の定義で、恒久的な事実。
// そこに valid_until を足すと、期限切れの grant が権限表に残り続けて
// 「この人は何ができるのか」が読めなくなる。付与は別テーブルに分け、RBAC 側は
// **申請できるか / 承認できるか** だけを語る（decide() は一切変えていない）。
//
// ■ 2 つの方式（形が違うので分けてある）
//   A 時限昇格（privileged_access_requests）
//     対象を事前に名指しできない操作 — PIN を見る / カードを刷る / 履歴を検索する。
//     承認は「一定期間、この操作をしてよい」という許可で、**時計は初回使用から**
//     動きはじめ、min(初回使用 + duration, 窓の終わり) で切れる。
//   B 変更依頼（user_change_requests）
//     それ自体が 1 つの具体的な変更である操作 — この人を停止する。
//     承認がその変更を**適用する**。窓も duration も無い。
//     work_order_flow_changes / order_acceptance_cancel_requests と同じ形。
//
// ■ 有効期限は毎回その場で判定する（cron に消させない）
// user-suspension-cron.sql は期限切れの停止を pg_cron で戻していて、最大 1 分の
// 遅れを許容している — 遅れても「アクセスが減る側」に倒れるから安全。ここで同じ
// ことをすると遅れが「アクセスが増える側」に倒れる。だから判定は常に時刻式
// （lib/privileged-access-core.ts / 実際の SQL の WHERE 句）で行い、pg_cron は
// 表示用の EXPIRED 打刻と保持期間の刈り取りしかしない。
//
// ■ 保持期間・可視性
// 400 日で刈る（sql/security-cron.sql）。「誰がどの秘密を見たがったか」「誰が誰を
// 止めようとしたか」の記録なので、login_attempts と同じく metabase_ro からは
// 剥がす（sql/grants.sql）。
// ─────────────────────────────────────────────────────────────────────────────

enum PrivilegedRequestStatus {
  PENDING // 承認待ち
  APPROVED // 承認済み（A では「使える」。ただし窓と duration の範囲内）
  REJECTED // 差し戻し
  CANCELLED // 申請者が取り下げ
  REVOKED // 承認者が有効な付与を打ち切った（A のみ）
  EXPIRED // 期限切れ（**表示用の打刻**。判定はこの値を見ない）

  @@map("PRIVILEGED_REQUEST_STATUS")
  @@schema("app")
}

// A: 時限昇格の申請 1 件。1 申請 = 1 権限コード（承認できる人が一意に決まるため）。
// 中身の操作は privileged_access_request_operations（承認時に一部だけ落とせる）。
model PrivilegedAccessRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // kiosk_secret | kiosk_device | kiosk_card | personal_data
  // （permissions への FK は張らない — 権限コードは seed 由来で、申請の履歴は
  //   コードを廃止しても読めなければならない。audit_logs.table_name と同じ割り切り）
  code   String                  @db.VarChar(64)
  status PrivilegedRequestStatus @default(PENDING)
  // 申請理由。空文字は DB の CHECK で拒否する（「なぜ」の無い特権付与を作らない）。
  reason String

  // 承認された「窓」。申請時点から最長 14 日（DB CHECK）。
  windowStartsAt  DateTime @map("window_starts_at") @db.Timestamptz(6)
  windowEndsAt    DateTime @map("window_ends_at") @db.Timestamptz(6)
  // 初回使用から測る有効時間（分）。
  durationMinutes Int      @map("duration_minutes")
  // **初回使用時刻**。null = まだ一度も使っていない = 時計が動いていない。
  // 画面を開いただけでは埋まらない（peekElevation は書かない）。
  activatedAt     DateTime? @map("activated_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  useCount        Int       @default(0) @map("use_count")

  requestedBy     String    @map("requested_by") @db.Uuid
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy       String?   @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionComment String?   @map("decision_comment")
  revokedBy       String?   @map("revoked_by") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason    String?   @map("revoke_reason")

  requestedByUser User? @relation("PrivilegedRequestedBy", fields: [requestedBy], references: [id], onDelete: NoAction)
  decidedByUser   User? @relation("PrivilegedDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)
  revokedByUser   User? @relation("PrivilegedRevokedBy", fields: [revokedBy], references: [id], onDelete: SetNull)

  operations PrivilegedAccessRequestOperation[]

  @@index([requestedBy, status])
  @@index([code, status])
  @@index([requestedAt(sort: Desc)])
  @@map("privileged_access_requests")
  @@schema("app")
}

// 申請に含まれる操作。key は lib/privileged-operations.ts の PRIVILEGED_OPERATIONS。
// granted は承認時に確定する — 承認者は要求された操作の一部だけを許可できる
// （「PIN のリセットは良いがカードの失効は駄目」を却下せずに表現するため）。
model PrivilegedAccessRequestOperation {
  requestId String  @map("request_id") @db.Uuid
  operation String  @db.VarChar(64)
  granted   Boolean @default(false)

  request PrivilegedAccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, operation])
  @@index([operation])
  @@map("privileged_access_request_operations")
  @@schema("app")
}

enum UserChangeKind {
  SUSPEND // 利用停止（恒久 or 期限つき）
  RESTORE // 利用停止の解除
  UPDATE_PLANTS // 所属拠点の変更（= PLANT/REGION スコープの変更）
  UPDATE_ROLES // ロール割当の変更（= 権限そのものの変更）

  @@map("USER_CHANGE_KIND")
  @@schema("app")
}

// B: ユーザーへの変更依頼 1 件。承認がその変更を**適用する**。
//
// payload は kind ごとに形が違うので Json（zod で検証。lib/user-change-core.ts）:
//   SUSPEND        { disabledUntil: string | null, disabledReason: string }
//   RESTORE        {}
//   UPDATE_PLANTS  { plantIds: number[] }
//   UPDATE_ROLES   { roleIds: number[] }
//
// 適用は列を直接書き換えるのではなく、通常の変更関数を通す。承認までに前提が
// 崩れていれば（既に停止済み・拠点が消えた・対象が無効化された）適用せず
// apply_error に理由を残す — 古い前提のまま当てないため
// （work_order_flow_changes と同じ約束）。
model UserChangeRequest {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind         UserChangeKind
  targetUserId String         @map("target_user_id") @db.Uuid
  payload      Json
  reason       String
  // REVOKED / EXPIRED は使わない（適用済みの変更は「打ち切る」ものではない）。
  status       PrivilegedRequestStatus @default(PENDING)

  requestedBy     String    @map("requested_by") @db.Uuid
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy       String?   @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionComment String?   @map("decision_comment")
  // 適用の結果。承認済みで applied_at が null かつ apply_error があれば「承認は
  // されたが当てられなかった」— 画面はこれを失敗として出す。
  appliedAt       DateTime? @map("applied_at") @db.Timestamptz(6)
  applyError      String?   @map("apply_error")

  targetUser      User  @relation("UserChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  requestedByUser User? @relation("UserChangeRequestedBy", fields: [requestedBy], references: [id], onDelete: NoAction)
  decidedByUser   User? @relation("UserChangeDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetUserId])
  @@index([requestedAt(sort: Desc)])
  @@map("user_change_requests")
  @@schema("app")
}
