// 出荷・納品 (_specs/tables.md §8): 出荷書（delivery order / DO）/ 納品書。
//
// 番号付き印刷文書 = Quote と同じ (year_month, seq) 複合キー。表示番号
// DOR-YYYYMM-NNNNN / DRN-YYYYMM-NNNNN は導出（URL id にも使用）。
//
// 注文明細リンクは**明細行**にある（order_line_id）— 出荷書 ↔ 注文明細は m:n。
// 1 出荷書に複数の注文明細を全量・部分数量で載せられ、1 注文明細は複数の
// 出荷書に分けて出荷できる。ヘッダは顧客だけを持つ（請求の顧客判定と納品書
// の宛先導出がここを見る）。不変条件: 1 出荷書の明細はすべて同一顧客の注文明細
// でなければならない（アプリで検証）。明細は製品×ロットで、複数指示書（ロット）
// の成果を束ねられる。納品書は出荷書 1:1。
// order_line_id は nullable — STOCK_STORAGE（予備製作分・請求フロー外）と
// 独立在庫指示書由来の出荷には注文明細が無い。DISPATCH では必須（アプリで強制）。
//
// 営業担当は**持たない** — 明細の注文明細 → 注文請書ヘッダの sales_rep_id を
// 読む（注文明細 order_lines と同じ規約。lib/sales-rep.ts 参照）。

enum DeliveryOrderType {
  STOCK_STORAGE // 在庫保管（予備製作分・請求フロー外）
  DISPATCH // 発送（§9 会計トリガ）

  @@map("DELIVERY_ORDER_TYPE")
  @@schema("app")
}

enum DeliveryOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED

  @@map("DELIVERY_ORDER_STATUS")
  @@schema("app")
}

enum DeliveryMethod {
  DIRECT_TO_USER // ユーザー直送（完了書に価格なし、納品書別送）
  NORMAL // 通常納品（受注先へ納品書同梱）

  @@map("DELIVERY_METHOD")
  @@schema("app")
}

enum DeliveryStatus {
  DRAFT
  ISSUED
  DELIVERED

  @@map("DELIVERY_STATUS")
  @@schema("app")
}

model DeliveryOrder {
  yearMonth String @map("year_month") @db.Char(6)
  seq       Int

  // 顧客はヘッダ（明細をまたいで同一）。注文明細リンクは明細行側。
  customerBpId       String  @map("customer_bp_id") @db.Uuid
  customerBranchBpId String? @map("customer_branch_bp_id") @db.Uuid
  // 明細が単一ロットに解決するときだけ張る表示・追跡用リンク
  workOrderId String? @map("work_order_id") @db.Uuid
  fromPlantId Int?    @map("from_plant_id")

  type      DeliveryOrderType
  status    DeliveryOrderStatus @default(DRAFT)
  shippedAt DateTime?           @map("shipped_at") @db.Timestamptz(6)
  notes     String?
  createdBy String?             @map("created_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerBp       BusinessPartner  @relation("DeliveryOrderCustomer", fields: [customerBpId], references: [id])
  customerBranchBp BusinessPartner? @relation("DeliveryOrderCustomerBranch", fields: [customerBranchBpId], references: [id])
  workOrder        WorkOrder?       @relation(fields: [workOrderId], references: [id])
  fromPlant        Plant?           @relation(fields: [fromPlantId], references: [id])
  createdByUser    User?            @relation("DeliveryOrderCreatedBy", fields: [createdBy], references: [id])

  items         DeliveryOrderItem[]
  deliveryNotes DeliveryNote[]

  @@id([yearMonth, seq])
  @@index([customerBpId])
  @@index([status])
  @@map("delivery_orders")
  @@schema("app")
}

model DeliveryOrderItem {
  id                     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryOrderYearMonth String @map("delivery_order_year_month") @db.Char(6)
  deliveryOrderSeq       Int    @map("delivery_order_seq")

  // 出荷元の注文明細。DISPATCH では必須（アプリで強制）、STOCK_STORAGE と
  // 独立在庫指示書由来では null。出荷書 ↔ 注文明細 m:n の行レベルリンク。
  orderLineId String? @map("order_line_id") @db.Uuid

  productId Int     @map("product_id")
  lotNumber Int?    @map("lot_number") // ロット = 指示書番号（複数 WO を束ねる単位）
  quantity  Int
  notes     String?
  sortOrder Int     @default(0) @map("sort_order")

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderYearMonth, deliveryOrderSeq], references: [yearMonth, seq], onDelete: Cascade)
  orderLine     OrderLine?    @relation(fields: [orderLineId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([deliveryOrderYearMonth, deliveryOrderSeq])
  @@index([orderLineId])
  @@map("delivery_order_items")
  @@schema("app")
}

// 納品書 DRN-YYYYMM-NNNNN
model DeliveryNote {
  yearMonth String @map("year_month") @db.Char(6)
  seq       Int

  deliveryOrderYearMonth String @map("delivery_order_year_month") @db.Char(6)
  deliveryOrderSeq       Int    @map("delivery_order_seq")

  deliveryMethod       DeliveryMethod @map("delivery_method")
  recipientBpId        String         @map("recipient_bp_id") @db.Uuid
  recipientBranchBpId  String?        @map("recipient_branch_bp_id") @db.Uuid
  endUserBpId          String?        @map("end_user_bp_id") @db.Uuid // ユーザー直送時
  includePrice         Boolean        @default(true) @map("include_price")
  pdfFileId            String?        @map("pdf_file_id") @db.Uuid
  status               DeliveryStatus @default(DRAFT)
  deliveredAt          DateTime?      @map("delivered_at") @db.Timestamptz(6)
  notes                String?
  // 営業担当（作成時に出荷書の派生担当 or 納品先の主担当を複写したスナップショット）。
  salesRepId           String?        @map("sales_rep_id") @db.Uuid
  createdBy            String?        @map("created_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  salesRep          User?            @relation("DeliveryNoteSalesRep", fields: [salesRepId], references: [id])
  deliveryOrder     DeliveryOrder    @relation(fields: [deliveryOrderYearMonth, deliveryOrderSeq], references: [yearMonth, seq])
  recipientBp       BusinessPartner  @relation("DeliveryNoteRecipient", fields: [recipientBpId], references: [id])
  recipientBranchBp BusinessPartner? @relation("DeliveryNoteRecipientBranch", fields: [recipientBranchBpId], references: [id])
  endUserBp         BusinessPartner? @relation("DeliveryNoteEndUser", fields: [endUserBpId], references: [id])
  pdfFile           File?            @relation("DeliveryNotePdf", fields: [pdfFileId], references: [id])
  createdByUser     User?            @relation("DeliveryNoteCreatedBy", fields: [createdBy], references: [id])

  items DeliveryNoteItem[]

  @@id([yearMonth, seq])
  @@index([deliveryOrderYearMonth, deliveryOrderSeq])
  @@map("delivery_notes")
  @@schema("app")
}

model DeliveryNoteItem {
  id                    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryNoteYearMonth String @map("delivery_note_year_month") @db.Char(6)
  deliveryNoteSeq       Int    @map("delivery_note_seq")

  productId Int      @map("product_id")
  quantity  Int
  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 2)
  amount    Decimal? @db.Decimal(12, 2)
  notes     String?
  sortOrder Int      @default(0) @map("sort_order")

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteYearMonth, deliveryNoteSeq], references: [yearMonth, seq], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([deliveryNoteYearMonth, deliveryNoteSeq])
  @@map("delivery_note_items")
  @@schema("app")
}
