// 出荷・納品 (_specs/tables.md §8): 出荷書（delivery order / DO）/ 納品書。
//
// 番号付き印刷文書。行は uuid、表示番号 DOR-FFFF-NNNNN / DRN-FFFF-NNNNN は
// DB が作成時に払い出す（doc_number）。
//
// 注文明細リンクは**明細行**にある（order_line_id）— 出荷書 ↔ 注文明細は m:n。
// 1 出荷書に複数の注文明細を全量・部分数量で載せられ、1 注文明細は複数の
// 出荷書に分けて出荷できる。ヘッダは顧客だけを持つ（請求の顧客判定と納品書
// の宛先導出がここを見る）。不変条件: 1 出荷書の明細はすべて同一顧客の注文明細
// でなければならない（アプリで検証）。明細は製品×ロットで、複数指示書（ロット）
// の成果を束ねられる。納品書は出荷書 1:1。
// order_line_id は nullable — STOCK_STORAGE（予備製作分・請求フロー外）と
// 独立在庫指示書由来の出荷には注文明細が無い。DISPATCH では必須（アプリで強制）。
//
// 営業担当は**持たない** — 明細の注文明細 → 注文請書ヘッダの sales_rep_id を
// 読む（注文明細 order_lines と同じ規約。lib/sales-rep.ts 参照）。

enum DeliveryOrderType {
  STOCK_STORAGE // 在庫保管（予備製作分・請求フロー外）
  DISPATCH // 発送（§9 会計トリガ）

  @@map("DELIVERY_ORDER_TYPE")
  @@schema("app")
}

enum DeliveryOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED

  @@map("DELIVERY_ORDER_STATUS")
  @@schema("app")
}

/// 請求単価をどこから取るか（出荷書ヘッダ — 出荷時点の判断）。
///
/// 過不足で納品すると「受注時に決めた単価のままでよいのか」が毎回問題になる。
/// 100 本の段階単価で受注して 80 本しか納めないなら 80 本の段階単価が正しい、
/// という顧客もいれば、受注時の約束を動かさない顧客もいる。どちらが正しいかは
/// 出荷のたびに人が決めることなので、**出荷書 1 通ごと**に持つ。
enum DeliveryBillingPriceMode {
  /// 受注時の単価をそのまま使う（既定・従来の挙動）。
  ORIGINAL
  /// 実納品数で価格表を引き直す（引けなければ受注時の単価に落ちる）。
  PRICE_LIST

  @@map("DELIVERY_BILLING_PRICE_MODE")
  @@schema("app")
}

/// 出荷書の承認状態（過不足納品のときだけ動く）。段数非依存 —
/// 何段目かは approval_requests.step_no が持つ（work_orders と同型）。
enum DeliveryOrderApprovalStatus {
  /// 承認は要らない（数量ちょうど、または顧客設定が承認不要）。
  NONE
  PENDING
  APPROVED
  REJECTED

  @@map("DELIVERY_ORDER_APPROVAL_STATUS")
  @@schema("app")
}

enum DeliveryMethod {
  DIRECT_TO_USER // ユーザー直送（完了書に価格なし、納品書別送）
  NORMAL // 通常納品（受注先へ納品書同梱）

  @@map("DELIVERY_METHOD")
  @@schema("app")
}

enum DeliveryStatus {
  DRAFT
  ISSUED
  DELIVERED

  @@map("DELIVERY_STATUS")
  @@schema("app")
}

model DeliveryOrder {
  /// 内部キー（uuid）。書類番号は法人ごとの連番になるので（番号設計 PR-C）、
  /// 番号は行の識別にならない。子の表はこの id を FK で指す（PR-B）。
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 発行元の自社法人（番号設計 PR-B）。作成時に lib/doc-company.ts が決め、
  /// 以後は変えない（DB トリガー own_company_id_immutable）。既定値は既定の法人。
  ownCompanyId Int @default(dbgenerated("app.default_own_company_id()")) @map("own_company_id")
  /// 旧番号の年月と連番。**@ignore — アプリからは見えない**（番号設計 PR-D1）。
  /// 列は、これを SELECT する旧コンテナが居なくなってから後続の migration で落とす。
  legacyYearMonth String? @map("year_month") @db.Char(6) @ignore
  legacySeq       Int?    @map("seq") @ignore
  /// 書類番号（番号設計 PR-C）。**DB が採番する** — BEFORE INSERT トリガー
  /// app.assign_document_number が自社法人 × 会計年度の連番から払い出して
  /// 4 列を必ず上書きする（既定値は Prisma の create 入力を省けるようにする
  /// ためだけのもの）。保存後は変えられない（app.document_number_frozen）。
  fiscalYear   Int     @default(0) @map("fiscal_year")
  docSeq       Int     @default(0) @map("doc_seq")
  docNumber    String  @default("") @map("doc_number")
  /// `<法人コード>/<書類番号>` — 多態参照がこの書類を指す形そのまま。
  docRef       String  @unique @default("") @map("doc_ref")
  /// 振り直し前の番号（旧 PREFIX-YYYYMM-NNNNN）。検索と旧 URL の転送に使う。
  legacyNumber String? @map("legacy_number")

  // 顧客はヘッダ（明細をまたいで同一）。注文明細リンクは明細行側。
  customerBpId       String  @map("customer_bp_id") @db.Uuid
  customerBranchBpId String? @map("customer_branch_bp_id") @db.Uuid
  // 明細が単一ロットに解決するときだけ張る表示・追跡用リンク
  workOrderId String? @map("work_order_id") @db.Uuid
  fromPlantId Int?    @map("from_plant_id")

  type      DeliveryOrderType
  status    DeliveryOrderStatus @default(DRAFT)
  shippedAt DateTime?           @map("shipped_at") @db.Timestamptz(6)
  notes     String?

  // ── 過不足納品（§8）──────────────────────────────────────────────────────
  /// 請求単価の出どころ（出荷時点の判断）。確定時にこの設定で
  /// delivery_order_items.unit_price を焼き込む。
  billingPriceMode DeliveryBillingPriceMode @default(ORIGINAL) @map("billing_price_mode")
  /// この出荷で対象の注文明細を**締める**（不足分はもう出荷しない）。
  ///
  /// 不足納品は「一部出荷」と数量の上では見分けが付かない — 100 本のうち 80 本を
  /// 積んだ出荷書が、残り 20 本を後で出すのか、80 本で終わりなのかは人しか知らない。
  /// この 1 列がその宣言で、true のときだけ注文明細が SHIPPED まで進む。
  closesOrderLines Boolean @default(false) @map("closes_order_lines")

  // 承認（過不足が顧客設定で承認必須のときだけ動く。素通しなら NONE のまま）
  approvalStatus DeliveryOrderApprovalStatus @default(NONE) @map("approval_status")
  requestedAt    DateTime? @map("requested_at") @db.Timestamptz(6)
  requestedBy    String?   @map("requested_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy     String?   @map("approved_by") @db.Uuid
  rejectedAt     DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy     String?   @map("rejected_by") @db.Uuid
  rejectReason   String?   @map("reject_reason")

  createdBy String?             @map("created_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerBp       BusinessPartner  @relation("DeliveryOrderCustomer", fields: [customerBpId], references: [id])
  customerBranchBp BusinessPartner? @relation("DeliveryOrderCustomerBranch", fields: [customerBranchBpId], references: [id])
  workOrder        WorkOrder?       @relation(fields: [workOrderId], references: [id])
  fromPlant        Plant?           @relation(fields: [fromPlantId], references: [id])
  createdByUser    User?            @relation("DeliveryOrderCreatedBy", fields: [createdBy], references: [id])
  requestedByUser  User?            @relation("DeliveryOrderRequestedBy", fields: [requestedBy], references: [id])
  approvedByUser   User?            @relation("DeliveryOrderApprovedBy", fields: [approvedBy], references: [id])
  rejectedByUser   User?            @relation("DeliveryOrderRejectedBy", fields: [rejectedBy], references: [id])

  items         DeliveryOrderItem[]
  deliveryNotes DeliveryNote[]
  charges       DeliveryOrderCharge[]

  invoiceItems InvoiceItem[] @relation("InvoiceItemDeliveryOrder")

  ownCompany OwnCompany @relation("DeliveryOrderOwnCompany", fields: [ownCompanyId], references: [id], onDelete: Restrict)

  @@unique([legacyYearMonth, legacySeq])
  @@unique([ownCompanyId, fiscalYear, docSeq])
  @@unique([ownCompanyId, docNumber])
  @@index([legacyNumber])
  @@index([customerBpId])
  @@index([status])
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, id])
  @@index([approvalStatus])
  @@index([ownCompanyId])
  @@map("delivery_orders")
  @@schema("app")
}

model DeliveryOrderItem {
  id                     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryOrderId String @map("delivery_order_id") @db.Uuid
  deliveryOrderYearMonth String? @map("delivery_order_year_month") @db.Char(6) @ignore
  deliveryOrderSeq       Int?    @map("delivery_order_seq") @ignore

  // 出荷元の注文明細。DISPATCH では必須（アプリで強制）、STOCK_STORAGE と
  // 独立在庫指示書由来では null。出荷書 ↔ 注文明細 m:n の行レベルリンク。
  orderLineId String? @map("order_line_id") @db.Uuid

  /// 統合品目（app.items）。出荷明細の品目。
  itemId    Int     @map("item_id")
  lotNumber Int?    @map("lot_number") // ロット = 指示書番号（複数 WO を束ねる単位）
  quantity  Int
  /// 請求単価のスナップショット（出荷書の確定時に billing_price_mode で焼き込む）。
  /// null = 未確定 or 確定前のデータ → 読み側は注文明細の単価へ落ちる。
  /// 納品書・請求書の単価はここが先で、注文明細の単価は後方互換のためのフォールバック。
  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 2)
  /// 出荷後に返ってきた数（累計）。
  ///
  /// **台帳から数え直さずに行に持つ。** 返品の計上は入出庫伝票（事由
  /// SALES_RETURN）に残るが、行がどの伝票行に対応するかは (品目, ロット) で
  /// しか辿れず、同じ品目・同じロットの行が 2 本ある出荷書で取り違える。
  /// 「この行は何本戻ったか」は行に書くのが正しい形。
  returnedQuantity Int @default(0) @map("returned_quantity")
  notes     String?
  sortOrder Int     @default(0) @map("sort_order")

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  orderLine     OrderLine?    @relation(fields: [orderLineId], references: [id])
  item          Item          @relation("DeliveryOrderItemItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([deliveryOrderYearMonth, deliveryOrderSeq])
  @@index([orderLineId])
  @@index([itemId])
  @@index([deliveryOrderId])
  @@map("delivery_order_items")
  @@schema("app")
}

// 納品書 DRN-FFFF-NNNNN
model DeliveryNote {
  /// 内部キー（uuid）。書類番号は法人ごとの連番になるので（番号設計 PR-C）、
  /// 番号は行の識別にならない。子の表はこの id を FK で指す（PR-B）。
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 発行元の自社法人（番号設計 PR-B）。作成時に lib/doc-company.ts が決め、
  /// 以後は変えない（DB トリガー own_company_id_immutable）。既定値は既定の法人。
  ownCompanyId Int @default(dbgenerated("app.default_own_company_id()")) @map("own_company_id")
  /// 旧番号の年月と連番。**@ignore — アプリからは見えない**（番号設計 PR-D1）。
  /// 列は、これを SELECT する旧コンテナが居なくなってから後続の migration で落とす。
  legacyYearMonth String? @map("year_month") @db.Char(6) @ignore
  legacySeq       Int?    @map("seq") @ignore
  /// 書類番号（番号設計 PR-C）。**DB が採番する** — BEFORE INSERT トリガー
  /// app.assign_document_number が自社法人 × 会計年度の連番から払い出して
  /// 4 列を必ず上書きする（既定値は Prisma の create 入力を省けるようにする
  /// ためだけのもの）。保存後は変えられない（app.document_number_frozen）。
  fiscalYear   Int     @default(0) @map("fiscal_year")
  docSeq       Int     @default(0) @map("doc_seq")
  docNumber    String  @default("") @map("doc_number")
  /// `<法人コード>/<書類番号>` — 多態参照がこの書類を指す形そのまま。
  docRef       String  @unique @default("") @map("doc_ref")
  /// 振り直し前の番号（旧 PREFIX-YYYYMM-NNNNN）。検索と旧 URL の転送に使う。
  legacyNumber String? @map("legacy_number")

  deliveryOrderId String @map("delivery_order_id") @db.Uuid
  deliveryOrderYearMonth String? @map("delivery_order_year_month") @db.Char(6) @ignore
  deliveryOrderSeq       Int?    @map("delivery_order_seq") @ignore

  deliveryMethod       DeliveryMethod @map("delivery_method")
  recipientBpId        String         @map("recipient_bp_id") @db.Uuid
  recipientBranchBpId  String?        @map("recipient_branch_bp_id") @db.Uuid
  endUserBpId          String?        @map("end_user_bp_id") @db.Uuid // ユーザー直送時
  includePrice         Boolean        @default(true) @map("include_price")
  pdfFileId            String?        @map("pdf_file_id") @db.Uuid
  status               DeliveryStatus @default(DRAFT)
  deliveredAt          DateTime?      @map("delivered_at") @db.Timestamptz(6)
  notes                String?
  // 営業担当（作成時に出荷書の派生担当 or 納品先の主担当を複写したスナップショット）。
  salesRepId           String?        @map("sales_rep_id") @db.Uuid
  createdBy            String?        @map("created_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  salesRep          User?            @relation("DeliveryNoteSalesRep", fields: [salesRepId], references: [id])
  deliveryOrder     DeliveryOrder    @relation(fields: [deliveryOrderId], references: [id])
  recipientBp       BusinessPartner  @relation("DeliveryNoteRecipient", fields: [recipientBpId], references: [id])
  recipientBranchBp BusinessPartner? @relation("DeliveryNoteRecipientBranch", fields: [recipientBranchBpId], references: [id])
  endUserBp         BusinessPartner? @relation("DeliveryNoteEndUser", fields: [endUserBpId], references: [id])
  pdfFile           File?            @relation("DeliveryNotePdf", fields: [pdfFileId], references: [id])
  createdByUser     User?            @relation("DeliveryNoteCreatedBy", fields: [createdBy], references: [id])

  items DeliveryNoteItem[]

  invoiceItems InvoiceItem[] @relation("InvoiceItemDeliveryNote")

  ownCompany OwnCompany @relation("DeliveryNoteOwnCompany", fields: [ownCompanyId], references: [id], onDelete: Restrict)

  @@unique([legacyYearMonth, legacySeq])
  @@unique([ownCompanyId, fiscalYear, docSeq])
  @@unique([ownCompanyId, docNumber])
  @@index([legacyNumber])
  @@index([deliveryOrderYearMonth, deliveryOrderSeq])
  // /api/v1 の差分同期（keyset）用。先頭列が順序キーであること。
  @@index([updatedAt, id])
  @@index([deliveryOrderId])
  @@index([ownCompanyId])
  @@map("delivery_notes")
  @@schema("app")
}

model DeliveryNoteItem {
  id                    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryNoteId String @map("delivery_note_id") @db.Uuid
  deliveryNoteYearMonth String? @map("delivery_note_year_month") @db.Char(6) @ignore
  deliveryNoteSeq       Int?    @map("delivery_note_seq") @ignore

  /// 統合品目（app.items）。納品明細の品目。
  itemId    Int      @map("item_id")
  quantity  Int
  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 2)
  amount    Decimal? @db.Decimal(12, 2)
  notes     String?
  sortOrder Int      @default(0) @map("sort_order")

  /// 行の税スナップショット（課税区分と、その行に当たった率）。**出荷書の確定時**に
  /// 請求単価 (delivery_order_items.unit_price) と一緒に焼き込む — 確定より後に
  /// 税区分マスタを直しても、発行済みの納品書は動かない。
  /// **税額は行に持たない**（税は率ごとの束でしか正しく丸められない — lib/money.ts）。
  /// 価格記載なし (include_price = false) の納品書と、税区分マスタ以前の行は null。
  taxCategoryId Int?     @map("tax_category_id")
  taxRate       Decimal? @map("tax_rate") @db.Decimal(5, 4)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  item         Item         @relation("DeliveryNoteItemItem", fields: [itemId], references: [id], onDelete: Restrict)
  taxCategory  TaxCategory? @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)

  @@index([deliveryNoteYearMonth, deliveryNoteSeq])
  @@index([taxCategoryId])
  @@index([itemId])
  @@index([deliveryNoteId])
  @@map("delivery_note_items")
  @@schema("app")
}

// 出荷書の追加料金（送料など。§8 / §9）。**請求される実体はこちら**。
//
// 指示書側（work_order_charges）は予定で、出荷書を作るときに複写される。
// 複写後は出荷書側だけを直す — 実費・箱数・同梱で要らなくなった、といった
// ことは出荷のときにしか決まらない。
//
// 締日処理（processClosing）はこの行を請求明細へ写す。税区分は料金マスタが
// 持つものを行に凍結する（製品明細と同じ規約 — 顧客側の指定があればそちらが
// 勝ち、基準日は注文日ではなく **出荷日**。送料は引き渡しの約束ではなく
// 運んだ日の役務なので）。
model DeliveryOrderCharge {
  id                     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryOrderId String @map("delivery_order_id") @db.Uuid
  deliveryOrderYearMonth String? @map("delivery_order_year_month") @db.Char(6) @ignore
  deliveryOrderSeq       Int?    @map("delivery_order_seq") @ignore
  chargeItemId           Int    @map("charge_item_id")

  /// 複写元の指示書（表示・追跡用。手で足した行は null）。
  sourceWorkOrderId String? @map("source_work_order_id") @db.Uuid

  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  notes       String?
  sortOrder   Int     @default(0) @map("sort_order")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  chargeItem      ChargeItem    @relation(fields: [chargeItemId], references: [id], onDelete: Restrict)
  sourceWorkOrder WorkOrder?    @relation("DeliveryOrderChargeSourceWo", fields: [sourceWorkOrderId], references: [id], onDelete: SetNull)
  createdByUser   User?         @relation("DeliveryOrderChargeCreatedBy", fields: [createdBy], references: [id])

  @@index([deliveryOrderYearMonth, deliveryOrderSeq, sortOrder])
  @@index([chargeItemId])
  @@index([deliveryOrderId])
  @@map("delivery_order_charges")
  @@schema("app")
}
